---
import Layout from '../layouts/Layout.astro';
import ProductHero from '../components/sections/ProductHero.astro';
import SectionHeading from '../components/sections/SectionHeading.astro';
import PainBento from '../components/sections/PainBento.astro';
import ProcessTimelineAnimated from '../components/sections/ProcessTimelineAnimated.astro';
import BenefitsList from '../components/sections/BenefitsList.astro';
import AuthorityCTA from '../components/sections/AuthorityCTA.astro';
import ProductHorizontalScroll from '../components/sections/ProductHorizontalScroll.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const s = t.bipyxis;
const contactHref = getRelativeLocaleUrl(lang, 'contacto');
---

<Layout title={`${s.metaTitle} — DOT Solutions`} description={s.metaDescription} lang={lang} path="/bipyxis">
  <ProductHorizontalScroll>
    <!-- Panel 01 — Hero -->
    <section class="h-panel h-panel--hero">
      <ProductHero
        line1={s.hero.line1}
        line2={s.hero.line2}
        subtitle={s.hero.subtitle}
        paragraph={s.hero.paragraph}
        cta={s.hero.cta}
        ctaHref={contactHref}
        logo="/logos/isotipos/bipyxisiso.svg"
      />
    </section>

    <!-- Panel 02 — Diagnóstico -->
    <section class="h-panel">
      <div class="h-inner" data-h-reveal>
        <div class="panel-heading">
          <SectionHeading eyebrow={s.bento.eyebrow} title={s.bento.title} align="left" />
        </div>
        <div class="h-body">
          <PainBento items={s.bento.items} compact />
        </div>
      </div>
    </section>

    <!-- Panel 03 — Cómo funciona -->
    <section class="h-panel">
      <div class="h-inner" data-h-reveal>
        <div class="glass-panel process-panel">
          <SectionHeading eyebrow={s.process.eyebrow} title={s.process.title} subtitle={s.process.intro} align="center" />
          <div class="h-body narrow">
            <ProcessTimelineAnimated steps={s.process.steps} compact />
          </div>
        </div>
      </div>
    </section>

    <!-- Panel 04 — Beneficios -->
    <section class="h-panel">
      <div class="h-inner" data-h-reveal>
        <div class="panel-heading">
          <SectionHeading title={s.benefits.title} align="left" />
        </div>
        <div class="h-body">
          <BenefitsList items={s.benefits.items} compact />
        </div>
      </div>
    </section>
  </ProductHorizontalScroll>

  <AuthorityCTA title={s.authority.title} stats={s.authority.stats} cta={s.authority.cta} ctaHref={contactHref} />
</Layout>

<style>
  .h-inner {
    max-width: 72rem;
    margin-inline: auto;
  }
  .h-panel--hero :global(.subtitle) {
    color: var(--dot-light) !important;
    margin-top: var(--space-md) !important;
  }
  .h-panel--hero :global(.paragraph) {
    margin-top: var(--space-sm) !important;
  }
  .h-panel--hero :global(.product-hero-actions) {
    margin-top: var(--space-lg) !important;
  }
  .h-body {
    margin-top: var(--space-lg);
  }
  .h-body.narrow {
    max-width: var(--content-max);
    margin-inline: auto;
  }

  .process-panel {
    padding: clamp(1.95rem, 3.9vw, 2.925rem);
    border: none;
  }

  /* Título de cada panel — degradé animado, mismo truco que SAP pero con el
     acento por defecto del sitio (micelio) en vez del celeste específico de SAP. */
  .panel-heading :global(.title),
  .process-panel :global(.heading .title) {
    background: linear-gradient(
      90deg,
      var(--dot-light) 0%,
      var(--dot-light) 35%,
      var(--dot-micelio) 50%,
      var(--dot-light) 65%,
      var(--dot-light) 100%
    );
    background-size: 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: h-gradient-loop 6s linear infinite;
  }
  @keyframes h-gradient-loop {
    to {
      background-position: -250% 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel-heading :global(.title),
    .process-panel :global(.heading .title) {
      animation: none;
      background-position: 50% 0;
    }
  }

  @media (min-width: 1025px) {
    .h-panel--hero {
      padding-inline: 0;
    }
    .panel-heading :global(.title),
    .process-panel :global(.heading .title) {
      font-size: clamp(2.325rem, 4.06vw, 3.38rem) !important;
    }
    .process-panel :global(.heading .subtitle) {
      font-size: 1.17rem !important;
      margin-top: 0.455rem !important;
    }
    .h-body.narrow {
      margin-top: 1.95rem !important;
    }

    .h-panel--hero :global(.product-hero-copy h1) {
      font-size: clamp(2.2rem, 3.8vw, 3.1rem) !important;
      max-width: 46ch !important;
    }
    .h-panel--hero :global(.subtitle) {
      font-size: 1.3rem !important;
    }
    .h-panel--hero :global(.paragraph) {
      font-size: 1.1rem !important;
    }
    .h-panel--hero :global(.product-hero-actions .cta) {
      padding: 0.8rem 1.75rem !important;
      font-size: 0.875rem !important;
    }
  }

  @media (max-width: 1024px) {
    .h-panel--hero {
      padding-inline: 0;
    }
  }
</style>
