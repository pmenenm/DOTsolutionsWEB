---
import Layout from '../layouts/Layout.astro';
import HeroReveal from '../components/sections/HeroReveal.astro';
import Hero from '../components/sections/Hero.astro';
import ClientLogos from '../components/sections/ClientLogos.astro';
import SectionHeading from '../components/sections/SectionHeading.astro';
import IndustriesTeaser from '../components/sections/IndustriesTeaser.astro';
import ServicesShowcase from '../components/sections/ServicesShowcase.astro';
import StatBar from '../components/sections/StatBar.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import ContactFooter from '../components/sections/ContactFooter.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout title={t.meta.title} description={t.meta.description} lang={lang} path="/" hideFooter={true}>
  <HeroReveal>
    <Hero
      eyebrow={t.home.hero.eyebrow}
      title1={t.home.hero.title1}
      title2={t.home.hero.title2}
      title3={t.home.hero.title3}
      subtitle={t.home.hero.subtitle}
      cta={t.home.hero.cta}
      ctaHref={getRelativeLocaleUrl(lang, 'contacto')}
      ctaSecondary={t.home.hero.ctaSecondary}
      ctaSecondaryHref={getRelativeLocaleUrl(lang, 'servicios')}
      capabilities={t.home.hero.capabilities}
    />

    <ClientLogos title={t.common.clientsTitle} />

    <ServicesShowcase
      eyebrow={t.home.servicesTeaser.eyebrow}
      titleHighlight={t.home.servicesTeaser.titleHighlight}
      titleRest={t.home.servicesTeaser.titleRest}
      subtitle={t.home.servicesTeaser.subtitle}
      products={t.home.servicesTeaser.products.map((p) => ({ ...p, href: getRelativeLocaleUrl(lang, p.href) }))}
    />

    <section class="section">
      <div class="container glass-panel section-panel heading-panel">
        <SectionHeading
          eyebrow={t.home.industries.eyebrow}
          title={t.home.industries.title}
          subtitle={t.home.industries.subtitle}
          align="center"
        />
      </div>
      <div class="container industries-panel">
        <div class="section-body">
          <IndustriesTeaser
            featured={t.home.industries.items.map((i) => ({
              ...i,
              href: i.hasPage ? getRelativeLocaleUrl(lang, i.slug) : getRelativeLocaleUrl(lang, 'contacto'),
            }))}
            exploreLabel={t.home.industries.exploreLabel}
            contactLabel={t.home.industries.contactLabel}
          />
        </div>
      </div>
    </section>
  </HeroReveal>

  <section class="section theme-light stats-section">
    <div class="container">
      <SectionHeading title={t.common.statsTitle} align="center" />
      <div class="section-body">
        <StatBar stats={t.common.stats} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow={t.home.testimonials.eyebrow}
        title={t.home.testimonials.title}
      />
      <div class="section-body">
        <Testimonials
          items={t.home.testimonials.items}
          successHref={getRelativeLocaleUrl(lang, 'contacto')}
          successLabel={t.home.testimonials.successCta}
        />
      </div>
    </div>
  </section>

  <ContactFooter lang={lang} />
</Layout>

<style>
  .section {
    padding-block: var(--space-lg);
    padding-inline: var(--container-pad);
  }
  .section-panel {
    padding: clamp(2rem, 4vw, 3rem);
    border: none;
  }
  .industries-panel {
    padding-inline: 0;
    margin-top: var(--space-lg);
  }
  .industries-panel .section-body {
    margin-top: 0;
  }
  .section-body {
    margin-top: var(--space-lg);
  }

  .stats-section :global(.title) {
    color: var(--dot-gray);
  }
</style>
