---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/sections/PageHero.astro';
import SectionHeading from '../components/sections/SectionHeading.astro';
import HighlightPanel from '../components/sections/HighlightPanel.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import TeamGrid from '../components/sections/TeamGrid.astro';
import PresenceNetwork from '../components/sections/PresenceNetwork.astro';
import StatBar from '../components/sections/StatBar.astro';
import ClientLogos from '../components/sections/ClientLogos.astro';
import CTASection from '../components/sections/CTASection.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/utils';
import { withBase } from '../utils/paths';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const about = t.about;

const presenceCore = t.nav.countries.find((c) => c.name === 'Chile') ?? t.nav.countries[0];
const presenceNodes = t.nav.countries.filter((c) => c !== presenceCore);
---

<Layout
  title={`${about.metaTitle} — DOT Solutions`}
  description={about.metaDescription}
  lang={lang}
  path="/nosotros"
>
  <PageHero eyebrow={about.hero.eyebrow} title={about.hero.title} subtitle={about.hero.subtitle} image="/images/team-office.jpg" />

  <section class="section">
    <div class="container">
      <figure class="office-photo" data-reveal>
        <img src={withBase('/office/office-team.jpg')} alt={about.office.alt} loading="lazy" />
        <figcaption>{about.office.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <HighlightPanel
        eyebrow={about.mission.eyebrow}
        title={about.mission.title}
        body={about.mission.body}
        points={about.mission.points}
        image="/images/mycelium-roots.jpg"
      />
    </div>
  </section>

  <section class="section theme-light">
    <div class="container values-panel">
      <SectionHeading eyebrow={about.values.eyebrow} title={about.values.title} />
      <div class="section-body">
        <FeatureGrid items={about.values.items} cols={4} />
      </div>
    </div>
  </section>

  <TeamGrid eyebrow={about.team.eyebrow} title={about.team.title} members={about.team.members} />

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow={about.presence.eyebrow} title={about.presence.title} subtitle={about.presence.subtitle} align="center" />

      <div class="presence-network-wrap">
        <PresenceNetwork core={presenceCore} coreLabel={about.presence.officeLabel} nodes={presenceNodes} />
      </div>
      <ul class="countries countries-mobile">
        {t.nav.countries.map((c) => <li>{c.flag} {c.name}</li>)}
      </ul>

      <div class="presence">
        <div class="presence-text" data-reveal>
          <p class="office-label">{about.presence.officeLabel}</p>
          <p class="office-address">{about.presence.office}</p>
        </div>
        <img class="presence-photo" src={withBase('/office/office-santiago.jpg')} alt={about.presence.photoAlt} loading="lazy" data-reveal />
      </div>
    </div>
  </section>

  <section class="section theme-light">
    <div class="container">
      <SectionHeading eyebrow={about.credibility.eyebrow} title={about.credibility.title} align="center" />
      <p class="partner-badge" data-reveal>{about.credibility.partner}</p>
      <div class="section-body">
        <StatBar stats={t.common.stats} />
      </div>
    </div>
  </section>

  <ClientLogos title={t.common.clientsTitle} />

  <div class="container final-cta">
    <CTASection
      title={about.cta.title}
      body={about.cta.body}
      button={about.cta.button}
      href={getRelativeLocaleUrl(lang, 'contacto')}
    />
  </div>
</Layout>

<style>
  .section {
    padding-block: var(--space-lg);
  }
  .section-body {
    margin-top: var(--space-lg);
  }

  .office-photo img {
    width: 100%;
    border-radius: var(--radius-lg);
    aspect-ratio: 21/9;
    object-fit: cover;
  }
  .office-photo figcaption {
    margin-top: var(--space-sm);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    text-align: center;
  }

  /* Diagrama de red (Chile + 7 países) — solo desktop; en mobile no hay espacio real para
     que un hub-and-spoke se lea bien, así que se reemplaza por el listado simple de pills. */
  .presence-network-wrap {
    display: none;
  }
  .countries-mobile {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin-top: var(--space-lg);
  }
  .countries-mobile li {
    font-size: var(--text-sm);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: 0.4rem 0.9rem;
  }
  @media (min-width: 900px) {
    .presence-network-wrap {
      display: block;
      margin-block: var(--space-xl);
    }
    .countries-mobile {
      display: none;
    }
  }

  .presence {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
    margin-top: var(--space-lg);
  }
  .office-label {
    font-size: var(--text-sm);
    color: var(--dot-micelio);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
  }
  .office-address {
    margin-top: var(--space-xs);
    color: var(--text-secondary);
  }
  .presence-photo {
    width: 100%;
    border-radius: var(--radius-lg);
    aspect-ratio: 4/3;
    object-fit: cover;
    border: 1px solid color-mix(in srgb, var(--dot-micelio) 25%, transparent);
  }

  /* Badge "Partner SAP en Latinoamérica" — glow micelio, mismo lenguaje que el resto de
     las cards/pills ajustadas en Gastronomía y Retail. */
  .partner-badge {
    display: table;
    margin-inline: auto;
    margin-top: var(--space-md);
    padding: 0.6rem 1.5rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--dot-micelio);
    box-shadow: 0 0 22px color-mix(in srgb, var(--dot-micelio) 30%, transparent);
    color: var(--dot-micelio);
    font-weight: 600;
  }

  @media (min-width: 900px) {
    .presence {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* "Cómo trabajamos" — cards oscuras con acento y borde que se ilumina, para que
     contrasten contra el fondo claro (.theme-light) de esta sección (FeatureGrid es
     compartido con Gastronomía/Retail/Servicios, por eso el scope va acá). */
  .values-panel :global(.feature-grid) {
    gap: 1.25rem !important;
  }
  .values-panel :global(.feature) {
    position: relative;
    overflow: hidden;
    background: var(--dot-dark) !important;
    border: 1px solid color-mix(in srgb, var(--card-values-accent, var(--dot-micelio)) 45%, transparent) !important;
    transition: border-color 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }
  .values-panel :global(.feature:hover) {
    border-color: var(--card-values-accent, var(--dot-micelio)) !important;
    box-shadow: 0 0 30px color-mix(in srgb, var(--card-values-accent, var(--dot-micelio)) 30%, transparent);
    transform: translateY(-4px);
  }
  .values-panel :global(.feature:nth-child(4n + 1)) {
    --card-values-accent: var(--dot-micelio);
  }
  .values-panel :global(.feature:nth-child(4n + 2)) {
    --card-values-accent: var(--dot-moss);
  }
  .values-panel :global(.feature:nth-child(4n + 3)) {
    --card-values-accent: var(--dot-sage);
  }
  .values-panel :global(.feature:nth-child(4n + 4)) {
    --card-values-accent: var(--dot-forest);
  }
  .values-panel :global(.feature h3) {
    color: var(--dot-light) !important;
  }
  .values-panel :global(.feature p) {
    color: color-mix(in srgb, var(--dot-light) 75%, transparent) !important;
  }

  /* CTA final — mismo tratamiento que Gastronomía/Retail: card negra sólida con borde
     micelio resplandeciente, título en micelio y cuerpo en blanco. */
  .final-cta :global(.cta-panel) {
    background: var(--dot-dark) !important;
    border: 1px solid var(--dot-micelio) !important;
    box-shadow: 0 0 36px color-mix(in srgb, var(--dot-micelio) 40%, transparent) !important;
  }
  .final-cta :global(.cta-panel h2) {
    color: var(--dot-micelio) !important;
  }
  .final-cta :global(.cta-panel p) {
    color: var(--dot-light) !important;
  }
</style>
