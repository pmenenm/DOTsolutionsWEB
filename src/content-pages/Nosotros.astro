---
// src/content-pages/Nosotros.astro
// Reconstrucción completa en 5 actos narrativos, basada en el brandbook DOT
// ("La ingeniería perfecta del mundo natural aplicada al software
// empresarial"): Hero editorial con canvas de partículas + reveal de texto,
// los 4 Pilares en scroll horizontal pineado, "Si DOT fuera una persona" +
// código de voz, arquetipos + equipo real, y cierre de impacto.
import Layout from '../layouts/Layout.astro';
import TeamGrid from '../components/sections/TeamGrid.astro';
import PresenceNetwork from '../components/sections/PresenceNetwork.astro';
import StatBar from '../components/sections/StatBar.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/utils';
import { withBase } from '../utils/paths';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const about = t.about;
const contactHref = getRelativeLocaleUrl(lang, 'contacto');

// Selección real de logos de /public/clients/ (no placeholders) para el trail
// del mouse — variedad de rubros e íconos reconocibles para que el efecto se
// sienta representativo del portafolio real de clientes, no genérico.
const CLIENT_TRAIL_FILES = [
  'asics.png',
  'bridgestone.png',
  'calvin-klein.png',
  'lacoste.png',
  'levis.png',
  'tommy-hilfiger.png',
  'wrangler.png',
  'havanna.png',
  'groupe-seb.png',
  'explora.png',
  'superzoo.png',
  'la-mar.png',
  'tanta.png',
  'dulce-luna.png',
  'porvenir.png',
  'sendero.png',
];
const clientTrailLogos = CLIENT_TRAIL_FILES.map((f) => withBase(`/clients/${f}`));
---

<Layout
  title={`${about.metaTitle} — DOT Solutions`}
  description={about.metaDescription}
  lang={lang}
  path="/nosotros"
>
  <!-- ============ ACTO 1 — HERO + "QUIÉNES SOMOS" (pestaña desde el hero) ============ -->
  <!-- Un único stage pineado: el fondo (background_1 + logoweb) ocupa toda la pantalla y,
       sin soltar el scroll, un panel claro entra como pestaña desde el borde derecho hasta
       cubrir ~70% del ancho. El logo vive corrido a la izquierda en desktop (no centrado)
       para que quede en pantalla dividida con el fondo una vez que la pestaña termina de
       cubrir el resto — si quedara centrado, la pestaña lo taparía apenas entrara. Recién
       con el panel en su lugar arranca el tipeo (GSAP TextPlugin), todo dentro del mismo
       tramo de scrub — la sección "sale" literalmente del hero, no es un bloque aparte
       debajo. Pineado + scrub sólo en desktop (≥1024px); en mobile el panel es un bloque
       estático de flujo normal debajo del fondo, con el tipeo disparado al entrar en vista. -->
  <section class="hero-stage" data-hero-stage>
    <img class="hero-bg-image" src={withBase('/images/background_1.jpg')} alt="" />
    <div class="hero-bg-overlay" aria-hidden="true"></div>
    <img class="hero-logo hero-logo--full" data-hero-logo-full src={withBase('/logoweb.png')} alt="DOT Solutions" />
    <img class="hero-logo hero-logo--dot" data-hero-logo-dot src={withBase('/dot.svg')} alt="" aria-hidden="true" />

    <div class="who-we-are-panel" data-who-panel>
      <div class="who-we-are-inner">
        <h2 class="who-we-are-title">{about.whoWeAre.title}</h2>
        <p class="who-we-are-text" data-typewriter data-typewriter-text={about.whoWeAre.text}></p>
      </div>
    </div>
  </section>

  <!-- ============ NUESTRA MISIÓN ============ -->
  <!-- Mismo criterio que "Quiénes somos" (modo claro, título gigante peso medium,
       alineado a la izquierda) pero con un tratamiento propio: sin pestaña ni tipeo,
       acá la dinámica es una regla que se dibuja al hacer scroll (scaleX 0→1) más una
       lista de datos duros con índice y riel vertical en Verde Raíz — refuerza el
       carácter "infraestructura" de la marca en vez de repetir el mecanismo del Acto 2. -->
  <section class="section mission-section">
    <div class="container mission-inner">
      <div class="mission-main">
        <h2 class="mission-title" data-reveal>{about.mission.title}</h2>
        <p class="mission-tagline" data-reveal>{about.mission.tagline}</p>
        <span class="mission-rule" data-mission-rule aria-hidden="true"></span>
        <p class="mission-body" data-reveal>{about.mission.body}</p>
      </div>

      <ul class="mission-facts">
        {about.mission.facts.map((fact, i) => (
          <li class="mission-fact" data-reveal>
            <span class="mission-fact-index">0{i + 1}</span>
            <p>{fact}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ NOVEDADES & EXPERIENCIA (galería horizontal pineada) ============ -->
  <!-- Traducción del spec HorizontalGallerySection.jsx (React + Tailwind + GSAP) al stack
       real del sitio (Astro + CSS + GSAP): el scroll vertical se convierte en desplazamiento
       lateral de la tira de tarjetas mientras la sección queda pineada, misma matemática de
       ScrollTrigger del spec (x: -(strip.scrollWidth - innerWidth), scrub, end atado al ancho
       de la tira). Sólo en desktop (≥1024px); en mobile la tira es un scroll horizontal nativo
       con snap, sin pin ni scroll-hijack. -->
  <section class="gallery-section" data-gallery-section>
    <div class="gallery-header">
      <p class="gallery-tag">[ {about.gallery.eyebrow} ]</p>
      <h2 class="gallery-title">{about.gallery.title}</h2>
    </div>

    <div class="gallery-wrapper" data-gallery-wrapper>
      <div class="gallery-strip" data-gallery-strip>
        {about.gallery.items.map((item) => (
          <div class="gallery-card">
            <img class="gallery-card-img" src={withBase(item.src)} alt={item.title} loading="lazy" />
            <div class="gallery-card-overlay">
              <p class="gallery-card-title">{item.title}</p>
              <p class="gallery-card-date">{item.date}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CÓMO TRABAJAMOS ============ -->
  <section class="section how-we-work-section">
    <div class="container how-we-work-inner">
      <h2 class="how-we-work-title" data-reveal>{about.howWeWork.title}</h2>
      <p class="how-we-work-tagline" data-reveal>{about.howWeWork.tagline}</p>

      <div class="how-we-work-grid">
        {about.howWeWork.items.map((item, i) => (
          <div class="how-we-work-card" data-reveal>
            <span class="how-we-work-index">0{i + 1}</span>
            <h3 class="how-we-work-name">{item.name}</h3>
            <p class="how-we-work-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Un solo <script> para las 3 animaciones de la página (hero, regla de la
       misión, galería) EN ESE ORDEN — a propósito: Astro compila cada bloque
       <script> de un .astro como un módulo separado y NO garantiza que se
       ejecuten en el mismo orden del código fuente (se comprobó en la práctica
       que el bloque de la galería podía correr antes que el del hero). Como el
       pin de la galería usa "start: 'top top'", si se mide ANTES de que el pin
       del hero haya insertado su spacer, la medición queda corta (falta la
       duración del pin del hero) y la galería arranca pineada superpuesta con
       la sección "Nuestra misión" en vez de después de ella. Consolidar todo
       en un único módulo elimina la ambigüedad: el orden de ejecución dentro
       de un mismo script es siempre el del código. -->
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { TextPlugin } from 'gsap/TextPlugin';

    gsap.registerPlugin(ScrollTrigger, TextPlugin);

    const MS_PER_CHAR = 0.035;

    function initHeroWhoWeAre() {
      const section = document.querySelector<HTMLElement>('[data-hero-stage]');
      const panel = document.querySelector<HTMLElement>('[data-who-panel]');
      const typeEl = document.querySelector<HTMLElement>('[data-typewriter]');
      const logoFull = document.querySelector<HTMLElement>('[data-hero-logo-full]');
      const logoDot = document.querySelector<HTMLElement>('[data-hero-logo-dot]');
      if (!section || !panel || !typeEl) return () => {};

      const text = typeEl.dataset.typewriterText ?? '';
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const mm = gsap.matchMedia();

      mm.add('(min-width: 1024px)', () => {
        typeEl.textContent = '';
        gsap.set(panel, { xPercent: 100 });

        // El isotipo "dot.svg" tiene una proporción muy distinta al wordmark
        // completo (marca ~cuadrada vs wordmark ancho) — igualarlos por
        // ancho los dejaría con alturas muy distintas, así que se iguala la
        // ALTURA ya renderizada del wordmark y se deja el ancho en auto.
        if (logoFull && logoDot) {
          gsap.set(logoFull, { left: '50%' });
          const fullHeight = logoFull.getBoundingClientRect().height;
          // x2.25 = x1.5 (más grande que el wordmark) x1.5 (segundo +50%
          // pedido después) — compuestos, no dos +50% independientes.
          if (fullHeight) gsap.set(logoDot, { height: fullHeight * 2.25, width: 'auto' });
        }

        if (reduced) {
          gsap.set(panel, { xPercent: 0 });
          if (logoFull && logoDot) {
            gsap.set(logoFull, { opacity: 0 });
            gsap.set(logoDot, { opacity: 1 });
          }
          typeEl.textContent = text;
          return () => {};
        }

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: section,
            pin: true,
            scrub: 1,
            start: 'top top',
            end: '+=180%',
            invalidateOnRefresh: true,
          },
        });

        tl.to(panel, { xPercent: 0, ease: 'power3.out', duration: 1.2 }, 0);

        if (logoFull && logoDot) {
          // El wordmark se desliza del centro hacia la posición final de la
          // izquierda (mismo punto donde ya vive "dot.svg", en reposo con
          // opacity:0) y recién ahí cruzan en opacidad — no es un fundido en
          // el mismo lugar, es un desplazamiento que termina en un cambio de
          // isotipo.
          tl.to(logoFull, { left: '25%', ease: 'power3.out', duration: 1.2 }, 0)
            .to(logoFull, { opacity: 0, duration: 0.5, ease: 'power1.out' }, 0.6)
            .to(logoDot, { opacity: 1, duration: 0.5, ease: 'power1.out' }, 0.6);
        }

        tl.to(
          typeEl,
          { text, duration: Math.max(text.length * MS_PER_CHAR, 1.5), ease: 'none' },
          1.0
        );

        return () => {
          tl.scrollTrigger?.kill();
          tl.kill();
          gsap.set(panel, { clearProps: 'all' });
          if (logoFull) gsap.set(logoFull, { clearProps: 'all' });
          if (logoDot) gsap.set(logoDot, { clearProps: 'all' });
        };
      });

      mm.add('(max-width: 1023px)', () => {
        gsap.set(panel, { clearProps: 'all' });

        if (reduced) {
          typeEl.textContent = text;
          return () => {};
        }

        typeEl.textContent = '';
        // Disparo único al entrar en pantalla, no scrub: atado 1:1 al scroll
        // dentro de una franja tan angosta (85%→35%) el texto se quedaba a
        // medio tipear si el usuario no scrolleaba exactamente a ese ritmo,
        // y nunca terminaba de escribirse.
        const tween = gsap.to(typeEl, {
          text,
          duration: Math.max(text.length * MS_PER_CHAR, 1.5),
          ease: 'none',
          scrollTrigger: {
            trigger: panel,
            start: 'top 85%',
            once: true,
          },
        });

        return () => {
          tween.scrollTrigger?.kill();
          tween.kill();
        };
      });

      return () => mm.revert();
    }

    function initMissionRule() {
      const rule = document.querySelector<HTMLElement>('[data-mission-rule]');
      if (!rule) return () => {};

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) {
        gsap.set(rule, { scaleX: 1 });
        return () => {};
      }

      gsap.set(rule, { transformOrigin: 'left center' });
      const tween = gsap.fromTo(
        rule,
        { scaleX: 0 },
        {
          scaleX: 1,
          duration: 0.9,
          ease: 'power3.out',
          scrollTrigger: { trigger: rule, start: 'top 85%' },
        }
      );

      return () => tween.scrollTrigger?.kill();
    }

    function initGallery() {
      const section = document.querySelector<HTMLElement>('[data-gallery-section]');
      const strip = document.querySelector<HTMLElement>('[data-gallery-strip]');
      if (!section || !strip) return () => {};

      const mm = gsap.matchMedia();

      mm.add('(min-width: 1024px)', () => {
        const getScrollLength = () => strip.scrollWidth - window.innerWidth;

        const tween = gsap.to(strip, {
          x: () => -getScrollLength(),
          ease: 'none',
          scrollTrigger: {
            trigger: section,
            pin: true,
            scrub: 1,
            start: 'top top',
            end: () => `+=${strip.scrollWidth}`,
            invalidateOnRefresh: true,
          },
        });

        return () => {
          tween.scrollTrigger?.kill();
          tween.kill();
          gsap.set(strip, { clearProps: 'transform' });
        };
      });

      mm.add('(max-width: 1023px)', () => () => {});

      return () => mm.revert();
    }

    // Migrado desde TeamGrid.astro (que tenía su propio <script> aparte) por
    // la MISMA razón que consolidó hero/misión/galería acá arriba: su pin
    // medía "top top" antes de que el spacer de la galería existiera todavía
    // (orden de ejecución entre módulos <script> separados no es determinista
    // en Astro), así que el filmstrip del equipo se pineaba de golpe muy
    // temprano y quedaba superpuesto visualmente sobre la sección de arriba.
    function initTeamHorizontalScroll() {
      const section = document.querySelector<HTMLElement>('[data-team-hz]');
      const containerEl = document.querySelector<HTMLElement>('[data-team-hz-container]');
      const trackEl = document.querySelector<HTMLElement>('[data-team-hz-track]');
      const progressBar = document.querySelector<HTMLElement>('[data-team-hz-progress-bar]');
      const counterCurrent = document.querySelector<HTMLElement>('[data-team-hz-counter-current]');
      if (!section || !containerEl || !trackEl) return () => {};

      const cards = gsap.utils.toArray<HTMLElement>('[data-member-card]', trackEl);
      const mm = gsap.matchMedia();

      mm.add('(min-width: 1024px)', () => {
        // `.team-hz-track` no fija `overflow`, así que queda en su valor por
        // defecto (visible) — y en ese caso `scrollWidth` NO cuenta el
        // padding-right final (los navegadores sólo lo reflejan cuando el
        // propio elemento recorta su overflow). Sin este ajuste la tira se
        // queda corta exactamente por ese padding y la última card termina
        // pegada al borde del viewport (o cortada). Se suma a mano.
        const getScrollLength = () => {
          const paddingRight = parseFloat(getComputedStyle(trackEl).paddingRight) || 0;
          return trackEl.scrollWidth - window.innerWidth + paddingRight;
        };

        const tween = gsap.to(trackEl, {
          x: () => -getScrollLength(),
          ease: 'none',
          scrollTrigger: {
            trigger: containerEl,
            pin: true,
            scrub: 0.6,
            start: 'top top',
            end: () => `+=${getScrollLength()}`,
            invalidateOnRefresh: true,
            onUpdate: (self) => {
              if (progressBar) progressBar.style.width = `${self.progress * 100}%`;
              if (counterCurrent) {
                const idx = Math.min(cards.length - 1, Math.floor(self.progress * cards.length));
                counterCurrent.textContent = String(idx + 1).padStart(2, '0');
              }
            },
          },
        });

        const cardTriggers = cards.map((card, i) => {
          // La última card del riel nunca recorre tanto como las demás: el
          // scroll se detiene apenas termina de entrar en pantalla, así que
          // su posición final (~70-80% del viewport) nunca cruza el umbral
          // "left 55%" que usan las demás — se quedaba a mitad de la
          // animación (más chica y más transparente) sin importar cuánto
          // scrolleara el usuario. Un umbral más permisivo para esta sola
          // card asegura que sí llegue a su tamaño real.
          const isLast = i === cards.length - 1;
          return gsap.fromTo(
            card,
            { opacity: 0.2, scale: 0.88, y: 40 },
            {
              opacity: 1,
              scale: 1,
              y: 0,
              ease: 'power2.out',
              scrollTrigger: {
                trigger: card,
                containerAnimation: tween,
                start: 'left 92%',
                end: isLast ? 'left 85%' : 'left 55%',
                scrub: true,
              },
            }
          );
        });

        return () => {
          tween.scrollTrigger?.kill();
          tween.kill();
          cardTriggers.forEach((t) => t.scrollTrigger?.kill());
          gsap.set(trackEl, { clearProps: 'transform' });
          gsap.set(cards, { clearProps: 'opacity,transform' });
          if (progressBar) progressBar.style.width = '0%';
          if (counterCurrent) counterCurrent.textContent = '01';
        };
      });

      mm.add('(max-width: 1023px)', () => () => {});

      return () => mm.revert();
    }

    // Migrado junto con initTeamHorizontalScroll — mismo componente/misma razón.
    function initMemberCursor() {
      const cursor = document.querySelector<HTMLElement>('[data-member-cursor]');
      const cards = gsap.utils.toArray<HTMLElement>('[data-member-card]');
      if (!cursor || !cards.length) return () => {};

      const mm = gsap.matchMedia();

      mm.add('(min-width: 1024px) and (hover: hover)', () => {
        const setX = gsap.quickTo(cursor, 'x', { duration: 0.35, ease: 'power3.out' });
        const setY = gsap.quickTo(cursor, 'y', { duration: 0.35, ease: 'power3.out' });

        const onMove = (e: MouseEvent) => {
          setX(e.clientX);
          setY(e.clientY);
        };
        const onEnter = () => gsap.to(cursor, { autoAlpha: 1, scale: 1, duration: 0.25, ease: 'power2.out' });
        const onLeave = () => gsap.to(cursor, { autoAlpha: 0, scale: 0.6, duration: 0.25, ease: 'power2.in' });

        window.addEventListener('mousemove', onMove);
        cards.forEach((card) => {
          card.addEventListener('mouseenter', onEnter);
          card.addEventListener('mouseleave', onLeave);
        });

        return () => {
          window.removeEventListener('mousemove', onMove);
          cards.forEach((card) => {
            card.removeEventListener('mouseenter', onEnter);
            card.removeEventListener('mouseleave', onLeave);
          });
          gsap.set(cursor, { autoAlpha: 0, scale: 0.6, clearProps: 'x,y' });
        };
      });

      mm.add('(max-width: 1023px), (hover: none)', () => () => {});

      return () => mm.revert();
    }

    // Migrado desde su propio <script> aparte — mismo motivo que hero/misión/
    // galería/equipo: acá agrega un ScrollTrigger con pin propio (para que la
    // sección se detenga un tramo y dé tiempo real a mover el mouse sobre el
    // trail), y ese pin corre el mismo riesgo de medirse antes de que los
    // spacers de las secciones anteriores existan si vive en un módulo aparte.
    function initClientsTrail() {
      const section = document.querySelector<HTMLElement>('[data-clients-trail]');
      if (!section) return () => {};

      const logos: string[] = JSON.parse(section.dataset.logos ?? '[]');
      if (!logos.length) return () => {};

      const nextLogo = gsap.utils.wrap(logos);
      let index = 0;

      // Las cards viven DENTRO de la sección (position:absolute, no fixed) —
      // así la lluvia queda contenida por su overflow:hidden en vez de
      // escapar hacia el viewport y sumarle alto scrolleable real a la
      // página, sin importar cuánto caigan.
      function createCard(): HTMLImageElement {
        const img = document.createElement('img');
        img.src = nextLogo(index++);
        img.className = 'clients-trail-img';
        img.setAttribute('aria-hidden', 'true');
        section.appendChild(img);
        return img;
      }

      // ---------- Lluvia atada al scroll: nada de timers ni loops propios —
      // se crean todas las gotas de una vez y una sola timeline con scrub
      // reparte su caída a lo largo del tramo de scroll de la sección. Scrollear
      // hacia abajo hace caer la lluvia; scrollear hacia arriba la revierte. ----------
      const DROP_COUNT = 28;
      const DROP_SPAN = 15; // % de la timeline virtual que dura la caída de UNA gota

      function buildRain(triggerVars: { start: string; end: string }) {
        const rect = section.getBoundingClientRect();
        const fall = rect.height + 120;
        const master = gsap.timeline({
          scrollTrigger: { trigger: section, scrub: true, ...triggerVars },
        });

        for (let i = 0; i < DROP_COUNT; i++) {
          const img = createCard();
          img.style.left = `${gsap.utils.random(5, 95)}%`;
          img.style.top = '-4rem';
          const startAt = gsap.utils.random(0, 100 - DROP_SPAN);
          const dropTl = gsap
            .timeline()
            .fromTo(
              img,
              { opacity: 0, rotation: gsap.utils.random(-6, 6) },
              { opacity: 0.9, duration: DROP_SPAN * 0.2, ease: 'power1.out' }
            )
            .to(img, { y: fall, duration: DROP_SPAN, ease: 'none' }, 0)
            .to(img, { opacity: 0, duration: DROP_SPAN * 0.25 }, `>-${DROP_SPAN * 0.25}`);
          master.add(dropTl, startAt);
        }

        return master;
      }

      // ---------- Trail al hover: además de la lluvia, en puntero fino los
      // logos también siguen al cursor (comportamiento previo, sin tocar). ----------
      const mm = gsap.matchMedia();

      mm.add('(hover: hover) and (pointer: fine)', () => {
        // Pin simple (sin scrub, sin animar nada por scroll): sólo mantiene
        // la sección quieta un tramo de scroll para dar tiempo real a mover
        // el mouse y ver el trail, en vez de que la sección pase de largo.
        const st = ScrollTrigger.create({
          trigger: section,
          start: 'top top',
          end: '+=220%',
          pin: true,
        });

        // Misma ventana de scroll que el pin — la lluvia recorre exactamente
        // el mismo tramo que el usuario scrollea mientras está pineado.
        const rain = buildRain({ start: 'top top', end: '+=220%' });

        const GAP = 80; // distancia mínima (px) entre disparos consecutivos

        let mouseX = 0;
        let mouseY = 0;
        let lastX = 0;
        let lastY = 0;
        let started = false;

        function onMouseMove(e: MouseEvent) {
          mouseX = e.clientX;
          mouseY = e.clientY;
          if (!started) {
            // La primera posición conocida no debería disparar un salto
            // gigante desde (0,0) — se toma como punto de partida real.
            lastX = mouseX;
            lastY = mouseY;
            started = true;
          }
        }

        function playBurst(el: HTMLElement) {
          // fromTo explícito, no `.from()`: la card arranca en opacity:0 por
          // CSS (estado de reposo antes de ser disparada), así que un
          // `.from()` capturaría ESE mismo 0 como valor "final" y la
          // animación entera correría siempre invisible.
          gsap
            .timeline({ onComplete: () => el.remove() })
            .fromTo(
              el,
              { opacity: 0, scale: 0.2 },
              { opacity: 1, scale: 1, duration: 0.4, ease: 'elastic.out(1, 0.4)' }
            )
            .to(el, { rotation: gsap.utils.random(-25, 25), duration: 0.4 }, '<')
            .to(el, { y: '60vh', opacity: 0, ease: 'power2.in', duration: 1.2 }, 0.2);
        }

        function fireBurst(x: number, y: number) {
          const rect = section.getBoundingClientRect();
          const img = createCard();
          img.style.left = `${x - rect.left}px`;
          img.style.top = `${y - rect.top}px`;
          playBurst(img);
        }

        function tick() {
          const dist = Math.hypot(mouseX - lastX, mouseY - lastY);
          if (dist > GAP) {
            fireBurst(mouseX, mouseY);
            lastX = mouseX;
            lastY = mouseY;
          }
        }

        section.addEventListener('mousemove', onMouseMove);
        gsap.ticker.add(tick);

        return () => {
          st.kill();
          rain.scrollTrigger?.kill();
          rain.kill();
          section.removeEventListener('mousemove', onMouseMove);
          gsap.ticker.remove(tick);
          document.querySelectorAll('.clients-trail-img').forEach((el) => el.remove());
        };
      });

      mm.add('(hover: none), (pointer: coarse)', () => {
        // Sin pin acá — la sección scrollea de forma normal, así que la
        // lluvia se reparte a lo largo de su propio tramo natural en pantalla.
        const rain = buildRain({ start: 'top bottom', end: 'bottom top' });

        return () => {
          rain.scrollTrigger?.kill();
          rain.kill();
          document.querySelectorAll('.clients-trail-img').forEach((el) => el.remove());
        };
      });

      return () => {
        mm.revert();
        document.querySelectorAll('.clients-trail-img').forEach((el) => el.remove());
      };
    }

    function initNosotrosAnimations() {
      // Cada init corre aislado: si UNO falla (ej. una dependencia que no
      // cargó), no debe tirar abajo en silencio el resto de las animaciones
      // de la página — antes, un error temprano en la lista cortaba la
      // construcción del array entero y ninguna de las siguientes corría.
      const steps: [string, () => () => void][] = [
        ['initHeroWhoWeAre', initHeroWhoWeAre],
        ['initMissionRule', initMissionRule],
        ['initGallery', initGallery],
        ['initTeamHorizontalScroll', initTeamHorizontalScroll],
        ['initMemberCursor', initMemberCursor],
        ['initClientsTrail', initClientsTrail],
      ];
      const cleanups: (() => void)[] = [];
      for (const [name, fn] of steps) {
        try {
          cleanups.push(fn());
        } catch (err) {
          console.error(`[nosotros] ${name} failed to initialize:`, err);
        }
      }
      document.addEventListener(
        'astro:before-swap',
        () => cleanups.forEach((fn) => fn()),
        { once: true }
      );
    }

    document.addEventListener('astro:page-load', initNosotrosAnimations);
  </script>

