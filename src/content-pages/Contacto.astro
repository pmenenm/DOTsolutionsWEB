---
import Layout from '../layouts/Layout.astro';
import ContactHero from '../components/sections/ContactHero.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const c = t.contacto;
---

<Layout title={`${c.metaTitle} — DOT Solutions`} description={c.metaDescription} lang={lang} path="/contacto">
  <ContactHero
    eyebrow={c.hero.eyebrow}
    title={c.hero.title}
    subtitle={c.hero.subtitle}
    clientsTitle={t.common.clientsTitle}
    statsTitle={t.common.statsTitle}
    stats={t.common.stats}
  >
    <div class="form-card" data-reveal>
      <div class="form-card-glow" aria-hidden="true"></div>
      <div class="form-card-inner">
        <ContactForm form={c.form} lang={lang} />
      </div>
    </div>
  </ContactHero>
</Layout>

<style>
  /* Card del formulario — vive dentro del slot de ContactHero, junto al
     copy, no como sección propia: así ambos se ven de entrada. */
  .form-card {
    position: relative;
    width: 100%;
    background: color-mix(in srgb, var(--dot-dark) 45%, transparent);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
    border: 1px solid color-mix(in srgb, var(--dot-dark) 60%, transparent);
    border-radius: var(--radius-sm);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    box-shadow: 0 25px 60px -20px color-mix(in srgb, var(--dot-dark) 60%, transparent);
    overflow: hidden;
    box-sizing: border-box;
  }
  .form-card-glow {
    position: absolute;
    top: -30%;
    right: -15%;
    width: 22rem;
    height: 22rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--dot-micelio) 16%, transparent) 0%, transparent 70%);
    pointer-events: none;
  }
  .form-card-inner {
    position: relative;
  }
</style>
