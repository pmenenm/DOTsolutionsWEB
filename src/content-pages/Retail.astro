---
import Layout from '../layouts/Layout.astro';
import IndustryHero from '../components/sections/IndustryHero.astro';
import SectionHeading from '../components/sections/SectionHeading.astro';
import EcosystemRadialMap from '../components/sections/EcosystemRadialMap.astro';
import DataFlowCard from '../components/sections/DataFlowCard.astro';
import RetailPiecesScroll from '../components/sections/RetailPiecesScroll.astro';
import BenefitsList from '../components/sections/BenefitsList.astro';
import ProductIndustriesStrip from '../components/sections/ProductIndustriesStrip.astro';
import StatBar from '../components/sections/StatBar.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import ClientLogos from '../components/sections/ClientLogos.astro';
import CTASection from '../components/sections/CTASection.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const r = t.retail;
const contactHref = getRelativeLocaleUrl(lang, 'contacto');

const pieces = r.ecosystem.pieces.map((p) => ({
  ...p,
  href: p.href ? getRelativeLocaleUrl(lang, p.href) : undefined,
}));
---

<Layout title={`${r.metaTitle} — DOT Solutions`} description={r.metaDescription} lang={lang} path="/retail">
  <IndustryHero
    eyebrow={r.hero.eyebrow}
    title={r.hero.title}
    subtitle={r.hero.subtitle}
    desc={r.hero.desc}
    bullets={r.hero.bullets}
    cta={r.hero.cta}
    ctaHref={contactHref}
    image="/images/background_2.jpg"
    titleMaxWidth="19ch"
  />

  <DataFlowCard eyebrow={t.common.dataFlowEyebrow} title={t.common.dataFlowTitle} />

  <ClientLogos title={t.common.trustedByTitle} />

  <div class="ecosystem-side-by-side">
    <EcosystemRadialMap
      eyebrow={r.ecosystem.eyebrow}
      titleHighlight={r.ecosystem.titleHighlight}
      titleRest={r.ecosystem.titleRest}
      subtitle={r.ecosystem.subtitle}
      pieces={pieces}
      coreLogo="/logos/sap.png"
      coreLabel="SAP Business One"
      coreSublabel={lang === 'en' ? 'ERP Core' : 'Núcleo ERP'}
    />
  </div>

  <RetailPiecesScroll eyebrow={r.pieces.eyebrow} title={r.pieces.title} modules={r.pieces.items} />

  <section class="section unified-section">
    <div class="container">
      <div class="glass-panel unified-panel">
        <SectionHeading eyebrow={r.unified.eyebrow} title={r.unified.title} subtitle={r.unified.desc} />

        <!-- Diagrama de flujo omnicanal — ilustra literalmente "un solo canal": el mismo
             inventario circulando entre tienda física, online y bodega, con puntos
             viajando en loop (SMIL, mismo mecanismo que EcosystemRadialMap/DataFlowCard). -->
        <div class="unified-flow" data-unified-flow>
          <svg class="unified-flow-svg" viewBox="0 0 100 34" preserveAspectRatio="none" aria-hidden="true">
            <path id="unified-flow-path-1" class="unified-flow-line" d="M 10 17 C 27 4, 33 4, 50 17" fill="none" />
            <path id="unified-flow-path-2" class="unified-flow-line" d="M 50 17 C 67 30, 73 30, 90 17" fill="none" />
            <path id="unified-flow-path-3" class="unified-flow-line" d="M 90 17 C 73 4, 27 30, 10 17" fill="none" />
            <circle r="1.1" fill="var(--dot-micelio)" class="unified-flow-orb">
              <animateMotion dur="2.6s" begin="0s" repeatCount="indefinite"><mpath href="#unified-flow-path-1" /></animateMotion>
            </circle>
            <circle r="1.1" fill="var(--dot-micelio)" class="unified-flow-orb">
              <animateMotion dur="2.6s" begin="0.9s" repeatCount="indefinite"><mpath href="#unified-flow-path-2" /></animateMotion>
            </circle>
            <circle r="1.1" fill="var(--dot-micelio)" class="unified-flow-orb">
              <animateMotion dur="2.6s" begin="1.8s" repeatCount="indefinite"><mpath href="#unified-flow-path-3" /></animateMotion>
            </circle>
          </svg>
          <div class="unified-flow-node">
            <div class="unified-flow-badge" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M6 8V6a4 4 0 1 1 8 0v2M4 8h12l-1 11a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1L4 8Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
            <p>Tienda física</p>
          </div>
          <div class="unified-flow-node">
            <div class="unified-flow-badge" aria-hidden="true">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M3 12h18M12 3c2.4 2.4 3.6 5.7 3.6 9s-1.2 6.6-3.6 9c-2.4-2.4-3.6-5.7-3.6-9s1.2-6.6 3.6-9Z" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
            </div>
            <p>Online</p>
          </div>
          <div class="unified-flow-node">
            <div class="unified-flow-badge" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M3 8l9-4.5L21 8v8l-9 4.5L3 16V8Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /><path d="M3 8l9 4.5L21 8M12 12.5V21" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
            <p>Bodega · Stock</p>
          </div>
        </div>

        <div class="section-body narrow">
          <BenefitsList items={r.unified.items} />
        </div>
      </div>
    </div>
  </section>

  <script>
    // Fade-up al entrar en viewport — mismo patrón que BenefitsList/PainBento/etc.
    function initUnifiedFlow() {
      const flows = document.querySelectorAll<HTMLElement>('[data-unified-flow]');
      if (!flows.length) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.3 }
      );

      flows.forEach((el) => {
        const rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight && rect.bottom > 0) {
          el.classList.add('is-visible');
        } else {
          observer.observe(el);
        }
      });
    }

    document.addEventListener('astro:page-load', initUnifiedFlow);
  </script>

  <section class="section">
    <div class="container integrations-grid">
      <div class="integrations-card">
        <ProductIndustriesStrip
          eyebrow={r.integrations.payments.eyebrow}
          title={r.integrations.payments.title}
          items={r.integrations.payments.items}
        />
      </div>
      <div class="integrations-card">
        <ProductIndustriesStrip
          eyebrow={r.integrations.formats.eyebrow}
          title={r.integrations.formats.title}
          items={r.integrations.formats.items}
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <StatBar stats={r.stats} />
    </div>
  </section>

  <section class="section">
    <div class="container why-panel">
      <SectionHeading eyebrow={r.why.eyebrow} title={r.why.title} subtitle={r.why.intro} />
      <div class="section-body">
        <FeatureGrid items={r.why.items} cols={3} />
      </div>
    </div>
  </section>

  <ClientLogos title={r.clientsTitle} />

  <div class="container final-cta">
    <CTASection title={r.finalCta.title} body={r.finalCta.body} button={r.finalCta.button} href={contactHref} />
  </div>
</Layout>

<style>
  .section {
    padding-block: var(--space-lg);
  }
  .section-body {
    margin-top: var(--space-lg);
  }
  /* Los 4 beneficios en una sola fila (BenefitsList es compartido con 10+ páginas de
     producto, así que el scope va acá, no en el componente) — más ancho que el
     --content-max por defecto (única usuaria de esta clase en esta página), íconos todos en
     verde micelio (en vez de la rotación de colores por defecto) y borde que se ilumina en
     micelio al hover. */
  .section-body.narrow {
    /* % en vez de px fijo — un ancho fijo a veces coincidía justo con el espacio disponible
       del contenedor, llenándolo al 100% y sin margen que repartir para centrar (por más
       que margin-inline:auto estuviera bien puesto, no había espacio de sobra que mover).
       Con % siempre queda un margen visible a los costados, sin importar el ancho de
       pantalla. Mismo valor que .unified-flow para que ambos bloques compartan el mismo
       ancho/bordes. */
    max-width: 90%;
    margin-inline: auto;
  }
  @media (min-width: 900px) {
    .section-body.narrow :global(.benefits-grid) {
      /* BenefitsList trae su propio max-width:var(--content-max) (720px) SIN
         margin-inline:auto — por eso el grid quedaba encajonado y pegado a la izquierda de
         este contenedor más ancho, sin importar el ancho que se le diera por afuera. */
      max-width: none !important;
      grid-template-columns: repeat(4, 1fr) !important;
      gap: 1rem !important;
    }
    /* Sin card: ni caja, ni borde, ni ícono — solo el texto de cada beneficio. */
    .section-body.narrow :global(.benefit-card) {
      background: none !important;
      border: none !important;
      box-shadow: none !important;
      min-height: 0 !important;
      width: 100% !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: flex-start !important;
      text-align: center;
      padding: 0 !important;
      gap: 0 !important;
    }
    .section-body.narrow :global(.benefit-card:hover) {
      transform: none !important;
    }
    .section-body.narrow :global(.benefit-card::before),
    .section-body.narrow :global(.benefit-card::after) {
      display: none !important;
    }
    .section-body.narrow :global(.benefit-check) {
      width: 2rem !important;
      height: 2rem !important;
      padding: 0.35rem !important;
      margin-bottom: 0.5rem;
      border-color: color-mix(in srgb, var(--dot-micelio) 60%, transparent) !important;
      color: var(--dot-micelio) !important;
    }
    .section-body.narrow :global(.benefit-card p) {
      font-size: 1.1rem !important;
      line-height: 1.4 !important;
      text-align: center;
    }
  }
  .unified-panel {
    /* Padding lateral reducido a propósito — con el clamp completo (hasta 3rem por lado) no
       quedaba espacio real para que el diagrama y las cards crecieran hacia los costados
       (quedaban topeados por este padding antes de llegar a su max-width). */
    padding-block: clamp(2rem, 4vw, 3rem);
    padding-inline: clamp(1rem, 2vw, 1.5rem);
    border: none;
  }
  /* Más aire respecto a "Las piezas" (que además termina en un área pineada, se sentía
     todavía más pegada) — mismo criterio que "El ecosistema" más arriba. */
  .unified-section {
    padding-top: var(--space-xl);
  }

  /* Diagrama de flujo omnicanal — Tienda / Online / Bodega conectados por líneas curvas con
     puntos viajando en loop, ilustrando literalmente "un solo canal" antes de los 4
     beneficios de abajo. Fade-up al entrar en viewport, igual que el resto del sitio. */
  .unified-flow {
    position: relative;
    /* % en vez de px fijo — ver comentario en .section-body.narrow. */
    max-width: 90%;
    margin-top: var(--space-lg);
    margin-inline: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.95rem;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s var(--ease-out), transform 0.6s var(--ease-out);
  }
  .unified-flow.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .unified-flow-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }
  .unified-flow-line {
    stroke: var(--dot-micelio);
    stroke-width: 0.35;
    stroke-opacity: 0.35;
    stroke-dasharray: 1.2 1.6;
  }
  .unified-flow-orb {
    filter: drop-shadow(0 0 3px var(--dot-micelio));
  }

  .unified-flow-node {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.78rem;
    width: 33%;
  }
  .unified-flow-node p {
    font-size: 1.1375rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-align: center;
  }
  .unified-flow-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.225rem;
    height: 4.225rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--dot-dark) 55%, transparent);
    backdrop-filter: blur(12px);
    border: 1px solid color-mix(in srgb, var(--dot-micelio) 40%, transparent);
    box-shadow: 0 0 20px color-mix(in srgb, var(--dot-micelio) 18%, transparent);
    color: var(--dot-micelio);
  }
  .unified-flow-badge svg {
    width: 1.95rem;
    height: 1.95rem;
  }

  .integrations-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }
  /* Card con opacidad máxima (fondo sólido, sin transparencia) y borde micelio
     resplandeciente — mismo lenguaje que el resto de las cards ya ajustadas en esta página. */
  .integrations-card {
    padding: clamp(2rem, 4vw, 2.5rem);
    background: var(--dot-dark);
    border: 1px solid var(--dot-micelio);
    border-radius: var(--radius-lg);
    box-shadow: 0 0 32px color-mix(in srgb, var(--dot-micelio) 35%, transparent);
  }
  @media (min-width: 900px) {
    .integrations-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* "Un núcleo, seis piezas..." — EcosystemRadialMap es compartido con Gastronomía (no
     tocar ese componente ni esa página); acá se reorganiza SOLO en Retail: texto a la
     izquierda, núcleo + diagrama radial a la derecha, sin modificar nada del diagrama en
     sí — solo se reduce el tamaño del texto de la izquierda para que todo el bloque quepa
     en una sola pantalla junto al diagrama (que ya trae su propia altura fija). */
  .ecosystem-side-by-side :global(.ecosystem-radial) {
    /* Más separación arriba respecto a los logos que se mueven (ClientLogos) — el padding
       por defecto del componente (var(--space-lg) parejo arriba/abajo) los dejaba muy
       pegados. */
    padding-block: var(--space-xl) var(--space-lg) !important;
  }
  @media (min-width: 900px) {
    .ecosystem-side-by-side :global(.ecosystem-radial) {
      display: flex;
      align-items: center;
      gap: 2.5rem;
      max-width: var(--container-max);
      margin-inline: auto;
      padding-inline: var(--container-pad);
    }
    .ecosystem-side-by-side :global(.radial-header) {
      flex: 0 0 24rem;
      max-width: 24rem;
      width: auto;
      text-align: left;
      margin-inline: 0;
      padding: 0;
      padding-inline: 0;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .ecosystem-side-by-side :global(.radial-eyebrow) {
      justify-content: flex-start;
    }
    .ecosystem-side-by-side :global(.radial-title) {
      font-size: clamp(1.5125rem, 1.936vw, 1.9663rem) !important;
    }
    .ecosystem-side-by-side :global(.radial-subtitle) {
      font-size: 1.0588rem !important;
      margin-inline: 0;
      max-width: none;
    }
    .ecosystem-side-by-side :global(.radial-map) {
      flex: 1 1 0%;
      width: auto;
      max-width: none;
      margin-top: 0;
      padding-inline: 0;
    }
  }

  /* "Por qué DOT" y el CTA final — mismos colores/efectos que en Gastronomía (FeatureGrid y
     CTASection son compartidos con Nosotros/Servicios/etc., por eso el scope acá). */
  .why-panel {
    /* Solo bloque (arriba/abajo) — a diferencia de Gastronomía, acá "why-panel" está en el
       MISMO div que "container" (no en uno anidado adentro), así que un padding shorthand
       pisaría el padding-inline de .container y angostaría los márgenes laterales respecto
       al resto de las secciones de la página. */
    padding-block: clamp(2rem, 4vw, 3rem);
    border: none;
  }
  .why-panel :global(.feature-grid) {
    gap: 1.5rem !important;
  }
  .why-panel :global(.feature) {
    position: relative;
    overflow: hidden;
    background: var(--dot-light) !important;
    border: 1px solid color-mix(in srgb, var(--dot-dark) 10%, transparent) !important;
    border-radius: var(--radius-lg) !important;
    padding: clamp(1.75rem, 3vw, 2.25rem) !important;
    transition: transform 0.35s var(--ease-out), border-color 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }
  .why-panel :global(.feature:hover) {
    transform: translateY(-6px);
    border-color: var(--card-why-accent, var(--dot-micelio)) !important;
    box-shadow: 0 20px 44px -16px color-mix(in srgb, var(--dot-dark) 22%, transparent);
  }
  .why-panel :global(.feature:nth-child(1)) {
    --card-why-accent: var(--dot-micelio);
  }
  .why-panel :global(.feature:nth-child(2)) {
    --card-why-accent: var(--dot-moss);
  }
  .why-panel :global(.feature:nth-child(3)) {
    --card-why-accent: var(--dot-sage);
  }
  .why-panel :global(.feature::before) {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: var(--card-why-accent, var(--dot-micelio));
    transform: scaleX(0.3);
    transform-origin: left center;
    transition: transform 0.4s var(--ease-out);
  }
  .why-panel :global(.feature:hover::before) {
    transform: scaleX(1);
  }
  .why-panel :global(.feature h3) {
    position: relative;
    color: var(--dot-dark) !important;
    margin-top: 0.75rem;
  }
  .why-panel :global(.feature p) {
    position: relative;
    color: color-mix(in srgb, var(--dot-dark) 72%, transparent) !important;
  }

  .final-cta :global(.cta-panel) {
    background: var(--dot-dark) !important;
    border: 1px solid var(--dot-micelio) !important;
    box-shadow: 0 0 36px color-mix(in srgb, var(--dot-micelio) 40%, transparent) !important;
    max-width: 56rem !important;
  }
  .final-cta :global(.cta-panel h2) {
    color: var(--dot-micelio) !important;
  }
  .final-cta :global(.cta-panel p) {
    color: var(--dot-light) !important;
  }
</style>
