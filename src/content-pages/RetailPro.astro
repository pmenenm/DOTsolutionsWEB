---
import Layout from '../layouts/Layout.astro';
import ProductHero from '../components/sections/ProductHero.astro';
import SectionHeading from '../components/sections/SectionHeading.astro';
import PainBento from '../components/sections/PainBento.astro';
import ProcessTimelineAnimated from '../components/sections/ProcessTimelineAnimated.astro';
import BenefitsList from '../components/sections/BenefitsList.astro';
import AuthorityCTA from '../components/sections/AuthorityCTA.astro';
import ProductHorizontalScroll from '../components/sections/ProductHorizontalScroll.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const s = t.retailPro;
const contactHref = getRelativeLocaleUrl(lang, 'contacto');

// Título del hero en 2 líneas en vez de las 3 originales (line1/line2/line3) —
// se reparte el mismo texto real en otro punto de corte: "eficiente," cierra
// la 1ra línea, "escalable y omnicanal" arma la 2da.
const [heroPhraseA, heroPhraseB] = s.hero.line2.split(', ');
const heroLine1 = `${s.hero.line1} ${heroPhraseA},`;
const heroLine2 = `${heroPhraseB} ${s.hero.line3}`;
---

<Layout title={`${s.metaTitle} — DOT Solutions`} description={s.metaDescription} lang={lang} path="/retail-pro-prism">
  <ProductHorizontalScroll>
    <!-- Panel 01 — Hero -->
    <section class="h-panel h-panel--hero">
      <ProductHero
        line1={heroLine1}
        line2={heroLine2}
        subtitle={s.hero.subtitle}
        paragraph={s.hero.paragraph}
        cta={s.hero.cta}
        ctaHref={contactHref}
        logo="/logos/retailpro-white.png"
      />
    </section>

    <!-- Panel 02 — Diagnóstico -->
    <section class="h-panel">
      <div class="h-inner" data-h-reveal>
        <div class="panel-heading">
          <SectionHeading eyebrow={s.bento.eyebrow} title={s.bento.title} align="left" />
        </div>
        <div class="h-body">
          <PainBento items={s.bento.items} compact />
        </div>
      </div>
    </section>

    <!-- Panel 03 — Cómo funciona -->
    <section class="h-panel">
      <div class="h-inner" data-h-reveal>
        <div class="glass-panel process-panel">
          <SectionHeading eyebrow={s.process.eyebrow} title={s.process.title} subtitle={s.process.intro} align="center" />
          <div class="h-body narrow">
            <ProcessTimelineAnimated steps={s.process.steps} compact />
          </div>
        </div>
      </div>
    </section>

    <!-- Panel 04 — Beneficios -->
    <section class="h-panel">
      <div class="h-inner" data-h-reveal>
        <div class="panel-heading">
          <SectionHeading title={s.benefits.title} align="left" />
        </div>
        <div class="h-body">
          <BenefitsList items={s.benefits.items} compact />
        </div>
      </div>
    </section>
  </ProductHorizontalScroll>

  <AuthorityCTA title={s.authority.title} stats={s.authority.stats} cta={s.authority.cta} ctaHref={contactHref} />
</Layout>

<style>
  .h-inner {
    max-width: 72rem;
    margin-inline: auto;
  }
  .h-panel--hero :global(.subtitle) {
    color: var(--dot-light) !important;
    margin-top: var(--space-md) !important;
  }
  .h-panel--hero :global(.paragraph) {
    margin-top: var(--space-sm) !important;
  }
  .h-panel--hero :global(.product-hero-actions) {
    margin-top: var(--space-lg) !important;
  }
  .h-body {
    margin-top: var(--space-lg);
  }
  .h-body.narrow {
    max-width: var(--content-max);
    margin-inline: auto;
  }

  .process-panel {
    padding: clamp(1.95rem, 3.9vw, 2.925rem);
    border: none;
  }

  /* Título de cada panel — degradé animado, mismo truco que SAP pero con el
     acento por defecto del sitio (micelio) en vez del celeste específico de SAP. */
  .panel-heading :global(.title),
  .process-panel :global(.heading .title) {
    background: linear-gradient(
      90deg,
      var(--dot-light) 0%,
      var(--dot-light) 35%,
      var(--dot-micelio) 50%,
      var(--dot-light) 65%,
      var(--dot-light) 100%
    );
    background-size: 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: h-gradient-loop 6s linear infinite;
  }
  @keyframes h-gradient-loop {
    to {
      background-position: -250% 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel-heading :global(.title),
    .process-panel :global(.heading .title) {
      animation: none;
      background-position: 50% 0;
    }
  }

  @media (min-width: 1025px) {
    .h-panel--hero {
      padding-inline: 0;
      justify-content: flex-start;
    }
    /* El .container de ProductHero trae max-width + margin-inline:auto (se
       centra como bloque dentro del panel de 100vw) — acá se le saca ese
       tope para que el texto llegue hasta el borde real del margen de
       página (--container-pad), no a un punto centrado más adentro. */
    .h-panel--hero :global(.container.product-hero-grid) {
      max-width: none !important;
      margin-inline: 0 !important;
    }
    .panel-heading :global(.title),
    .process-panel :global(.heading .title) {
      font-size: clamp(2.325rem, 4.06vw, 3.38rem) !important;
    }
    .process-panel :global(.heading .subtitle) {
      font-size: 1.17rem !important;
      margin-top: 0.455rem !important;
    }
    .h-body.narrow {
      margin-top: 1.95rem !important;
    }

    /* El hero (ProductHero) usa la tipografía pensada para una página normal
       de ancho completo — acá, comprimido en un panel de 100vh dentro del
       riel horizontal, se reduce un escalón para que se lea cómodo. */
    .h-panel--hero :global(.product-hero-copy h1) {
      font-size: clamp(2.2rem, 3.8vw, 3.1rem) !important;
      /* La regla por defecto (14ch, pensada para 3 líneas cortas) hacía que
         la primera línea combinada ("Gestión de tienda eficiente, escalable
         y") envolviera en dos — con el container ya sin tope de ancho, acá
         hay espacio real para que entre completa en una sola línea. */
      max-width: 46ch !important;
    }
    .h-panel--hero :global(.subtitle) {
      font-size: 1.3rem !important;
    }
    .h-panel--hero :global(.paragraph) {
      font-size: 1.1rem !important;
    }
    .h-panel--hero :global(.product-hero-actions .cta) {
      padding: 0.8rem 1.75rem !important;
      font-size: 0.875rem !important;
    }

    /* La proporción 3fr/2fr por defecto (pensada para una card visual de
       ancho real) le daba a la copia menos ancho real del que su propio
       max-width (46ch) necesitaba, y el texto igual envolvía — acá la
       columna de texto toma todo el espacio que sobra y el logo (ya chico,
       sin card) solo el que necesita. */
    .h-panel--hero :global(.product-hero-grid:not(.no-visual)) {
      grid-template-columns: 1fr auto !important;
    }

    /* Logo suelto, sin la card que lo enmarcaba — flota libre en el panel,
       con un movimiento tipo "órbita" (traslación + rotación leves) y un
       pulso de escala, para que la mitad derecha del hero no se sienta
       estática frente al texto animado de la izquierda. */
    .h-panel--hero :global(.visual-panel) {
      max-width: 16rem !important;
      background: none !important;
      border: none !important;
      padding: 0 !important;
    }
    .h-panel--hero :global(.visual-panel::before) {
      display: none !important;
    }
    .h-panel--hero :global(.visual-panel img) {
      animation: hero-logo-orbit 7s ease-in-out infinite;
    }
    @keyframes hero-logo-orbit {
      0% {
        transform: translate(0, 0) scale(1) rotate(0deg);
      }
      25% {
        transform: translate(10px, -16px) scale(1.08) rotate(3deg);
      }
      50% {
        transform: translate(-6px, -6px) scale(0.94) rotate(-2deg);
      }
      75% {
        transform: translate(-12px, -14px) scale(1.05) rotate(2deg);
      }
      100% {
        transform: translate(0, 0) scale(1) rotate(0deg);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .h-panel--hero :global(.visual-panel img) {
        animation: none;
      }
    }
  }

  @media (max-width: 1024px) {
    .h-panel--hero {
      padding-inline: 0;
    }
  }
</style>
