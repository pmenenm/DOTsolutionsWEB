---
// src/content-pages/SapBusinessOne.astro
// Modelo de scroll híbrido: los primeros 4 paneles (Hero, Diagnóstico, Módulos,
// Proceso de selección) van en el riel horizontal pineado de
// SapHorizontalScroll.astro; a partir de ahí (Add-ons en adelante) la página
// sigue en scroll vertical normal, como cualquier otra sección del sitio.
// "Beneficios" e "Industrias" siguen fuera de la página a pedido explícito —
// sus componentes no se tocaron, solo dejaron de usarse acá.
import Layout from '../layouts/Layout.astro';
import SapHorizontalScroll from '../components/sections/SapHorizontalScroll.astro';
import ClientLogos from '../components/sections/ClientLogos.astro';
import ProductAddonsCTA from '../components/sections/ProductAddonsCTA.astro';
import ProductUpsellBanner from '../components/sections/ProductUpsellBanner.astro';
import AuthorityCTA from '../components/sections/AuthorityCTA.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const s = t.sap;
const contactHref = getRelativeLocaleUrl(lang, 'contacto');
const addonsHref = getRelativeLocaleUrl(lang, 'sap-business-one/addons');
const s4hanaHref = getRelativeLocaleUrl(lang, 'sap-s4hana');
const compareHref = getRelativeLocaleUrl(lang, 'business-one-vs-s4hana');
---

<Layout title={`${s.metaTitle} — DOT Solutions`} description={s.metaDescription} lang={lang} path="/sap-business-one">
  <SapHorizontalScroll s={s} contactHref={contactHref} />

  <section class="section logos-section">
    <ClientLogos title={t.common.clientsTitle} />
  </section>

  <section class="section">
    <div class="container">
      <ProductAddonsCTA
        eyebrow={s.addons.eyebrow}
        title={s.addons.title}
        desc={s.addons.desc}
        stats={s.addons.stats}
        cta={s.addons.cta}
        ctaHref={addonsHref}
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ProductUpsellBanner
        eyebrow={s.upsell.eyebrow}
        title={s.upsell.title}
        desc={s.upsell.desc}
        cta={s.upsell.cta}
        ctaHref={s4hanaHref}
        ctaSecondary={s.upsell.ctaSecondary}
        ctaSecondaryHref={compareHref}
      />
    </div>
  </section>

  <AuthorityCTA title={s.authority.title} stats={s.authority.stats} cta={s.authority.cta} ctaHref={contactHref} />
</Layout>

<style>
  .section {
    padding-block: var(--space-lg);
  }
  .logos-section {
    padding-block: var(--space-md) var(--space-lg);
  }

  :global(.product-hero-copy .subtitle) {
    color: #6fa8f0 !important;
    font-size: 1.05rem !important;
  }

  :global(.product-hero-copy .paragraph) {
    font-size: 0.92rem !important;
  }

  /* Baja todo el bloque de contenido del hero un 20% de su propia altura —
     el hero está anclado abajo (align-items:flex-end) porque tiene foto de
     fondo, así que esto lo acerca más al borde inferior real de la pantalla. */
  :global(.product-hero-grid) {
    transform: translateY(20%) !important;
  }

  :global(.product-hero-stats .value) {
    color: #6fa8f0 !important;
  }

  :global(.product-hero-actions .cta) {
    background: color-mix(in srgb, #6fa8f0 20%, transparent) !important;
    color: var(--dot-light) !important;
  }
  :global(.product-hero-actions .cta:hover) {
    background: color-mix(in srgb, #6fa8f0 95%, transparent) !important;
  }

  /* Módulos de "La plataforma" — íconos y borde-al-hover en celeste en vez
     de la rotación de colores de la paleta que usa ProductModulesGrid por
     defecto (--card-accent inline por card, pisado acá para toda la
     grilla). */
  :global(.module-card) {
    --card-accent: #6fa8f0 !important;
  }
  :global(.module-card::after) {
    content: none !important;
  }
  :global(.bento-card),
  :global(.module-card),
  :global(.upsell) {
    border-radius: var(--radius-md);
  }

  /* "El siguiente nivel" — oscura y sólida, sin tinte de color. */
  :global(.upsell) {
    background: var(--dot-dark) !important;
    border-color: color-mix(in srgb, var(--dot-light) 14%, transparent) !important;
  }

  /* Blur decorativo del "curve swipe" de AuthorityCTA, que asoma sobre la
     card anterior ("El siguiente nivel") — celeste en vez de verde. */
  :global(.curve-swipe path) {
    fill: #6fa8f0 !important;
  }

  /* Stats finales y CTA "Hablar con un experto" de AuthorityCTA — mismo
     celeste y mismos efectos (opacidad 20% -> 95% al hover) que el CTA del
     hero. */
  :global(.authority .value) {
    color: #6fa8f0 !important;
  }
  :global(.authority .cta-monumental) {
    background: color-mix(in srgb, #6fa8f0 20%, transparent) !important;
    color: var(--dot-light) !important;
  }
  :global(.authority .cta-monumental:hover) {
    background: color-mix(in srgb, #6fa8f0 95%, transparent) !important;
  }

  :global(.module-card h3) {
    display: inline-block;
    color: var(--dot-light) !important;
    transform-origin: left center;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }
  :global(.module-card:hover h3) {
    color: #6fa8f0 !important;
    transform: scale(1.08);
  }
</style>
