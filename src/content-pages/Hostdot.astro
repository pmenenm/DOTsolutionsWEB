---
import Layout from '../layouts/Layout.astro';
import ProductHero from '../components/sections/ProductHero.astro';
import SectionHeading from '../components/sections/SectionHeading.astro';
import PainBento from '../components/sections/PainBento.astro';
import ProcessTimelineAnimated from '../components/sections/ProcessTimelineAnimated.astro';
import BenefitsList from '../components/sections/BenefitsList.astro';
import AuthorityCTA from '../components/sections/AuthorityCTA.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const s = t.hostdot;
const contactHref = getRelativeLocaleUrl(lang, 'contacto');
---

<Layout title={`${s.metaTitle} — DOT Solutions`} description={s.metaDescription} lang={lang} path="/hostdot">
  <ProductHero
    line1={s.hero.line1}
    line2={s.hero.line2}
    line3={s.hero.line3}
    subtitle={s.hero.subtitle}
    paragraph={s.hero.paragraph}
    cta={s.hero.cta}
    ctaHref={contactHref}
    ctaSecondary={s.hero.ctaSecondary}
    ctaSecondaryHref="https://hosting.dotsolutions.app/index.php"
    logo="/logos/isotipos/hostdotiso.svg"
  />

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow={s.bento.eyebrow} title={s.bento.title} />
      <div class="section-body">
        <PainBento items={s.bento.items} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="glass-panel process-panel">
        <SectionHeading eyebrow={s.process.eyebrow} title={s.process.title} subtitle={s.process.intro} />
        <div class="section-body narrow">
          <ProcessTimelineAnimated steps={s.process.steps} />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading title={s.benefits.title} />
      <div class="section-body narrow">
        <BenefitsList items={s.benefits.items} />
      </div>
    </div>
  </section>

  <AuthorityCTA title={s.authority.title} stats={s.authority.stats} cta={s.authority.cta} ctaHref={contactHref} />
</Layout>

<style>
  .section {
    padding-block: var(--space-lg);
  }
  .section-body {
    margin-top: var(--space-lg);
  }
  .section-body.narrow {
    max-width: var(--content-max);
  }
  .process-panel {
    padding: clamp(2rem, 4vw, 3rem);
    border: none;
  }

  /* Las 3 líneas del hero ("Infraestructura cloud" / "de alto rendimiento
     para" / "negocios exigentes") son más largas que el resto de los
     productos — el max-width por defecto del h1 (14ch en desktop) las
     quebraba a más de 3 líneas. Ancho ajustado solo para esta página. */
  :global(.product-hero-grid:not(.no-visual) .product-hero-copy h1) {
    max-width: 26ch !important;
  }

  /* Los textos de esta página se sentían "burdos" (todo grande) — bajamos
     un escalón el tamaño de cada bloque compartido (título de sección,
     cards del diagnóstico, beneficios, subtítulo/párrafo del hero, stats
     finales), solo en Hostdot. */
  :global(.product-hero-copy .subtitle) {
    font-size: var(--text-sm) !important;
  }
  :global(.product-hero-copy .paragraph) {
    font-size: var(--text-xs) !important;
  }
  :global(.heading .title) {
    font-size: clamp(1.5rem, 3.2vw, 2.25rem) !important;
  }
  :global(.bento-card h3) {
    font-size: clamp(1.0625rem, 1.7vw, 1.3rem) !important;
  }
  :global(.bento-card p) {
    font-size: var(--text-sm) !important;
  }
  :global(.benefit-card p) {
    font-size: var(--text-sm) !important;
  }
  :global(.authority .value) {
    font-size: clamp(1.75rem, 3.6vw, 2.5rem) !important;
  }
  :global(.authority .label) {
    font-size: var(--text-sm) !important;
  }
  :global(.authority .sub) {
    font-size: var(--text-xs) !important;
  }
</style>
