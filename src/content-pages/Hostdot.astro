---
import Layout from '../layouts/Layout.astro';
import ProductHero from '../components/sections/ProductHero.astro';
import SectionHeading from '../components/sections/SectionHeading.astro';
import PainBento from '../components/sections/PainBento.astro';
import ProcessTimelineAnimated from '../components/sections/ProcessTimelineAnimated.astro';
import BenefitsList from '../components/sections/BenefitsList.astro';
import AuthorityCTA from '../components/sections/AuthorityCTA.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const s = t.hostdot;
const contactHref = getRelativeLocaleUrl(lang, 'contacto');
---

<Layout title={`${s.metaTitle} — DOT Solutions`} description={s.metaDescription} lang={lang} path="/hostdot">
  <ProductHero
    line1={s.hero.line1}
    line2={s.hero.line2}
    line3={s.hero.line3}
    subtitle={s.hero.subtitle}
    paragraph={s.hero.paragraph}
    cta={s.hero.cta}
    ctaHref={contactHref}
    logo="/logos/isotipos/hostdotiso.svg"
  />

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow={s.bento.eyebrow} title={s.bento.title} />
      <div class="section-body">
        <PainBento items={s.bento.items} />
      </div>
    </div>
  </section>

  <section class="section theme-light">
    <div class="container">
      <SectionHeading eyebrow={s.process.eyebrow} title={s.process.title} subtitle={s.process.intro} />
      <div class="section-body narrow">
        <ProcessTimelineAnimated steps={s.process.steps} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading title={s.benefits.title} />
      <div class="section-body narrow">
        <BenefitsList items={s.benefits.items} />
      </div>
    </div>
  </section>

  <AuthorityCTA title={s.authority.title} stats={s.authority.stats} cta={s.authority.cta} ctaHref={contactHref} />
</Layout>

<style>
  .section {
    padding-block: var(--space-lg);
  }
  .section-body {
    margin-top: var(--space-lg);
  }
  .section-body.narrow {
    max-width: var(--content-max);
  }
</style>
