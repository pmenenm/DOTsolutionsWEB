---
// src/content-pages/Blog.astro
// Listado de /blog — hero con fondo en video (loop) y título gigante a 2 líneas, seguido
// de un stack de tarjetas tipo archivador (position:sticky, CSS puro): cada post se fija
// en pantalla un momento y el siguiente se desliza por encima, sin necesitar JS para el
// efecto de apilado. Sin PageHero genérico a propósito: esta página se apoya en el mismo
// sistema visual pero con una composición propia, más de revista que de landing.
import Layout from '../layouts/Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/utils';
import { categoryColor, formatBlogDate, postImage } from '../utils/blog';
import { withBase } from '../utils/paths';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const b = t.blog;

const posts = [...b.posts].sort((a, b) => (a.date < b.date ? 1 : -1));
const categories = [...new Set(posts.map((p) => p.category))];
const contactHref = getRelativeLocaleUrl(lang, 'contacto');
---

<Layout title={`${b.metaTitle} — DOT Solutions`} description={b.metaDescription} lang={lang} path="/blog">
  <section class="blog-hero">
    <div class="container">
      <h1 class="news-stack-title" data-reveal>{b.stackTitle}</h1>

      <p class="news-stack-subtitle" data-reveal>{b.subtitle}</p>

      <ul class="category-legend" data-reveal>
        {categories.map((c) => (
          <li>
            <span class="legend-dot"></span>
            {c}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Stack de tarjetas tipo archivador: todas fijas al mismo `top` (position:sticky, CSS
       puro, sin JS) con z-index creciente, así cada card nueva sube y tapa por completo a
       la anterior en vez de asomar un borde de las de más atrás. -->
  <section class="news-stack-section">
    <div class="container">
      <div class="news-stack">
        {posts.map((post, i) => (
          <a
            href={`${getRelativeLocaleUrl(lang, 'blog')}${post.slug}`}
            class="news-card"
            data-reveal
            style={`z-index: ${i + 1}; --card-accent: ${categoryColor(post.category)};`}
          >
            <div class="news-card-media">
              <img src={withBase(postImage(post.slug))} alt="" loading="lazy" />
            </div>
            <div class="news-card-body">
              <div class="news-card-top">
                <p class="news-card-date">{formatBlogDate(post.date, lang)}</p>
                <h3>{post.title}</h3>
                <p class="news-card-excerpt">{post.excerpt}</p>
              </div>
              <div class="news-card-bottom">
                <span class="news-card-cta">
                  {b.readMore}
                  <span class="arrow" aria-hidden="true">→</span>
                </span>
              </div>
            </div>
          </a>
        ))}

        <!-- Última card del stack — sin foto, mensaje de cierre. Mismo mecanismo de
             sticky/z-index que las anteriores, pero invertida (oscura + glow micelio
             permanente) para que se lea como el cierre, no como un post más. -->
        <div class="news-card news-card--cta" data-reveal style={`z-index: ${posts.length + 1};`}>
          <div class="news-card-body">
            <div class="news-card-top">
              <h3>{t.common.ctaTitle}</h3>
              <p class="news-card-excerpt">{t.common.ctaBody}</p>
            </div>
            <div class="news-card-bottom">
              <a href={contactHref} class="news-card-cta">
                {t.common.ctaButton}
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-hero {
    position: relative;
    display: flex;
    align-items: flex-start;
    background: var(--dot-dark);
    padding-block: var(--space-md) var(--space-sm);
    overflow: hidden;
  }
  .blog-hero .container {
    padding-top: 6rem;
  }
  .blog-hero .news-stack-title {
    position: relative;
    z-index: 1;
  }
  /* Leyenda de categorías — justo debajo del título, centrada, con margen
     propio para que el título respire antes de la leyenda. Cada punto usa
     el mismo color micelio, para que se lea de inmediato como un sistema. */
  .category-legend {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: var(--space-sm) auto 0;
    max-width: 60%;
  }
  .category-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--text-primary);
  }
  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--dot-micelio);
    box-shadow: 0 0 12px var(--dot-micelio);
  }

  /* Stack de tarjetas tipo archivador — fondo oscuro, cards claras (colores invertidos a
     propósito respecto al primer intento). El efecto de apilado es 100% CSS: TODAS las
     cards comparten el mismo `top` (sticky) y solo el z-index crece por índice, así cada
     card nueva sube y tapa por completo a la anterior en vez de asomar un borde de las de
     más atrás — sin necesitar JS. */
  .news-stack-section {
    background: var(--dot-dark);
    padding-block: var(--space-lg) var(--space-xl);
  }
  .news-stack-title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.6rem, 5.85vw, 3.9rem);
    color: var(--dot-light);
    text-align: center;
  }
  .news-stack-subtitle {
    margin-top: var(--space-sm);
    margin-bottom: 0;
    font-size: var(--text-lg);
    font-weight: 300;
    line-height: 1.5;
    color: color-mix(in srgb, var(--dot-light) 75%, transparent);
    text-align: center;
    max-width: 48ch;
    margin-inline: auto;
  }

  .news-stack {
    max-width: 80rem;
    margin-inline: auto;
  }

  .news-card {
    position: sticky;
    top: 6rem;
    display: grid;
    grid-template-columns: 1fr;
    text-decoration: none;
    width: 100%;
    min-height: 580px;
    margin-bottom: 6rem;
    border-radius: 2.5rem;
    overflow: hidden;
    background: var(--dot-light);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.18);
    transition: transform 0.3s var(--ease-out);
  }
  .news-card:hover {
    transform: translateY(-4px);
  }

  .news-card-media {
    position: relative;
    width: 100%;
    min-height: 300px;
    overflow: hidden;
  }
  .news-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  .news-card:hover .news-card-media img {
    transform: scale(1.05);
  }

  .news-card-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2.5rem;
    color: var(--dot-dark);
  }

  .news-card-date {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--dot-moss);
    margin-bottom: 1rem;
  }
  .news-card-body h3 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.875rem, 3.2vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--dot-dark);
  }

  /* Descripción pegada debajo del título (no junto al CTA) — el bloque de abajo queda
     libre para que el botón "Leer artículo completo" ocupe todo ese ancho. */
  .news-card-excerpt {
    margin-top: 0.75rem;
    font-size: calc(var(--text-sm) * 1.44);
    line-height: 1.6;
    color: color-mix(in srgb, var(--dot-dark) 65%, transparent);
  }

  .news-card-bottom {
    padding-top: 1.5rem;
  }

  .news-card-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1.25rem;
    background: color-mix(in srgb, var(--dot-dark) 6%, var(--dot-light) 94%);
    border: 1px solid color-mix(in srgb, var(--dot-dark) 12%, transparent);
    border-radius: 1rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--dot-dark);
    transition: border-color var(--transition-fast);
  }
  .news-card:hover .news-card-cta {
    border-color: var(--card-accent);
  }
  .news-card-cta .arrow {
    color: var(--card-accent);
    transition: transform var(--transition-fast);
  }
  .news-card:hover .news-card-cta .arrow {
    transform: translateX(4px);
  }

  @media (min-width: 1024px) {
    .news-card {
      grid-template-columns: repeat(2, 1fr);
      min-height: 640px;
    }
    .news-card-media {
      min-height: 640px;
    }
    .news-card-body {
      padding: 3.5rem;
    }
  }

  /* Última card del stack — sin foto (una sola columna siempre), invertida respecto a las
     demás (oscura, no clara) con glow micelio permanente en el borde, no solo al hover. */
  .news-card--cta {
    grid-template-columns: 1fr !important;
    min-height: 0 !important;
    background: var(--dot-dark) !important;
    border: 2px solid var(--dot-micelio);
    box-shadow: 0 0 50px color-mix(in srgb, var(--dot-micelio) 35%, transparent);
  }
  .news-card--cta .news-card-body {
    justify-content: center;
    gap: 1.5rem;
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }
  .news-card--cta .news-card-top h3 {
    color: var(--dot-micelio) !important;
  }
  .news-card--cta .news-card-bottom {
    display: flex;
    justify-content: center;
    padding-top: 0;
  }
  .news-card--cta .news-card-excerpt {
    color: color-mix(in srgb, var(--dot-light) 85%, transparent) !important;
  }
  .news-card--cta .news-card-cta {
    justify-content: center;
    width: fit-content;
    background: var(--dot-micelio) !important;
    border-color: var(--dot-micelio) !important;
    color: var(--dot-dark) !important;
  }
  .news-card--cta .news-card-cta .arrow {
    color: var(--dot-dark) !important;
  }
</style>
