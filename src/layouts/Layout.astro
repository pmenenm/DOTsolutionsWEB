---
// src/layouts/Layout.astro
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  lang: 'es' | 'en';
  path: string;
  image?: string;
  /** Oculta el Footer compartido — usado cuando la página trae su propio
      cierre (ej. ContactFooter, que combina CTA + footer en una pieza). */
  hideFooter?: boolean;
}

const { title, description, lang, path, image, hideFooter = false } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <!-- Desactiva el scroll restoration nativo del navegador: sin esto, al recargar (F5) el
         navegador restaura scrollY ANTES de que Lenis/ScrollTrigger terminen de calcular los
         pines de la página, dejando secciones pinneadas en un estado intermedio. -->
    <script is:inline>
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    </script>

    <BaseHead title={title} description={description} lang={lang} path={path} image={image} />

    <ClientRouter />
  </head>

  <body>
    <Header lang={lang} path={path} />

    <div id="smooth-wrapper">
      <div id="smooth-content">
        <main>
          <slot />
        </main>
        {!hideFooter && <Footer lang={lang} />}
      </div>
    </div>

    <!-- Botón flotante "volver arriba" — vive en el layout compartido, así
         que aparece en todas las páginas. Se posiciona pegado al borde
         izquierdo real del viewport (fuera del margen lateral del contenido,
         que en desktop es --container-pad = 10rem), no alineado con el
         contenido. Aparece recién pasado cierto scroll (ver script). -->
    <button type="button" class="back-to-top" data-back-to-top aria-label="Volver arriba">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <!-- Motor de movimiento global — Lenis + GSAP -->
    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // La barra de URL móvil cambia el alto del viewport al scrollear — sin esto, cada
      // cambio dispara un refresh que rompe pins/scrubs.
      ScrollTrigger.config({ ignoreMobileResize: true });

      let lenis: InstanceType<typeof Lenis> | undefined;
      let rafCallback: ((time: number) => void) | undefined;
      let refreshHandler: (() => void) | undefined;
      let backToTopClick: (() => void) | undefined;
      let backToTopEl: HTMLButtonElement | null = null;

      function init() {
        window.scrollTo(0, 0);

        lenis = new Lenis({
          duration: 1.2,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          smoothWheel: true,
        });

        lenis.on('scroll', ScrollTrigger.update);

        // Botón "volver arriba": visible recién pasado cierto scroll, y usa
        // el mismo Lenis para el scroll suave (no el nativo, que Lenis ya
        // intercepta). Se re-consulta el nodo en cada `init()` (corre de
        // nuevo en cada navegación) y se saca el listener anterior con la
        // MISMA referencia guardada en scope de módulo — si sólo se creara
        // una función nueva cada vez, removeEventListener no podría sacar
        // la anterior y se irían acumulando clicks duplicados.
        backToTopEl = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
        if (backToTopEl) {
          if (backToTopClick) backToTopEl.removeEventListener('click', backToTopClick);
          backToTopClick = () => lenis?.scrollTo(0, { duration: 1.2 });
          backToTopEl.addEventListener('click', backToTopClick);
          backToTopEl.classList.toggle('is-visible', window.scrollY > 400);
          lenis.on('scroll', (e: { scroll: number }) => {
            backToTopEl?.classList.toggle('is-visible', e.scroll > 400);
          });
        }

        refreshHandler = () => lenis?.resize();
        ScrollTrigger.addEventListener('refresh', refreshHandler);

        // Las fuentes de Google Fonts cargan async y pueden reflowear texto
        // (alturas de sección distintas) después de que ScrollTrigger ya
        // midió las posiciones de start/end de cada trigger — eso deja los
        // triggers (ej. los curve swipes con scrub) calculados contra un
        // layout viejo, causando saltos o que el efecto corte antes/después
        // de lo esperado. Recalculamos apenas las fuentes terminan de cargar,
        // y volvemos a fijar scroll 0 por si el "scroll anchoring" del
        // navegador reajustó la posición durante ese reflow.
        document.fonts?.ready.then(() => {
          ScrollTrigger.refresh();
          window.scrollTo(0, 0);
          lenis?.scrollTo(0, { immediate: true });
        });

        rafCallback = (time: number) => {
          lenis!.raf(time * 1000);
        };
        gsap.ticker.add(rafCallback);
        gsap.ticker.lagSmoothing(0);

        // Reveal genérico: cualquier elemento con [data-reveal] entra con fade-up
        // al cruzar el viewport. prefers-reduced-motion ya desactiva las
        // transiciones CSS vía theme.css; acá evitamos además animar con GSAP.
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const targets = gsap.utils.toArray<HTMLElement>('[data-reveal]');
        if (prefersReducedMotion) {
          targets.forEach((el) => el.style.removeProperty('opacity'));
        } else {
          targets.forEach((el) => {
            gsap.fromTo(
              el,
              { opacity: 0, y: 24 },
              {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: 'power3.out',
                scrollTrigger: {
                  trigger: el,
                  start: 'top 85%',
                  once: true,
                },
              }
            );
          });
        }
      }

      document.addEventListener('astro:before-swap', () => {
        lenis?.destroy();
        if (rafCallback) {
          gsap.ticker.remove(rafCallback);
          rafCallback = undefined;
        }
        if (refreshHandler) {
          ScrollTrigger.removeEventListener('refresh', refreshHandler);
          refreshHandler = undefined;
        }
        ScrollTrigger.killAll();
      });

      document.addEventListener('astro:page-load', init);
    </script>

    <style>
      .back-to-top {
        position: fixed;
        left: 1.25rem;
        bottom: 1.5rem;
        z-index: var(--z-overlay);
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        padding: 0;
        border: 1px solid color-mix(in srgb, var(--dot-light) 15%, transparent);
        border-radius: 50%;
        background: color-mix(in srgb, var(--dot-dark) 85%, transparent);
        backdrop-filter: blur(8px);
        color: var(--dot-light);
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        transform: translateY(8px);
        transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out),
          border-color 0.3s var(--ease-out), visibility 0.3s;
      }
      .back-to-top.is-visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }
      .back-to-top:hover {
        border-color: var(--dot-micelio);
        color: var(--dot-micelio);
      }
      .back-to-top svg {
        width: 1.25rem;
        height: 1.25rem;
      }
    </style>
  </body>
</html>
