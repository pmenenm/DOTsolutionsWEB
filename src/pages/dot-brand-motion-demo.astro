---
// src/pages/dot-brand-motion-demo.astro
// Página de preview aislada para DotBrandMotion — NO usa el Layout del sitio
// a propósito: el reset de Tailwind (preflight) sólo debe aplicar acá, nunca
// filtrarse al Header/Footer/resto de páginas que usan el sistema de diseño
// vanilla de theme.css.
import DotBrandMotion from '../components/DotBrandMotion.jsx';
import '../styles/tailwind.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>DotBrandMotion — preview</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&display=swap" rel="stylesheet" />
  </head>
  <body class="flex min-h-screen items-center justify-center bg-[#EBE9E3] p-8">
    <DotBrandMotion client:load />
  </body>
</html>
