---
import ClientLogos from './ClientLogos.astro';

interface Props {
  eyebrow: string;
  title1: string;
  title2: string;
  title3: string;
  subtitle: string;
  cta: string;
  ctaHref: string;
  ctaSecondary: string;
  ctaSecondaryHref: string;
  capabilities: string[];
  clientsTitle?: string;
}

const {
  eyebrow,
  title1,
  title2,
  title3,
  subtitle,
  cta,
  ctaHref,
  ctaSecondary,
  ctaSecondaryHref,
  capabilities,
  clientsTitle,
} = Astro.props;
---

<div class="hero">
  <!-- Fondo eliminado a propósito: esta sección vive dentro de <HeroReveal>
       (ver Home.astro), que provee UNA sola imagen (hero2) desde el borde
       superior de la página. -->

  <!-- Tarjeta única — sin ventana, ocupa más ancho. -->
  <div class="hero-card">
    <div class="eyebrow">
      <span class="dot"></span>
      {eyebrow}
    </div>

    <h1>
      <span class="line-mask"><span class="line-inner line-1">{title1}</span></span>
      <span class="line-mask"><span class="line-inner line-2">{title2}</span></span>
      <span class="line-mask"><span class="line-inner line-3 hl">{title3}</span></span>
    </h1>

    <p class="subtitle">{subtitle}</p>

    <div class="actions">
      <a href={ctaHref} class="primary">{cta}</a>
      <a href={ctaSecondaryHref} class="ghost">
        {ctaSecondary}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <ul class="capabilities">
      {capabilities.map((c) => (
        <li>{c}</li>
      ))}
    </ul>

    {clientsTitle && (
      <div class="hero-logos" data-reveal>
        <p class="hero-logos-label">{clientsTitle}</p>
        <ClientLogos compact />
      </div>
    )}
  </div>
</div>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding-block: 7rem 3rem;
    padding-inline: var(--container-pad);
    overflow-x: hidden;
    box-sizing: border-box;
  }

  /* Tarjeta única — Dark Frosted Glass, más ancha (usa el mismo tope que el
     resto del sitio, --container-max) para ocupar más espacio a los costados. */
  .hero-card {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    background: color-mix(in srgb, var(--dot-dark) 45%, transparent);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
    border: 1px solid color-mix(in srgb, var(--dot-dark) 60%, transparent);
    border-radius: var(--radius-sm);
    padding: clamp(2rem, 5vw, 3.5rem);
    color: var(--text-primary);
    box-shadow: 0 25px 50px -12px color-mix(in srgb, var(--dot-dark) 65%, transparent);
    box-sizing: border-box;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--dot-light) 10%, transparent);
    color: var(--text-primary);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  @media (min-width: 768px) {
    .eyebrow {
      font-size: 0.6875rem;
    }
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--dot-micelio);
  }

  /* font-size unificado con el resto de los h1 del sitio (IndustryHero,
     PageHero, ContactHero, ProductHero, BlogPost) — mismo clamp en los 7,
     ver notas en cada archivo. */
  h1 {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    max-width: 32ch;
  }

  /* Hard-Edge Mask Reveal — mismo mecanismo que el resto del sitio, sin JS. */
  .line-mask {
    display: block;
    overflow: hidden;
    margin-bottom: -0.15em;
  }
  .line-inner {
    display: inline-block;
    padding-bottom: 0.15em;
    transform: translateY(100%);
    animation: hero-line-reveal 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes hero-line-reveal {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0%);
    }
  }
  .line-1 {
    font-weight: 600;
    animation-delay: 0.15s;
  }
  .line-2 {
    animation-delay: 0.3s;
  }
  .line-3 {
    animation-delay: 0.45s;
  }

  .hl {
    color: var(--dot-micelio);
  }

  .subtitle {
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.625;
    color: var(--text-secondary);
    max-width: 48ch;
  }
  @media (min-width: 768px) {
    .subtitle {
      font-size: 1.0625rem;
    }
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.75rem;
  }
  .primary {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    border-radius: var(--radius-full);
    background: var(--dot-micelio);
    color: var(--dot-dark);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    box-shadow: 0 8px 20px -4px color-mix(in srgb, var(--dot-dark) 45%, transparent);
    transition: background var(--transition-fast), transform var(--transition-fast);
  }
  .primary:hover {
    background: var(--accent-hover);
    transform: scale(1.05);
  }
  .primary:active {
    transform: scale(0.97);
  }
  .ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, var(--dot-light) 30%, transparent);
    color: var(--text-primary);
    font-weight: 500;
    font-size: 0.875rem;
    text-decoration: none;
    transition: background var(--transition-fast);
  }
  .ghost:hover {
    background: color-mix(in srgb, var(--dot-light) 10%, transparent);
  }

  .capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-top: 1.75rem;
  }
  .capabilities li {
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--dot-light) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--dot-light) 10%, transparent);
    font-size: var(--text-xs);
    font-weight: 500;
    color: color-mix(in srgb, var(--dot-light) 90%, transparent);
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .capabilities li:hover {
    background: var(--dot-micelio);
    color: var(--dot-dark);
  }

  /* Franja de logos — vive DENTRO de la misma casilla de vidrio esmerilado
     (.hero-card), en su parte inferior, separada por un divisor sutil en
     vez de tener su propio fondo/blur. */
  .hero-logos {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--dot-light) 12%, transparent);
  }
  @media (min-width: 768px) {
    .hero-logos {
      margin-top: 2.25rem;
    }
  }
  /* La franja de logos ya vive dentro del hero, sobre el pliegue en
     cualquier tamaño de pantalla — no tiene sentido esperar el fade-in por
     scroll de [data-reveal] (Layout.astro) para algo que ya está a la
     vista al entrar a la página. !important porque ese fade-in fija
     opacity/transform inline vía GSAP. ClientLogos.astro trae SU PROPIO
     [data-reveal] en la <section> raíz que renderiza (independiente de
     este .hero-logos que lo envuelve) — sin neutralizar ESE también, el
     marquee seguía esperando el scroll aunque el wrapper ya estuviera
     visible; :global() porque .client-logos vive en el componente hijo,
     fuera del scope de este <style>. */
  .hero-logos {
    opacity: 1 !important;
    transform: none !important;
  }
  .hero-logos :global(.client-logos) {
    opacity: 1 !important;
    transform: none !important;
  }

  .hero-logos-label {
    margin-bottom: 0.75rem;
    font-size: var(--text-xs);
    font-weight: 600;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }
</style>
