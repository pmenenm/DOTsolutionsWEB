---
interface Props {
  eyebrow: string;
  title1: string;
  title2: string;
  title3: string;
  subtitle: string;
  cta: string;
  ctaHref: string;
  ctaSecondary: string;
  ctaSecondaryHref: string;
  capabilities: string[];
}

const { eyebrow, title1, title2, title3, subtitle, cta, ctaHref, ctaSecondary, ctaSecondaryHref, capabilities } =
  Astro.props;
---

<section class="hero">
  <img class="hero-bg" src="/images/hero.png" alt="" />
  <div class="hero-overlay"></div>

  <div class="container hero-content">
    <p class="eyebrow hero-fade">
      <span class="dot"></span>
      {eyebrow}
    </p>
    <h1>
      <span class="line-mask"><span class="line-inner line-1"><span class="sap-glow">{title1}</span></span></span>
      <span class="line-mask"><span class="line-inner line-2">{title2}</span></span>
      <span class="line-mask"><span class="line-inner line-3 hl">{title3}</span></span>
    </h1>
    <p class="subtitle hero-fade hero-fade-subtitle">{subtitle}</p>

    <div class="actions hero-fade hero-fade-actions">
      <a href={ctaHref} class="primary">{cta}</a>
      <a href={ctaSecondaryHref} class="ghost">
        {ctaSecondary}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <ul class="capabilities">
      {capabilities.map((c, i) => (
        <li class="hero-fade" style={`animation-delay: ${(1.9 + i * 0.08).toFixed(2)}s`}>{c}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--dot-dark);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
    /* Zoom base más cerrado (cubre más encuadre) + zoom lento en loop
       encima para dar dinamismo al fondo estático. */
    animation: hero-bg-zoom 22s ease-in-out infinite;
  }

  @keyframes hero-bg-zoom {
    0%,
    100% {
      transform: scale(1.12);
    }
    50% {
      transform: scale(1.24);
    }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, color-mix(in srgb, var(--dot-dark) 60%, transparent) 0%, var(--dot-dark) 92%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding-block: var(--space-hero) var(--space-lg);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: calc(var(--text-sm) * 0.8);
    font-weight: 500;
    color: var(--accent-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-sm);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  h1 {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.8rem, 4.8vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    max-width: 24ch;
  }

  /* Pausa inicial de 1s: el fondo se ve solo, sin nada del Hero, antes de
     que arranque el reveal — le da dinamismo a la entrada. Todos los
     delays de abajo (líneas del título, encendido, eyebrow/subtitle/
     actions/capabilities) parten de esta base de 1s. */

  /* Hard-Edge Mask Reveal: cada línea vive en una máscara con overflow
     oculto; el texto entra en un corte sólido y limpio (sin opacity) desde
     translateY(100%) a 0%, con un easing de encaje largo y controlado y un
     stagger estricto entre líneas — sin JS, puro CSS para que corra siempre
     al cargar, sin depender de ningún trigger externo. */
  .line-mask {
    display: block;
    overflow: hidden;
    margin-bottom: -0.2em;
  }
  .line-inner {
    display: inline-block;
    padding-bottom: 0.2em;
    transform: translateY(100%);
    animation: hero-line-reveal 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes hero-line-reveal {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0%);
    }
  }
  .line-1 {
    animation-delay: 1s;
  }
  .line-2 {
    animation-delay: 1.175s;
  }
  .line-3 {
    animation-delay: 1.35s;
  }

  .sap-glow {
    display: inline-block;
    color: var(--dot-light);
  }

  .hl {
    color: var(--accent);
  }

  /* Resto del contenido del Hero: mismo principio que el título (puro CSS,
     sin GSAP/JS) — fade + slide-up, encadenado después de la pausa inicial
     de 1s y del reveal del título. */
  .hero-fade {
    opacity: 0;
    transform: translateY(24px);
    animation: hero-fade-up 0.7s var(--ease-out) forwards;
  }
  @keyframes hero-fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .eyebrow.hero-fade {
    animation-delay: 1s;
  }
  .hero-fade-subtitle {
    animation-delay: 1.6s;
  }
  .hero-fade-actions {
    animation-delay: 1.75s;
  }
  .capabilities li.hero-fade {
    animation-duration: 0.6s;
  }

  .subtitle {
    margin-top: var(--space-md);
    font-size: calc(var(--text-lg) * 0.8);
    font-weight: 300;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 60ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }
  .primary {
    background: var(--accent);
    color: var(--on-accent);
    text-decoration: none;
    font-size: calc(var(--text-base) * 0.8);
    font-weight: 500;
    padding: 0.9rem 2rem;
    border-radius: var(--radius-full);
    transition: background var(--transition-fast), transform var(--transition-fast);
  }
  .primary:hover {
    background: var(--accent-hover);
    transform: scale(1.03);
  }
  .ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-primary);
    text-decoration: none;
    font-size: calc(var(--text-base) * 0.8);
    font-weight: 500;
    padding: 0.9rem 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }
  .ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .ghost .arrow {
    transition: transform var(--transition-fast);
  }
  .ghost:hover .arrow {
    transform: translateX(3px);
  }

  .capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    list-style: none;
    padding: 0;
    margin-top: var(--space-lg);
  }
  .capabilities li {
    font-size: calc(var(--text-sm) * 0.8);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: 0.4rem 1rem;
  }
</style>
