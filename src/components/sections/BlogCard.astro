---
// src/components/sections/BlogCard.astro
// Card de post reutilizada en el listado /blog — cada categoría tiene su
// propio color de la paleta de marca (ERP=micelio, Retail=moss,
// Cumplimiento/Compliance=sage), aplicado tanto al badge como a un velo de
// color sobre la foto de portada: un sistema de codificación por color,
// no decoración al azar.
import { withBase } from '../../utils/paths';
import { formatBlogDate, categoryColor } from '../../utils/blog';

interface Post {
  slug: string;
  category: string;
  date: string;
  title: string;
  excerpt: string;
}

interface Props {
  post: Post;
  href: string;
  readMore: string;
  lang: 'es' | 'en';
  featured?: boolean;
}

const { post, href, readMore, lang, featured = false } = Astro.props;
const color = categoryColor(post.category);
---

<a href={href} class:list={['blog-card', { featured }]} data-reveal style={`--card-accent: ${color}`}>
  <div class="blog-card-media">
    <img src={withBase(`/blog/${post.slug}.jpg`)} alt="" loading={featured ? 'eager' : 'lazy'} />
    <div class="blog-card-veil" aria-hidden="true"></div>
    <span class="blog-card-badge">
      <span class="dot"></span>
      {post.category}
    </span>
  </div>
  <div class="blog-card-body">
    <time datetime={post.date}>{formatBlogDate(post.date, lang)}</time>
    <h3>{post.title}</h3>
    <p>{post.excerpt}</p>
    <span class="blog-card-more">
      {readMore}
      <span class="arrow" aria-hidden="true">→</span>
    </span>
  </div>
</a>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: color-mix(in srgb, var(--dot-light) 4%, transparent);
    border: 1px solid color-mix(in srgb, var(--dot-light) 10%, transparent);
    overflow: hidden;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }
  .blog-card:hover {
    border-color: var(--card-accent);
    transform: translateY(-4px);
  }

  .blog-card-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .blog-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  .blog-card:hover .blog-card-media img {
    transform: scale(1.05);
  }
  .blog-card-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--card-accent) 35%, transparent) 0%,
      transparent 45%,
      color-mix(in srgb, var(--dot-dark) 85%, transparent) 100%
    );
    mix-blend-mode: hard-light;
  }
  .blog-card-badge {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    background: color-mix(in srgb, var(--dot-dark) 55%, transparent);
    backdrop-filter: blur(12px);
    border: 1px solid color-mix(in srgb, var(--dot-light) 20%, transparent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-primary);
  }
  .blog-card-badge .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--card-accent);
  }

  .blog-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-md);
  }
  .blog-card-body time {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-secondary);
    text-transform: capitalize;
  }
  .blog-card-body h3 {
    margin-top: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-lg);
    line-height: 1.3;
    color: var(--text-primary);
  }
  .blog-card-body p {
    margin-top: 0.6rem;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-card-more {
    margin-top: auto;
    padding-top: var(--space-sm);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--card-accent);
  }
  .blog-card-more .arrow {
    transition: transform var(--transition-fast);
  }
  .blog-card:hover .blog-card-more .arrow {
    transform: translateX(4px);
  }

  /* Card destacada (la más reciente) — horizontal en desktop, foto más
     grande, título más grande: se lee como la portada de la edición. */
  .blog-card.featured {
    grid-column: 1 / -1;
  }
  @media (min-width: 800px) {
    .blog-card.featured {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
    }
    .blog-card.featured .blog-card-media {
      aspect-ratio: auto;
      height: 100%;
    }
    .blog-card.featured .blog-card-body {
      justify-content: center;
      padding: clamp(1.5rem, 3vw, 3rem);
    }
    .blog-card.featured .blog-card-body h3 {
      font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    }
    .blog-card.featured .blog-card-body p {
      -webkit-line-clamp: 4;
      font-size: var(--text-base);
    }
  }
</style>
