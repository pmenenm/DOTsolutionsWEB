---
// src/components/sections/TeamGrid.astro
// "Las personas detrás de DOT" en formato scrollytelling horizontal — mismo mecanismo
// robusto que RetailPiecesScroll.astro (pin:true sobre el propio trigger, `end`/`x`
// calculados en vivo a partir de scrollWidth-innerWidth, gsap.matchMedia con fallback
// vertical en mobile, header pineado junto al riel para que el título no se pierda de
// pantalla). Solo se usa en Nosotros.astro, por eso vive rediseñado acá directo (no hace
// falta un componente aparte).
import { withBase } from '../../utils/paths';

interface Member {
  name: string;
  role: string;
}

interface Props {
  eyebrow: string;
  title: string;
  members: Member[];
}

const { eyebrow, title, members } = Astro.props;

// Orden 1:1 con about.team.members en los diccionarios de i18n.
const TEAM_FILES = [
  'hector-vera.jpg',
  'felipe-machuca.jpg',
  'manuel-villavicencio.jpg',
  'benjamin-belfus.jpg',
  'cristian-huerta.jpg',
  'juan-vasquez.jpg',
  'david-miranda.jpg',
  'luis-felipe.jpg',
];

const ACCENTS = ['var(--dot-micelio)', 'var(--dot-moss)', 'var(--dot-sage)', 'var(--dot-forest)'];

function initials(name: string) {
  return name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
}
---

<section class="team-hz" data-team-hz>
  <div class="team-hz-container" data-team-hz-container>
    <div class="team-hz-header container">
      <p class="team-hz-eyebrow">
        <span class="dot"></span>
        {eyebrow}
      </p>
      <h2 class="team-hz-title">{title}</h2>
    </div>

    <div class="team-hz-track" data-team-hz-track>
      {members.map((member, i) => (
        <article class="member-card" data-member-card style={`--card-accent: ${ACCENTS[i % ACCENTS.length]}`}>
          <span class="member-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="member-photo">
            {TEAM_FILES[i] ? (
              <img src={withBase(`/team/${TEAM_FILES[i]}`)} alt={member.name} loading="lazy" />
            ) : (
              <span class="member-fallback">{initials(member.name)}</span>
            )}
          </div>
          <p class="member-name">{member.name}</p>
          <p class="member-role">{member.role}</p>
        </article>
      ))}
    </div>

    <div class="team-hz-counter" data-team-hz-counter aria-hidden="true">
      <span data-team-hz-counter-current>01</span> / {String(members.length).padStart(2, '0')}
    </div>
    <div class="team-hz-progress" data-team-hz-progress aria-hidden="true">
      <div class="team-hz-progress-bar" data-team-hz-progress-bar></div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initTeamHorizontalScroll() {
    const section = document.querySelector<HTMLElement>('[data-team-hz]');
    const containerEl = document.querySelector<HTMLElement>('[data-team-hz-container]');
    const trackEl = document.querySelector<HTMLElement>('[data-team-hz-track]');
    const progressBar = document.querySelector<HTMLElement>('[data-team-hz-progress-bar]');
    const counterCurrent = document.querySelector<HTMLElement>('[data-team-hz-counter-current]');
    if (!section || !containerEl || !trackEl) return;

    const cards = gsap.utils.toArray<HTMLElement>('[data-member-card]', trackEl);
    const mm = gsap.matchMedia();

    mm.add('(min-width: 1025px)', () => {
      const tween = gsap.to(trackEl, {
        x: () => -(trackEl.scrollWidth - window.innerWidth),
        ease: 'none',
        scrollTrigger: {
          trigger: containerEl,
          pin: true,
          scrub: 0.6,
          start: 'top top',
          end: () => `+=${trackEl.scrollWidth - window.innerWidth}`,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            if (progressBar) progressBar.style.width = `${self.progress * 100}%`;
            if (counterCurrent) {
              const idx = Math.min(cards.length - 1, Math.floor(self.progress * cards.length));
              counterCurrent.textContent = String(idx + 1).padStart(2, '0');
            }
          },
        },
      });

      const cardTriggers = cards.map((card) =>
        gsap.fromTo(
          card,
          { opacity: 0.2, scale: 0.88, y: 40 },
          {
            opacity: 1,
            scale: 1,
            y: 0,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: card,
              containerAnimation: tween,
              start: 'left 92%',
              end: 'left 55%',
              scrub: true,
            },
          }
        )
      );

      return () => {
        tween.scrollTrigger?.kill();
        tween.kill();
        cardTriggers.forEach((t) => t.scrollTrigger?.kill());
        gsap.set(trackEl, { clearProps: 'transform' });
        gsap.set(cards, { clearProps: 'opacity,transform' });
        if (progressBar) progressBar.style.width = '0%';
        if (counterCurrent) counterCurrent.textContent = '01';
      };
    });

    mm.add('(max-width: 1024px)', () => () => {});

    document.addEventListener('astro:before-swap', () => mm.revert(), { once: true });
  }

  document.addEventListener('astro:page-load', initTeamHorizontalScroll);
</script>

<style>
  .team-hz {
    position: relative;
    padding-block: var(--space-xl) 0;
    overflow: hidden;
  }

  .team-hz-header {
    text-align: center;
    max-width: 46rem;
    margin-inline: auto;
    margin-bottom: var(--space-sm);
  }
  .team-hz-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--dot-micelio);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    justify-content: center;
    margin-bottom: var(--space-xs);
  }
  .team-hz-eyebrow .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--dot-micelio);
  }
  .team-hz-title {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  /* ---------- Mobile/tablet: grid vertical normal, sin pin ni transform. ---------- */
  .team-hz-container {
    padding-inline: var(--container-pad);
  }
  .team-hz-track {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    max-width: var(--container-max);
    margin-inline: auto;
  }
  .team-hz-counter,
  .team-hz-progress {
    display: none;
  }

  .member-card {
    position: relative;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--card-accent) 40%, transparent);
    border-radius: var(--radius-lg);
    text-align: center;
    transition: border-color 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }
  .member-card:hover {
    border-color: var(--card-accent);
    box-shadow: 0 0 28px color-mix(in srgb, var(--card-accent) 25%, transparent);
    transform: translateY(-4px);
  }

  .member-index {
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: color-mix(in srgb, var(--card-accent) 70%, transparent);
  }

  .member-photo {
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--dot-gray);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-sm);
  }
  .member-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(85%);
    transition: filter 0.4s var(--ease-out);
  }
  .member-card:hover .member-photo img {
    filter: grayscale(0%);
  }
  .member-fallback {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 500;
    color: var(--card-accent);
  }

  .member-name {
    font-weight: 600;
    color: var(--text-primary);
  }
  .member-role {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  /* ---------- Desktop (1025px+): filmstrip horizontal pineado. ---------- */
  @media (min-width: 1025px) {
    .team-hz-container {
      position: relative;
      height: 46rem;
      overflow: hidden;
      padding-inline: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      padding-top: 7rem;
      gap: 1.5rem;
    }
    .team-hz-header {
      flex-shrink: 0;
    }
    .team-hz-track {
      display: flex;
      flex-direction: row;
      align-items: center;
      height: 26rem;
      gap: 2rem;
      padding-inline: 6vw;
      max-width: none;
      margin-inline: 0;
      will-change: transform;
    }
    .member-card {
      flex-shrink: 0;
      width: min(17rem, 40vw);
      padding: 1.5rem;
    }
    .member-index {
      font-size: 0.8rem;
    }
    .member-photo {
      margin-bottom: var(--space-md);
    }
    .member-name {
      font-size: var(--text-lg);
    }

    .team-hz-counter {
      display: block;
      position: absolute;
      top: 1.5rem;
      right: 6vw;
      z-index: 5;
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      letter-spacing: 0.05em;
      color: color-mix(in srgb, var(--dot-light) 55%, transparent);
    }
    .team-hz-counter span {
      color: var(--dot-micelio);
      font-weight: 700;
    }
    .team-hz-progress {
      display: block;
      position: absolute;
      left: 6vw;
      right: 6vw;
      bottom: 1.5rem;
      z-index: 5;
      height: 2px;
      background: color-mix(in srgb, var(--dot-light) 12%, transparent);
    }
    .team-hz-progress-bar {
      height: 100%;
      width: 0%;
      background: var(--dot-micelio);
      box-shadow: 0 0 10px color-mix(in srgb, var(--dot-micelio) 70%, transparent);
      transition: width 0.1s linear;
    }
  }
</style>
