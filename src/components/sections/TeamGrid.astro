---
// src/components/sections/TeamGrid.astro
// "Las personas detrás de DOT" en formato scrollytelling horizontal — mismo mecanismo
// robusto que RetailPiecesScroll.astro (pin:true sobre el propio trigger, `end`/`x`
// calculados en vivo a partir de scrollWidth-innerWidth, gsap.matchMedia con fallback
// vertical en mobile, header pineado junto al riel para que el título no se pierda de
// pantalla). Solo se usa en Nosotros.astro, por eso vive rediseñado acá directo (no hace
// falta un componente aparte).
import { withBase } from '../../utils/paths';

interface Member {
  name: string;
  role: string;
}

interface Props {
  eyebrow: string;
  title: string;
  members: Member[];
  /** Encabezado del primer grupo (las primeras 4 cards — liderazgo ejecutivo). */
  leadershipLabel: string;
  /** Encabezado del segundo grupo (las siguientes 4 cards — gerencias de área). */
  managementLabel: string;
}

const { eyebrow, title, members, leadershipLabel, managementLabel } = Astro.props;

// Orden 1:1 con about.team.members en los diccionarios de i18n.
const TEAM_FILES = [
  'hector-vera.jpg',
  'felipe-machuca.jpg',
  'manuel-villavicencio.jpg',
  'benjamin-belfus.jpg',
  'cristian-huerta.jpg',
  'juan-vasquez.jpg',
  'david-miranda.jpg',
  'luis-felipe.jpg',
];

// Mismo orden 1:1 — perfil de LinkedIn de cada persona.
const LINKEDIN_URLS = [
  'https://www.linkedin.com/in/hector-vera-velarde-416a0639/',
  'https://www.linkedin.com/in/felipe-ignacio-machuca-a-7640a6112/',
  'https://www.linkedin.com/in/manuel-villavicencio-ram%C3%ADre-00236214/',
  'https://www.linkedin.com/in/benjamin-belfus/',
  'https://www.linkedin.com/in/cristian-andres-huerta-caro-45754948/',
  'https://www.linkedin.com/in/juan-eduardo-v%C3%A1squez-moraga-22101849/',
  'https://www.linkedin.com/in/david-miranda-atenas/',
  'https://www.linkedin.com/in/lfmolina5/',
];

const ACCENTS = ['var(--dot-micelio)', 'var(--dot-moss)', 'var(--dot-sage)', 'var(--dot-forest)'];

function initials(name: string) {
  return name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
}
---

<section class="team-hz" data-team-hz style={`--team-bg-image: url(${withBase('/images/hero2.jpg')})`}>
  <div class="team-hz-container" data-team-hz-container>
    <div class="team-hz-header container">
      <p class="team-hz-eyebrow">
        <span class="dot"></span>
        {eyebrow}
      </p>
      <h2 class="team-hz-title">{title}</h2>
    </div>

    <div class="team-hz-track" data-team-hz-track>
      {members.map((member, i) => (
        <>
          {i === 0 && (
            <div class="team-divider" aria-hidden="true">
              <span class="team-divider-label">{leadershipLabel}</span>
            </div>
          )}
          {i === 4 && (
            <div class="team-divider" aria-hidden="true">
              <span class="team-divider-label">{managementLabel}</span>
            </div>
          )}
          <a
            class:list={['member-card', i < 4 ? 'member-card--lead' : 'member-card--manager']}
            data-member-card
            href={LINKEDIN_URLS[i]}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${member.name} — LinkedIn`}
            style={`--card-accent: ${ACCENTS[i % ACCENTS.length]}`}
          >
            <div class="member-photo">
              {TEAM_FILES[i] ? (
                <img src={withBase(`/team/${TEAM_FILES[i]}`)} alt={member.name} loading="lazy" />
              ) : (
                <span class="member-fallback">{initials(member.name)}</span>
              )}
            </div>
            <p class="member-name">{member.name}</p>
            <p class="member-role">{member.role}</p>
          </a>
        </>
      ))}
    </div>

    <div class="team-hz-counter" data-team-hz-counter aria-hidden="true">
      <span data-team-hz-counter-current>01</span> / {String(members.length).padStart(2, '0')}
    </div>
    <div class="team-hz-progress" data-team-hz-progress aria-hidden="true">
      <div class="team-hz-progress-bar" data-team-hz-progress-bar></div>
    </div>
  </div>

  <div class="member-cursor" data-member-cursor aria-hidden="true">
    <svg viewBox="0 0 24 24">
      <rect x="2" y="2" width="20" height="20" rx="3" fill="none" stroke="currentColor" stroke-width="1.6" />
      <path
        d="M7 10.5v6.5M7 7.2v.01M11.2 17v-4.3a2.3 2.3 0 0 1 4.6 0V17M11.2 10.5V17"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </div>
</section>
<!-- La lógica GSAP (pin del filmstrip + cursor de LinkedIn) vive en el
     <script> consolidado de Nosotros.astro, no acá — un <script> propio en
     este componente corría en un módulo aparte cuyo orden de ejecución
     relativo al resto de los pines de la página no era determinista, lo que
     hacía que este filmstrip se pineara demasiado temprano y quedara
     superpuesto con la sección anterior. Ver Nosotros.astro para el detalle. -->

<style>
  .team-hz {
    position: relative;
    padding-block: var(--space-xl) 0;
    overflow: hidden;
    background-image: var(--team-bg-image);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .team-hz-header {
    text-align: left;
    margin-bottom: var(--space-sm);
  }
  .team-hz-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--dot-micelio);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    justify-content: flex-start;
    margin-bottom: var(--space-xs);
  }
  .team-hz-eyebrow .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--dot-micelio);
  }
  .team-hz-title {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  /* ---------- Mobile/tablet: grid vertical normal, sin pin ni transform. ---------- */
  .team-hz-container {
    padding-inline: var(--container-pad);
  }
  .team-hz-track {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    max-width: var(--container-max);
    margin-inline: auto;
  }
  .team-hz-counter,
  .team-hz-progress {
    display: none;
  }

  .member-card {
    position: relative;
    display: block;
    padding: 1rem;
    background: #141414;
    border: 1px solid color-mix(in srgb, var(--card-accent) 40%, transparent);
    border-radius: var(--radius-lg);
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }
  .member-card:hover {
    border-color: var(--card-accent);
    box-shadow: 0 0 28px color-mix(in srgb, var(--card-accent) 25%, transparent);
    transform: translateY(-4px);
  }

  /* Cursor circular (Verde Micelio + LinkedIn) que sigue al mouse — sólo
     aparece con hover real (desktop, ver matchMedia en el script). */
  .member-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: var(--z-overlay);
    width: 3.5rem;
    height: 3.5rem;
    margin-top: -1.75rem;
    margin-left: -1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--dot-micelio);
    color: var(--dot-dark);
    box-shadow: 0 0 24px color-mix(in srgb, var(--dot-micelio) 55%, transparent);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: scale(0.6);
  }
  .member-cursor svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  @media (min-width: 1024px) and (hover: hover) {
    .member-card {
      cursor: none;
    }
  }

  /* Jerarquía: liderazgo (primeras 4 cards) queda con borde de acento
     permanente y nombre en mayor peso — visible incluso sin hover; gerencias
     (siguientes 4) usan el mismo trato neutro que antes, solo se destacan
     al pasar el mouse. La diferencia de tamaño de card completa el efecto
     en desktop (ver media query 1024px+ abajo). */
  .member-card--lead {
    border-color: color-mix(in srgb, var(--card-accent) 35%, transparent);
    background: color-mix(in srgb, var(--card-accent) 4%, #141414);
  }
  .member-card--lead .member-name {
    font-weight: 700;
  }

  /* Divisor de sección dentro del propio riel — reemplaza los números de
     card por un quiebre narrativo real: "Liderazgo" abre el filmstrip,
     "Gerencias" marca dónde empieza el segundo nivel. En mobile (grid) es
     una franja horizontal de ancho completo; en desktop (filmstrip) es una
     columna angosta con texto vertical, como un separador de capítulo. */
  .team-divider {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-block: var(--space-xs);
  }
  .team-divider::before,
  .team-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: color-mix(in srgb, var(--dot-light) 16%, transparent);
  }
  .team-divider-label {
    flex-shrink: 0;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dot-micelio);
  }

  .member-photo {
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--dot-gray);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-sm);
  }
  .member-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .member-fallback {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 500;
    color: var(--card-accent);
  }

  .member-name {
    font-weight: 600;
    color: var(--text-primary);
  }
  .member-role {
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--text-secondary);
    /* Reserva el alto de 2 líneas siempre — sin esto, un rol más largo que
       envuelve a 2 líneas (ej. "Gerente de Infraestructura") hace que esa
       card quede más alta que sus 3 pares del mismo grupo. */
    min-height: calc(1.4em * 2);
  }

  /* ---------- Desktop (1024px+): filmstrip horizontal pineado. ---------- */
  @media (min-width: 1024px) {
    .team-hz-container {
      position: relative;
      height: 46rem;
      overflow: hidden;
      padding-inline: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      padding-top: 7rem;
      gap: 1.5rem;
    }
    .team-hz-header {
      flex-shrink: 0;
    }
    .team-hz-track {
      display: flex;
      flex-direction: row;
      align-items: center;
      height: 26rem;
      gap: 2rem;
      padding-inline: 6vw;
      max-width: none;
      margin-inline: 0;
      will-change: transform;
    }
    .member-card {
      flex-shrink: 0;
      width: min(17rem, 40vw);
      padding: 1.5rem;
    }
    /* Liderazgo ocupa más espacio que gerencias — el tamaño de la card
       comunica jerarquía de un vistazo, sin depender solo del texto. */
    .member-card--lead {
      width: min(18.5rem, 42vw);
    }
    .member-card--manager {
      width: min(15rem, 36vw);
    }
    .member-photo {
      margin-bottom: var(--space-md);
    }
    .member-name {
      font-size: var(--text-lg);
    }

    /* El divisor pasa de franja horizontal (mobile) a columna angosta con
       texto vertical — un quiebre de capítulo dentro del propio filmstrip. */
    .team-divider {
      flex-direction: column;
      flex-shrink: 0;
      align-self: stretch;
      width: 2.5rem;
      margin-block: 0;
    }
    .team-divider::before,
    .team-divider::after {
      width: 1px;
      height: auto;
    }
    .team-divider-label {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      white-space: nowrap;
    }

    .team-hz-counter {
      display: block;
      position: absolute;
      top: 1.5rem;
      right: 6vw;
      z-index: 5;
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      letter-spacing: 0.05em;
      color: color-mix(in srgb, var(--dot-light) 55%, transparent);
    }
    .team-hz-counter span {
      color: var(--dot-micelio);
      font-weight: 700;
    }
    .team-hz-progress {
      display: block;
      position: absolute;
      left: 6vw;
      right: 6vw;
      bottom: 1.5rem;
      z-index: 5;
      height: 2px;
      background: color-mix(in srgb, var(--dot-light) 12%, transparent);
    }
    .team-hz-progress-bar {
      height: 100%;
      width: 0%;
      background: var(--dot-micelio);
      box-shadow: 0 0 10px color-mix(in srgb, var(--dot-micelio) 70%, transparent);
      transition: width 0.1s linear;
    }
  }

  /* --space-xl (128px) de aire arriba se siente correcto en el filmstrip
     desktop, pero en mobile (grid vertical normal) es un cuarto de pantalla
     de padding vacío antes del título. */
  @media (max-width: 640px) {
    .team-hz {
      padding-block: var(--space-lg) 0;
    }
  }
</style>
