---
// src/components/sections/ProductHorizontalScroll.astro
// Riel horizontal pineado genérico — misma mecánica que SapHorizontalScroll.astro
// (GSAP ScrollTrigger + matchMedia, pin+scrub, pausa entre paneles, barra de
// progreso con marcas), pero sin paneles hardcodeados: la página que lo usa pasa
// sus propios `<section class="h-panel">` vía slot (cualquier cantidad), y cada
// uno puede llevar `data-h-reveal` en su contenido para el fade/scale de entrada.
// SapBusinessOne.astro NO usa este componente — se deja intacto a propósito.
---

<div class="h-scroll-container" data-h-container>
  <div class="h-scroll-track" data-h-track>
    <slot />
  </div>

  <div class="h-scroll-progress" data-h-progress aria-hidden="true">
    <div class="h-scroll-progress-bar" data-h-progress-bar></div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initHorizontalScrolls() {
    const mms: gsap.MatchMedia[] = [];

    document.querySelectorAll<HTMLElement>('[data-h-container]').forEach((containerEl) => {
      const trackEl = containerEl.querySelector<HTMLElement>('[data-h-track]');
      const progressWrap = containerEl.querySelector<HTMLElement>('[data-h-progress]');
      const progressBar = containerEl.querySelector<HTMLElement>('[data-h-progress-bar]');
      if (!trackEl) return;

      const mm = gsap.matchMedia();
      mms.push(mm);

      // Desktop (>1024px): scroll vertical hijackeado -> desplazamiento horizontal,
      // con una pausa entre cada panel (ver SapHorizontalScroll.astro para el
      // detalle de por qué HOLD_RATIO existe).
      mm.add('(min-width: 1025px)', () => {
        const panels = gsap.utils.toArray<HTMLElement>('.h-panel', trackEl);
        if (progressWrap) progressWrap.style.setProperty('--h-tick-count', String(panels.length));

        const HOLD_RATIO = 1.3;
        const totalScroll = () => {
          const moveDistance = trackEl.scrollWidth - window.innerWidth;
          const transitions = Math.max(panels.length - 1, 1);
          const totalDuration = transitions + (transitions + 1) * HOLD_RATIO;
          return moveDistance * (totalDuration / transitions);
        };

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: containerEl,
            pin: true,
            scrub: 1,
            start: 'top top',
            end: () => `+=${totalScroll()}`,
            invalidateOnRefresh: true,
            onUpdate: (self) => {
              if (progressBar) progressBar.style.width = `${self.progress * 100}%`;
            },
          },
        });

        tl.to(trackEl, { x: '+=0', ease: 'none', duration: HOLD_RATIO });
        panels.slice(1).forEach((panel) => {
          tl.to(trackEl, { x: () => -panel.offsetLeft, ease: 'power1.inOut', duration: 1 });
          tl.to(trackEl, { x: '+=0', ease: 'none', duration: HOLD_RATIO });
        });

        // Transición de entrada por panel — patrón oficial de GSAP para animar
        // contenido DENTRO de un contenedor con scroll horizontal.
        const revealEls = gsap.utils.toArray<HTMLElement>('[data-h-reveal]', containerEl);
        revealEls.forEach((el) => {
          gsap.fromTo(
            el,
            { opacity: 0, y: 56, scale: 0.92 },
            {
              opacity: 1,
              y: 0,
              scale: 1,
              ease: 'power2.out',
              scrollTrigger: {
                trigger: el,
                containerAnimation: tl,
                start: 'left 88%',
                end: 'left 42%',
                scrub: true,
              },
            }
          );
        });

        return () => {
          tl.scrollTrigger?.kill();
          tl.kill();
          gsap.set(trackEl, { clearProps: 'transform' });
          gsap.set(revealEls, { clearProps: 'opacity,transform' });
          if (progressBar) progressBar.style.width = '0%';
        };
      });

      // Mobile/tablet (≤1024px): layout vertical estándar, sin pin ni transform.
      mm.add('(max-width: 1024px)', () => () => {});
    });

    document.addEventListener(
      'astro:before-swap',
      () => mms.forEach((mm) => mm.revert()),
      { once: true }
    );
  }

  document.addEventListener('astro:page-load', initHorizontalScrolls);
</script>

<style>
  .h-scroll-container {
    position: relative;
  }

  /* ---------- Barra de progreso — marcas según la cantidad real de paneles
     (--h-tick-count la fija el JS al medir cuántos .h-panel hay). ---------- */
  .h-scroll-progress {
    position: fixed;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 4px;
    background: repeating-linear-gradient(
      90deg,
      color-mix(in srgb, var(--dot-light) 22%, transparent) 0,
      color-mix(in srgb, var(--dot-light) 22%, transparent) 1px,
      transparent 1px,
      transparent calc(100% / var(--h-tick-count, 4))
    ), color-mix(in srgb, var(--dot-light) 10%, transparent);
    z-index: var(--z-overlay);
  }
  .h-scroll-progress-bar {
    height: 100%;
    width: 0%;
    background: var(--dot-micelio);
    box-shadow: 0 0 14px color-mix(in srgb, var(--dot-micelio) 70%, transparent);
    transition: width 0.1s linear;
  }

  /* ---------- Desktop (1025px+): scroll horizontal pineado. `.h-panel` vive
     en la página que consume este componente (vía slot), así que se apunta
     con :global() — el scoping de Astro no cruza el límite del slot. ---------- */
  @media (min-width: 1025px) {
    .h-scroll-container {
      height: 100vh;
      overflow: hidden;
    }
    .h-scroll-track {
      display: flex;
      flex-direction: row;
      height: 100%;
      will-change: transform;
    }
    :global(.h-panel) {
      width: 100vw;
      height: 100%;
      flex-shrink: 0;
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: center;
      padding-inline: clamp(2rem, 4vw, 4rem);
      overflow: hidden;
    }
    :global([data-h-reveal]) {
      opacity: 0;
    }
  }

  /* ---------- Mobile/tablet (≤1024px): layout vertical estándar. ---------- */
  @media (max-width: 1024px) {
    .h-scroll-progress {
      display: none;
    }
    :global(.h-panel) {
      padding-block: var(--space-lg);
      padding-inline: var(--container-pad);
    }
  }
</style>
