---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="benefits" id="benefits-list">
  {items.map((item, i) => (
    <li style={`transition-delay: ${(i * 0.1).toFixed(2)}s`}>
      <span class="marker" aria-hidden="true"></span>
      <span>{item}</span>
    </li>
  ))}
</ul>

<script>
  function initBenefits() {
    const lists = document.querySelectorAll<HTMLElement>('.benefits');
    if (!lists.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.2 }
    );

    lists.forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        el.classList.add('is-visible');
      } else {
        observer.observe(el);
      }
    });
  }

  document.addEventListener('astro:page-load', initBenefits);
</script>

<style>
  .benefits {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: var(--content-max);
    display: flex;
    flex-direction: column;
  }
  .benefits li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding-block: var(--space-sm);
    border-top: 1px solid var(--border);
    font-size: var(--text-lg);
    font-weight: 300;
    color: var(--text-primary);
    line-height: 1.5;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
  }
  .benefits li:last-child {
    border-bottom: 1px solid var(--border);
  }
  .benefits.is-visible li {
    opacity: 1;
    transform: translateY(0);
  }

  .marker {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    margin-top: 0.6em;
    border-radius: 50%;
    background: var(--dot-micelio);
  }
</style>
