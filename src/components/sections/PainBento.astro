---
interface Item {
  title: string;
  desc: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="bento" id="pain-bento">
  {items.map((item, i) => (
    <article class="bento-card" style={`transition-delay: ${(i * 0.12).toFixed(2)}s`}>
      <h3>{item.title}</h3>
      <p>{item.desc}</p>
    </article>
  ))}
</div>

<script>
  function initBento() {
    const bentos = document.querySelectorAll<HTMLElement>('.bento');
    if (!bentos.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.15 }
    );

    bentos.forEach((bento) => {
      const rect = bento.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        bento.classList.add('is-visible');
      } else {
        observer.observe(bento);
      }
    });
  }

  document.addEventListener('astro:page-load', initBento);
</script>

<style>
  .bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .bento-card {
    position: relative;
    background: var(--dot-gray);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out),
      border-color 0.3s var(--ease-out), background 0.3s var(--ease-out);
  }
  .bento.is-visible .bento-card {
    opacity: 1;
    transform: translateY(0);
  }

  .bento-card:hover {
    border-color: color-mix(in srgb, var(--dot-micelio) 45%, transparent);
    background: color-mix(in srgb, var(--dot-gray) 85%, var(--dot-micelio) 15%);
  }
  .bento-card:hover::before {
    opacity: 1;
  }
  .bento-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--dot-micelio) 35%, transparent) inset;
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
    pointer-events: none;
  }

  .bento-card h3 {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: var(--text-xl);
    line-height: 1.3;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }
  .bento-card p {
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  @media (min-width: 900px) {
    .bento {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
    .bento-card:nth-child(1) {
      grid-column: span 2;
    }
    .bento-card:nth-child(2) {
      grid-column: span 1;
    }
    .bento-card:nth-child(3) {
      grid-column: span 1;
    }
    .bento-card:nth-child(4) {
      grid-column: span 2;
    }
  }
</style>
