---
interface Item {
  title: string;
  desc: string;
  icon?: string;
}

interface Props {
  items: Item[];
  /** Grilla uniforme 2x2 con alto fijo, en vez del bento asimétrico por
      defecto — para cuando el componente vive dentro de un panel de scroll
      horizontal (100vh) y no hay lugar para las cards grandes/chicas. */
  compact?: boolean;
}

const { items, compact = false } = Astro.props;

// Estos 4 puntos siguen casi siempre la misma narrativa (caos operativo ->
// datos desconectados -> decisiones a ciegas -> carga manual), así que un
// ícono por posición es una base coherente para cualquier página de
// producto; `item.icon` permite pisarlo con uno específico si el contenido
// de una página en particular lo necesita.
const DEFAULT_ICONS = [
  '<path d="M12 3 21 7.5 12 12 3 7.5 12 3Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 12 12 16.5 21 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 16.5 12 21 21 16.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>',
  '<path d="M20 12a8 8 0 0 1-8 8 8 8 0 0 1-6.32-3.09" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M4 12a8 8 0 0 1 8-8 8 8 0 0 1 6.32 3.09" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M20 4v5h-5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 20v-5h5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>',
  '<path d="M4 21V10M10 21V4M16 21v-7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 21h20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>',
  '<circle cx="12" cy="12" r="2.75" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M12 3v3M12 18v3M4.2 4.2l2.2 2.2M17.6 17.6l2.2 2.2M3 12h3M18 12h3M4.2 19.8l2.2-2.2M17.6 6.4l2.2-2.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>',
];
---

<div class:list={['bento', { 'bento--compact': compact }]} id="pain-bento">
  {items.map((item, i) => (
    <article class="bento-card" style={`transition-delay: ${(i * 0.12).toFixed(2)}s`}>
      <div class="bento-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" set:html={item.icon ?? DEFAULT_ICONS[i % DEFAULT_ICONS.length]} />
      </div>
      <h3>{item.title}</h3>
      <p>{item.desc}</p>
    </article>
  ))}
</div>

<script>
  function initBento() {
    const bentos = document.querySelectorAll<HTMLElement>('.bento');
    if (!bentos.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.15 }
    );

    bentos.forEach((bento) => {
      const rect = bento.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        bento.classList.add('is-visible');
      } else {
        observer.observe(bento);
      }
    });
  }

  document.addEventListener('astro:page-load', initBento);
</script>

<style>
  .bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  /* Cada card lleva un color de la paleta distinto como acento de fondo —
     4 identidades visuales en vez de un gris plano repetido 4 veces. */
  .bento-card:nth-child(1) {
    --card-accent: var(--dot-forest);
  }
  .bento-card:nth-child(2) {
    --card-accent: var(--dot-moss);
  }
  .bento-card:nth-child(3) {
    --card-accent: var(--dot-sage);
  }
  .bento-card:nth-child(4) {
    --card-accent: var(--dot-micelio);
  }

  /* Sin relleno a propósito — solo el borde con el color de la card, para
     que el brillo diagonal y el anillo de hover se luzcan sobre el fondo
     de la página en vez de competir con un fill de color. */
  .bento-card {
    position: relative;
    overflow: hidden;
    background: none;
    border: 1px solid color-mix(in srgb, var(--card-accent) 35%, transparent);
    padding: var(--space-md);
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s var(--ease-out), transform 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out);
  }
  .bento.is-visible .bento-card {
    opacity: 1;
    transform: translateY(0);
  }

  .bento-card:hover {
    border-color: color-mix(in srgb, var(--card-accent) 75%, transparent);
    transform: translateY(-6px);
  }
  .bento-card:hover::before {
    opacity: 1;
  }
  .bento-card::before {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--card-accent) 45%, transparent) inset;
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
    pointer-events: none;
  }

  /* Brillo diagonal que cruza la card al hover — el "factor wow" sin
     depender de JS, solo transición de posición. */
  .bento-card::after {
    content: '';
    position: absolute;
    top: -20%;
    left: -60%;
    width: 35%;
    height: 140%;
    background: linear-gradient(
      115deg,
      transparent,
      color-mix(in srgb, var(--card-accent) 25%, transparent),
      transparent
    );
    transform: skewX(-15deg);
    transition: left 0.7s var(--ease-out);
    pointer-events: none;
  }
  .bento-card:hover::after {
    left: 130%;
  }

  /* Ícono coherente con el contenido de cada card, en vez del número
     decorativo — suelto, sin contenedor, solo el trazo con el color de
     acento de la card. */
  .bento-icon {
    position: absolute;
    top: 0.5rem;
    right: 1rem;
    display: flex;
    color: var(--card-accent);
    transition: color 0.4s var(--ease-out);
  }
  .bento-icon svg {
    width: 2.25rem;
    height: 2.25rem;
  }
  .bento-card:hover .bento-icon {
    color: color-mix(in srgb, var(--card-accent) 80%, var(--dot-light) 20%);
  }

  .bento-card h3 {
    position: relative;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--dot-micelio);
    margin-bottom: 0.75rem;
    max-width: 22ch;
    padding-right: 3rem;
  }
  .bento-card p {
    position: relative;
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 42ch;
  }

  .bento-card:nth-child(2) h3,
  .bento-card:nth-child(3) h3 {
    font-size: clamp(1.375rem, 2.3vw, 1.75rem);
  }
  .bento-card:nth-child(2) p,
  .bento-card:nth-child(3) p {
    font-size: clamp(1.0625rem, 1.4vw, 1.125rem);
  }

  @media (min-width: 900px) {
    .bento {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
    .bento-card:nth-child(1) {
      grid-column: span 2;
    }
    .bento-card:nth-child(2) {
      grid-column: span 1;
    }
    .bento-card:nth-child(3) {
      grid-column: span 1;
    }
    .bento-card:nth-child(4) {
      grid-column: span 2;
    }
    /* Las cards anchas (span 2) llevan más peso tipográfico — el texto debe
       ocupar todo el espacio disponible de la card, no quedar angosto. */
    .bento-card:nth-child(1),
    .bento-card:nth-child(4) {
      padding: var(--space-lg);
    }
    .bento-card:nth-child(1) h3,
    .bento-card:nth-child(4) h3 {
      font-size: clamp(2.25rem, 4.2vw, 3.25rem);
      max-width: none;
      margin-bottom: 1.25rem;
    }
    .bento-card:nth-child(1) p,
    .bento-card:nth-child(4) p {
      font-size: clamp(1rem, 1.5vw, 1.25rem);
      line-height: 1.6;
      max-width: none;
    }
  }

  /* ---------- Variante compacta — panel de scroll horizontal (100vh): grilla
     uniforme 2x2 con alto fijo, texto normalizado (sin las cards grandes). ---------- */
  .bento--compact {
    gap: 0.85rem;
  }
  @media (min-width: 900px) {
    .bento--compact {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.85rem;
    }
    .bento--compact .bento-card:nth-child(1),
    .bento--compact .bento-card:nth-child(2),
    .bento--compact .bento-card:nth-child(3),
    .bento--compact .bento-card:nth-child(4) {
      grid-column: span 1;
      min-height: 150px;
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .bento--compact .bento-card:nth-child(1) h3,
    .bento--compact .bento-card:nth-child(2) h3,
    .bento--compact .bento-card:nth-child(3) h3,
    .bento--compact .bento-card:nth-child(4) h3 {
      font-size: 1.05rem;
      line-height: 1.3;
      margin-bottom: 0.4rem;
      padding-right: 2rem;
      max-width: none;
    }
    .bento--compact .bento-card:nth-child(1) p,
    .bento--compact .bento-card:nth-child(2) p,
    .bento--compact .bento-card:nth-child(3) p,
    .bento--compact .bento-card:nth-child(4) p {
      font-size: 0.825rem;
      line-height: 1.5;
      max-width: none;
    }
    .bento--compact .bento-icon {
      top: 0.35rem;
      right: 0.75rem;
    }
    .bento--compact .bento-icon svg {
      width: 1.5rem;
      height: 1.5rem;
    }
  }
</style>
