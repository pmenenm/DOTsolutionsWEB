---
interface Props {
  title?: string;
  /** Versión reducida para embeber en espacios chicos (ej. junto al
      formulario de /contacto) — sin .container, logos más pequeños. */
  compact?: boolean;
}

const { title, compact = false } = Astro.props;

const CLIENT_FILES = [
  '100-f-utbol', 'agronutrition', 'agrosystems', 'allnutrition', 'asics', 'beauty-plus',
  'bridgestone', 'bubba', 'calvin-klein', 'dbs-beauty-store', 'dulce-luna', 'eljapones',
  'ert', 'explora', 'family-shop', 'flores', 'frutexsa', 'groupe-seb', 'havanna', 'italmod',
  'la-mar', 'la-sanguchera-1', 'la-verita', 'lacoste', 'levis', 'lippi', 'lo-saldes',
  'lounge', 'margo-gourmet', 'osaka', 'pacel', 'panchita', 'porvenir', 'sendero', 'superzoo',
  'taglermaq', 'tanta', 'tarragona', 'terra', 'tommy-hilfiger', 'trail', 'varsovienne', 'wrangler',
];

const logos = CLIENT_FILES.map((file) => ({
  src: `/clients/${file}.png`,
  alt: file.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()),
}));

// Duplicamos la lista para el loop de marquee sin costuras.
const track = [...logos, ...logos];
---

<section class:list={['client-logos', { compact }]} data-reveal>
  <div class={compact ? 'compact-wrap' : 'container'}>
    {title && <p class="title">{title}</p>}
    <div class="marquee-wrap">
      <div class="marquee">
        <div class="marquee-track">
          {track.map((logo) => (
            <img src={logo.src} alt={logo.alt} loading="lazy" decoding="async" />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .client-logos {
    padding-block: var(--space-lg);
  }
  .client-logos.compact {
    padding-block: 0;
  }
  .compact-wrap {
    width: 100%;
  }
  .client-logos.compact .marquee-track {
    gap: var(--space-md);
    animation-duration: 34s;
  }
  .client-logos.compact .marquee-track img {
    height: 1.35rem;
  }
  .title {
    width: fit-content;
    margin-inline: auto;
    margin-bottom: var(--space-md);
    padding: 0.5rem 1.25rem;
    background: color-mix(in srgb, var(--dot-dark) 45%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid color-mix(in srgb, var(--dot-light) 12%, transparent);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--dot-micelio);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .marquee-wrap {
    position: relative;
  }

  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    width: max-content;
    animation: scroll-left 50s linear infinite;
  }

  .marquee-track img {
    height: 2rem;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.85;
    transition: filter var(--transition-fast), opacity var(--transition-fast), transform var(--transition-fast);
  }
  .marquee-track img:hover {
    filter: brightness(0);
    opacity: 1;
    transform: scale(1.1);
  }

  @keyframes scroll-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
