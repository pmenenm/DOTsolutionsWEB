---
// src/components/sections/RetailPiecesScroll.astro
// "Las piezas" de Retail, en formato scrollytelling horizontal — mismo mecanismo que
// SapHorizontalScroll.astro (pin:true sobre el propio trigger, `end`/`x` calculados en vivo
// a partir de scrollWidth-innerWidth, gsap.matchMedia con fallback vertical en mobile), pero
// como un "filmstrip": las cards son más angostas que el viewport (se alcanza a ver un
// pedazo de la siguiente asomando a la derecha), no paneles de 100vw uno por uno — así los
// 7 ítems se sienten como una cinta continua, no 7 pantallas completas seguidas.
// Solo se usa en Retail.astro — ProductModulesGrid.astro (el componente genérico que usan
// SAP y otras páginas) no se toca.
interface Module {
  title: string;
  desc: string;
}

interface Props {
  eyebrow: string;
  title: string;
  modules: Module[];
}

const { eyebrow, title, modules } = Astro.props;

// Un ícono temático por pieza (núcleo ERP, POS, venta móvil, pedidos, fidelización,
// infraestructura, facturación) — mismo lenguaje visual (trazo fino, sin relleno) que el
// resto de los íconos del sitio.
const ICONS = [
  '<circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M12 2.5v3M12 18.5v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2.5 12h3M18.5 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>',
  '<path d="M6 8V6a4 4 0 1 1 8 0v2M4 8h12l-1 11a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1L4 8Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>',
  '<rect x="7" y="2.5" width="10" height="19" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M10.5 18.5h3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>',
  '<path d="M3 8l9-4.5L21 8v8l-9 4.5L3 16V8Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 8l9 4.5L21 8M12 12.5V21" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>',
  '<path d="M12 20s-7-4.35-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 5c-2.5 4.65-9.5 9-9.5 9Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>',
  '<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M3 12h18M12 3c2.4 2.4 3.6 5.7 3.6 9s-1.2 6.6-3.6 9c-2.4-2.4-3.6-5.7-3.6-9s1.2-6.6 3.6-9Z" fill="none" stroke="currentColor" stroke-width="1.4"/>',
  '<path d="M6 2.5h9l3 3V21a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M8.5 12h7M8.5 16h7M8.5 8h3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>',
];
---

<section class="pieces-hz" data-pieces-hz>
  <div class="pieces-hz-container" data-pieces-hz-container>
    <div class="pieces-hz-header container">
      <p class="pieces-hz-eyebrow">
        <span class="dot"></span>
        {eyebrow}
      </p>
      <h2 class="pieces-hz-title">{title}</h2>
      <p class="pieces-hz-hint" aria-hidden="true">Scrollea para recorrer el stack →</p>
    </div>

    <div class="pieces-hz-track" data-pieces-hz-track>
      {modules.map((mod, i) => (
        <article class="piece-card" data-piece-card>
          <span class="piece-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="piece-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" set:html={ICONS[i % ICONS.length]} />
          </div>
          <h3>{mod.title}</h3>
          <p>{mod.desc}</p>
        </article>
      ))}
    </div>

    <div class="pieces-hz-counter" data-pieces-hz-counter aria-hidden="true">
      <span data-pieces-hz-counter-current>01</span> / {String(modules.length).padStart(2, '0')}
    </div>

    <div class="pieces-hz-progress" data-pieces-hz-progress aria-hidden="true">
      <div class="pieces-hz-progress-bar" data-pieces-hz-progress-bar></div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initRetailPiecesScroll() {
    const section = document.querySelector<HTMLElement>('[data-pieces-hz]');
    const containerEl = document.querySelector<HTMLElement>('[data-pieces-hz-container]');
    const trackEl = document.querySelector<HTMLElement>('[data-pieces-hz-track]');
    const progressBar = document.querySelector<HTMLElement>('[data-pieces-hz-progress-bar]');
    const counterCurrent = document.querySelector<HTMLElement>('[data-pieces-hz-counter-current]');
    if (!section || !containerEl || !trackEl) return;

    const cards = gsap.utils.toArray<HTMLElement>('[data-piece-card]', trackEl);
    const mm = gsap.matchMedia();

    mm.add('(min-width: 1025px)', () => {
      const tween = gsap.to(trackEl, {
        x: () => -(trackEl.scrollWidth - window.innerWidth),
        ease: 'none',
        scrollTrigger: {
          trigger: containerEl,
          pin: true,
          scrub: 0.6,
          start: 'top top',
          end: () => `+=${trackEl.scrollWidth - window.innerWidth}`,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            if (progressBar) progressBar.style.width = `${self.progress * 100}%`;
            if (counterCurrent) {
              const idx = Math.min(cards.length - 1, Math.floor(self.progress * cards.length));
              counterCurrent.textContent = String(idx + 1).padStart(2, '0');
            }
          },
        },
      });

      // Cada card entra con fade + escala + una leve rotación 3D (como si "girara" hacia el
      // espectador al llegar) — el mismo patrón de containerAnimation que la página de SAP,
      // pero con perspectiva para que se sienta más juguetón, no solo un fade plano.
      const cardTriggers = cards.map((card) =>
        gsap.fromTo(
          card,
          { opacity: 0.25, scale: 0.88, rotationY: 10, filter: 'blur(2px)' },
          {
            opacity: 1,
            scale: 1,
            rotationY: 0,
            filter: 'blur(0px)',
            ease: 'power2.out',
            scrollTrigger: {
              trigger: card,
              containerAnimation: tween,
              start: 'left 92%',
              end: 'left 55%',
              scrub: true,
            },
          }
        )
      );

      return () => {
        tween.scrollTrigger?.kill();
        tween.kill();
        cardTriggers.forEach((t) => t.scrollTrigger?.kill());
        gsap.set(trackEl, { clearProps: 'transform' });
        gsap.set(cards, { clearProps: 'opacity,transform,filter' });
        if (progressBar) progressBar.style.width = '0%';
        if (counterCurrent) counterCurrent.textContent = '01';
      };
    });

    mm.add('(max-width: 1024px)', () => () => {});

    document.addEventListener('astro:before-swap', () => mm.revert(), { once: true });
  }

  document.addEventListener('astro:page-load', initRetailPiecesScroll);
</script>

<style>
  .pieces-hz {
    position: relative;
    padding-block: var(--space-xl) 0;
    overflow: hidden;
  }

  .pieces-hz-header {
    text-align: center;
    max-width: 46rem;
    margin-inline: auto;
    /* Pegado a las cards a propósito: el pin de ScrollTrigger arranca cuando
       .pieces-hz-container toca el borde superior del viewport — con un margen grande acá,
       el encabezado ya había salido de pantalla mucho antes de llegar a ese punto. Con poco
       espacio, encabezado y primera card quedan en la misma pantalla al llegar al pin. */
    margin-bottom: var(--space-sm);
  }
  .pieces-hz-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--dot-micelio);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    justify-content: center;
    margin-bottom: var(--space-xs);
  }
  .pieces-hz-eyebrow .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--dot-micelio);
  }
  .pieces-hz-title {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }
  .pieces-hz-hint {
    margin-top: var(--space-sm);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--dot-light) 50%, transparent);
  }

  /* ---------- Mobile/tablet: grid vertical normal, sin pin ni transform. ---------- */
  .pieces-hz-container {
    padding-inline: var(--container-pad);
  }
  .pieces-hz-track {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    max-width: var(--container-max);
    margin-inline: auto;
  }
  .pieces-hz-counter,
  .pieces-hz-progress {
    display: none;
  }

  .piece-card {
    position: relative;
    overflow: hidden;
    padding: clamp(1.75rem, 3vw, 2.25rem);
    background: color-mix(in srgb, var(--dot-light) 4%, transparent);
    border: 1px solid color-mix(in srgb, var(--dot-micelio) 40%, transparent);
    border-radius: var(--radius-lg);
    box-shadow: 0 0 28px color-mix(in srgb, var(--dot-micelio) 14%, transparent);
    transition: border-color 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }
  .piece-card:hover {
    border-color: var(--dot-micelio);
    box-shadow: 0 0 40px color-mix(in srgb, var(--dot-micelio) 30%, transparent);
    transform: translateY(-4px);
  }

  /* Número editorial grande de fondo — misma idea que "Por qué DOT", acá reforzando el
     conteo del recorrido (pieza 01 de 07, etc). */
  .piece-index {
    position: absolute;
    top: -0.5rem;
    right: 1rem;
    font-family: var(--font-heading);
    font-size: 5rem;
    font-weight: 700;
    line-height: 1;
    color: color-mix(in srgb, var(--dot-micelio) 12%, transparent);
    pointer-events: none;
  }

  .piece-icon {
    position: relative;
    display: inline-flex;
    color: var(--dot-micelio);
    margin-bottom: var(--space-sm);
  }
  .piece-icon svg {
    width: 2rem;
    height: 2rem;
  }

  .piece-card h3 {
    position: relative;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-lg);
    line-height: 1.3;
    color: var(--dot-light);
    margin-bottom: 0.5rem;
    padding-right: 2.5rem;
  }
  .piece-card p {
    position: relative;
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* ---------- Desktop (1025px+): filmstrip horizontal pineado. ---------- */
  @media (min-width: 1025px) {
    .pieces-hz-container {
      position: relative;
      /* El título no se recortaba por falta de alto acá — lo tapaba el navbar fijo del sitio
         (position:fixed, z-index alto), que ocupa los primeros ~4-5rem de la pantalla. Con
         padding-top:3rem el título arrancaba justo debajo del borde del nav y quedaba medio
         tapado. 7rem es el mismo margen que usa el Hero del Home para lo mismo. */
      height: 46rem;
      overflow: hidden;
      padding-inline: 0;
      padding-top: 7rem;
      /* Header + riel de cards apilados dentro del área pineada — así el título/hint quedan
         fijos en pantalla durante TODO el recorrido horizontal, en vez de haber quedado
         arriba, fuera del área que se fija. */
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      gap: 1.5rem;
    }
    .pieces-hz-header {
      flex-shrink: 0;
      width: auto;
      max-width: none;
      margin-inline: 6vw;
      padding-inline: 0;
      text-align: left;
      margin-bottom: 0;
    }
    .pieces-hz-eyebrow {
      justify-content: flex-start;
    }
    .pieces-hz-title {
      font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    }
    .pieces-hz-hint {
      margin-top: 0.35rem;
    }
    .pieces-hz-track {
      display: flex;
      flex-direction: row;
      flex-shrink: 0;
      align-items: center;
      height: 26rem;
      gap: 2rem;
      padding-inline: 6vw;
      max-width: none;
      margin-inline: 0;
      will-change: transform;
      perspective: 1600px;
    }
    .piece-card {
      flex-shrink: 0;
      width: min(30rem, 62vw);
      height: 26rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      transform-style: preserve-3d;
    }
    .piece-index {
      font-size: 6.5rem;
    }
    .piece-icon svg {
      width: 2.5rem;
      height: 2.5rem;
    }
    .piece-card p {
      max-width: 32ch;
    }

    .pieces-hz-counter {
      display: block;
      position: absolute;
      top: 1.5rem;
      right: 6vw;
      z-index: 5;
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      letter-spacing: 0.05em;
      color: color-mix(in srgb, var(--dot-light) 55%, transparent);
    }
    .pieces-hz-counter span {
      color: var(--dot-micelio);
      font-weight: 700;
    }

    .pieces-hz-progress {
      display: block;
      position: absolute;
      left: 6vw;
      right: 6vw;
      bottom: 1.5rem;
      z-index: 5;
      height: 2px;
      background: color-mix(in srgb, var(--dot-light) 12%, transparent);
    }
    .pieces-hz-progress-bar {
      height: 100%;
      width: 0%;
      background: var(--dot-micelio);
      box-shadow: 0 0 10px color-mix(in srgb, var(--dot-micelio) 70%, transparent);
      transition: width 0.1s linear;
    }
  }
</style>
