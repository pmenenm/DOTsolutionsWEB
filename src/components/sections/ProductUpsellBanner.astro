---
// src/components/sections/ProductUpsellBanner.astro
// Banner "El siguiente nivel" — franja en Verde Sustrato (dot-forest, la
// misma paleta orgánica) con dos CTAs (primario sólido + secundario con
// borde), para el upsell a un producto mayor sin forzar el salto.
interface Props {
  eyebrow: string;
  title: string;
  desc: string;
  cta: string;
  ctaHref: string;
  ctaSecondary: string;
  ctaSecondaryHref: string;
}

const { eyebrow, title, desc, cta, ctaHref, ctaSecondary, ctaSecondaryHref } = Astro.props;
---

<div class="upsell" data-reveal>
  <p class="eyebrow">
    <span class="dot"></span>
    {eyebrow}
  </p>
  <h2 class="title">{title}</h2>
  <p class="desc">{desc}</p>

  <div class="actions">
    <a href={ctaHref} class="cta-primary">{cta}</a>
    <a href={ctaSecondaryHref} class="cta-secondary">{ctaSecondary}</a>
  </div>
</div>

<style>
  .upsell {
    position: relative;
    overflow: hidden;
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3rem);
    background: color-mix(in srgb, var(--dot-forest) 55%, var(--dot-dark) 45%);
    border: 1px solid color-mix(in srgb, var(--dot-micelio) 20%, transparent);
    text-align: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--dot-micelio);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-xs);
    justify-content: center;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--dot-micelio);
  }

  .title {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.75rem, 3.8vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    max-width: 30ch;
    margin-inline: auto;
  }

  .desc {
    margin-top: var(--space-sm);
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 52ch;
    margin-inline: auto;
  }

  .actions {
    margin-top: var(--space-lg);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
  }

  .cta-primary,
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 1.75rem;
    font-size: var(--text-base);
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-full);
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }

  .cta-primary {
    background: var(--dot-micelio);
    color: var(--dot-dark);
  }
  .cta-primary:hover {
    background: color-mix(in srgb, var(--dot-micelio) 85%, var(--dot-light) 15%);
  }

  .cta-secondary {
    border: 1px solid color-mix(in srgb, var(--dot-light) 30%, transparent);
    color: var(--text-primary);
  }
  .cta-secondary:hover {
    border-color: var(--dot-micelio);
    color: var(--dot-micelio);
  }
</style>
