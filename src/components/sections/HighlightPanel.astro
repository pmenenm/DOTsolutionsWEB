---
import { withBase } from '../../utils/paths';

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  points: string[];
  image?: string;
}

const { eyebrow, title, body, points, image } = Astro.props;
---

<div class="panel" data-reveal>
  {image && <img src={withBase(image)} alt="" class="panel-image" loading="lazy" />}
  <div class="panel-body">
    <p class="eyebrow">
      <span class="dot"></span>
      {eyebrow}
    </p>
    <h2>{title}</h2>
    <p class="body-text">{body}</p>
    <ul>
      {points.map((point) => <li>{point}</li>)}
    </ul>
  </div>
</div>

<style>
  .panel {
    background: var(--dot-gray);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .panel-image {
    width: 100%;
    border-radius: var(--radius-md);
    aspect-ratio: 16/9;
    object-fit: cover;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-xs);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  h2 {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .body-text {
    margin-top: var(--space-xs);
    color: var(--text-secondary);
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.6;
  }

  ul {
    margin-top: var(--space-sm);
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  li {
    padding-left: 1.25rem;
    position: relative;
    color: var(--text-primary);
    font-size: var(--text-sm);
  }
  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (min-width: 900px) {
    .panel {
      flex-direction: row;
      align-items: center;
    }
    .panel-image {
      width: 40%;
      aspect-ratio: 1;
    }
    .panel-body {
      flex: 1;
    }
  }
</style>
