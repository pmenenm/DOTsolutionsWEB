---
// src/components/sections/ServicesShowcase.astro
// "Nuestro ecosistema" — diagrama de micelio: un núcleo central conectado
// por ramificaciones SVG a cada tarjeta de producto. Al hacer scroll, las
// líneas se "dibujan" (stroke-dashoffset) desde el núcleo hacia las tarjetas,
// con un leve stagger entre ellas para que se sienta orgánico, no mecánico.
import { withBase } from '../../utils/paths';

interface Product {
  name: string;
  category: string;
  logo: string;
  desc: string;
  href: string;
  highlight?: boolean;
}

interface Props {
  eyebrow: string;
  titleHighlight: string;
  titleRest: string;
  subtitle: string;
  products: Product[];
}

const { eyebrow, titleHighlight, titleRest, subtitle, products } = Astro.props;
---

<section class="mycelium" data-mycelium>
  <div class="container glass-panel mycelium-header">
    <p class="mycelium-eyebrow">
      <span class="dot"></span>
      {eyebrow}
    </p>
    <h2 class="mycelium-title">
      <span class="mycelium-title-highlight">{titleHighlight}</span>{titleRest}
    </h2>
    <p class="mycelium-subtitle">{subtitle}</p>
  </div>

  <div class="container mycelium-canvas" data-mycelium-canvas>
    <svg class="mycelium-svg" data-mycelium-svg aria-hidden="true">
      <defs>
        <filter id="mycelium-glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="2.5" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>
      {products.map((_, i) => (
        <path class="mycelium-line" data-mycelium-line data-index={i} fill="none" />
      ))}
    </svg>

    <div class="mycelium-core" data-mycelium-core aria-hidden="true">
      <img src={withBase('/logoweb.png')} alt="" class="core-logo" />
    </div>

    <div class="mycelium-grid" data-mycelium-grid>
      {products.map((p, i) => (
        <a
          href={p.href}
          class:list={['mycelium-card', { 'mycelium-card--highlight': p.highlight }]}
          data-mycelium-card
          data-index={i}
        >
          <div class="card-logo">
            <img src={withBase(p.logo)} alt="" loading="lazy" />
          </div>
          <p class="card-category">{p.category}</p>
          <h3 class="card-name">{p.name}</h3>
          <p class="card-desc">{p.desc}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initMycelium() {
    document.querySelectorAll<HTMLElement>('[data-mycelium]').forEach((section) => {
      const canvas = section.querySelector<HTMLElement>('[data-mycelium-canvas]');
      const svg = section.querySelector<SVGSVGElement>('[data-mycelium-svg]');
      const core = section.querySelector<HTMLElement>('[data-mycelium-core]');
      const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-mycelium-card]'));
      const lines = Array.from(section.querySelectorAll<SVGPathElement>('[data-mycelium-line]'));
      if (!canvas || !svg || !core || cards.length === 0 || lines.length === 0) return;

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let cardTriggers: ScrollTrigger[] = [];

      function pointFor(el: HTMLElement, anchor: 'top' | 'bottom') {
        const canvasRect = canvas!.getBoundingClientRect();
        const elRect = el.getBoundingClientRect();
        return {
          x: elRect.left + elRect.width / 2 - canvasRect.left,
          y: (anchor === 'top' ? elRect.top : elRect.bottom) - canvasRect.top,
        };
      }

      function layout() {
        const canvasRect = canvas!.getBoundingClientRect();
        svg!.setAttribute('viewBox', `0 0 ${canvasRect.width} ${canvasRect.height}`);

        const start = pointFor(core!, 'bottom');

        cards.forEach((card, i) => {
          const path = lines[i];
          if (!path) return;
          const end = pointFor(card, 'top');
          const midY = start.y + (end.y - start.y) * 0.5;
          // Jitter alterna de lado para que las ramas no sean simétricas —
          // el look "orgánico" del micelio, no una grilla de conectores.
          const jitter = (i % 2 === 0 ? 1 : -1) * (14 + i * 5);
          path.setAttribute(
            'd',
            `M ${start.x} ${start.y} C ${start.x + jitter} ${midY}, ${end.x - jitter} ${midY}, ${end.x} ${end.y}`
          );

          const length = path.getTotalLength();
          path.style.strokeDasharray = `${length}`;
          path.style.strokeDashoffset = reduced ? '0' : `${length}`;
        });
      }

      layout();
      window.addEventListener('resize', layout);

      if (reduced) {
        cards.forEach((card) => {
          card.style.opacity = '1';
        });
      } else {
        cards.forEach((card) => {
          card.style.opacity = '0.3';
        });

        // Cada tarjeta tiene su propio trigger atado a SU posición real en
        // pantalla (no a todo el grid, que con 3 filas es demasiado alto
        // para que un solo rango de scroll sirva a la vez): la línea
        // termina de dibujarse mientras esa tarjeta puntual todavía está
        // cómodamente visible, sin importar en qué fila esté.
        cards.forEach((card, i) => {
          const path = lines[i];
          if (!path) return;
          const trigger = ScrollTrigger.create({
            trigger: card,
            start: 'top 95%',
            end: 'top 55%',
            scrub: true,
            onUpdate: (self) => {
              const length = path.getTotalLength();
              path.style.strokeDashoffset = `${length * (1 - self.progress)}`;
              card.style.opacity = String(0.3 + self.progress * 0.7);
            },
          });
          cardTriggers.push(trigger);
        });
      }

      document.addEventListener('astro:before-swap', () => {
        cardTriggers.forEach((t) => t.kill());
        window.removeEventListener('resize', layout);
      });
    });
  }

  document.addEventListener('astro:page-load', initMycelium);
</script>

<style>
  .mycelium {
    padding-block: var(--space-lg);
  }

  .mycelium-header {
    text-align: center;
    max-width: 62rem;
    margin-inline: auto;
    padding: clamp(2rem, 4vw, 3rem);
    /* Menos blur que el .glass-panel genérico (20px) — acá alcanza con
       menos para leerse bien sin perder tanta textura del fondo detrás.
       Sin borde a propósito: solo el blur separa la card del fondo. */
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    border: none;
  }
  .mycelium-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--dot-micelio);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-xs);
  }
  .mycelium-eyebrow .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--dot-micelio);
  }
  .mycelium-title {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }
  .mycelium-title-highlight {
    color: var(--dot-micelio);
  }
  .mycelium-subtitle {
    margin-top: var(--space-xs);
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--text-secondary);
    font-weight: 300;
  }

  .mycelium-canvas {
    position: relative;
    margin-top: var(--space-xl);
  }

  .mycelium-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }
  .mycelium-line {
    stroke: var(--dot-micelio);
    stroke-width: 1.5;
    opacity: 0.55;
    filter: url(#mycelium-glow);
  }

  .mycelium-core {
    position: relative;
    z-index: 1;
    width: fit-content;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
    padding: 0.9rem 1.75rem;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--dot-forest) 55%, transparent);
    border: 1px solid color-mix(in srgb, var(--dot-micelio) 40%, transparent);
    box-shadow: 0 0 32px color-mix(in srgb, var(--dot-micelio) 25%, transparent);
  }
  .core-logo {
    height: 1.5rem;
    width: auto;
    object-fit: contain;
  }

  .mycelium-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  /* Nodo/tarjeta — glassmorphism oscuro. */
  .mycelium-card {
    display: block;
    text-decoration: none;
    background: color-mix(in srgb, var(--dot-light) 5%, transparent);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid color-mix(in srgb, var(--dot-light) 10%, transparent);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
    transition: border-color var(--transition-fast), transform var(--transition-fast), opacity var(--transition-fast);
  }
  .mycelium-card:hover {
    border-color: color-mix(in srgb, var(--dot-micelio) 60%, transparent);
    transform: translateY(-4px);
  }

  /* SAP Business One cierra el diagrama como núcleo ERP del ecosistema —
     mismo tamaño de card que el resto, solo con un borde más marcado. */
  .mycelium-card--highlight {
    border-color: color-mix(in srgb, var(--dot-micelio) 45%, transparent);
    background: color-mix(in srgb, var(--dot-forest) 30%, transparent);
  }
  .mycelium-card--highlight:hover {
    border-color: color-mix(in srgb, var(--dot-micelio) 75%, transparent);
  }
  .mycelium-card--highlight .card-logo {
    height: 2.75rem;
  }

  .card-logo {
    width: 7rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 1rem;
  }
  .card-logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: left center;
  }

  .card-category {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dot-micelio);
    margin-bottom: 0.35rem;
  }
  .card-name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--dot-light);
    margin-bottom: 0.4rem;
  }
  .card-desc {
    font-size: var(--text-sm);
    line-height: 1.55;
    color: color-mix(in srgb, var(--dot-light) 78%, transparent);
  }

  @media (min-width: 700px) {
    .mycelium-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
