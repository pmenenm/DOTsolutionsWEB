---
// src/components/sections/AddonsCatalog.astro
// Sección de categoría del catálogo de add-ons — grilla de cards
// expandibles (<details>, sin JS) con descripción corta siempre visible y
// la descripción completa + tags de compatibilidad al abrir. Mismo lenguaje
// "solo borde + brillo diagonal" que PainBento/ProductModulesGrid.
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../../i18n/utils';

interface Item {
  name: string;
  shortDesc: string;
  fullDesc: string;
  compatible?: string[];
  features?: string[];
  cta?: string;
  ctaHref?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  items: Item[];
  lang: Lang;
}

const { eyebrow, title, intro, items, lang } = Astro.props;

const ACCENTS = ['var(--dot-micelio)', 'var(--dot-moss)', 'var(--dot-sage)', 'var(--dot-forest)'];
---

<div class="category">
  <div class="category-heading" data-reveal>
    <p class="eyebrow">
      <span class="dot"></span>
      {eyebrow}
    </p>
    <h2 class="title">{title}</h2>
    <p class="intro">{intro}</p>
  </div>

  <div class="items-grid" id={`addons-${eyebrow.replace(/\s+/g, '-')}`}>
    {items.map((item, i) => (
      <details class="item-card" style={`--card-accent: ${ACCENTS[i % ACCENTS.length]}; transition-delay: ${(i * 0.06).toFixed(2)}s`}>
        <summary>
          <h3>{item.name}</h3>
          <p class="short">{item.shortDesc}</p>
          <span class="toggle" aria-hidden="true">+</span>
        </summary>
        <div class="item-body">
          <p class="full">{item.fullDesc}</p>
          {item.features && (
            <ul class="features">
              {item.features.map((f) => <li>{f}</li>)}
            </ul>
          )}
          {item.compatible && (
            <div class="compatible">
              {item.compatible.map((c) => <span class="tag">{c}</span>)}
            </div>
          )}
          {item.cta && item.ctaHref && (
            <a href={getRelativeLocaleUrl(lang, item.ctaHref)} class="item-cta">
              {item.cta}
              <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </details>
    ))}
  </div>
</div>

<script>
  function initAddonsGrids() {
    const grids = document.querySelectorAll<HTMLElement>('.items-grid');
    if (!grids.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.08 }
    );

    grids.forEach((grid) => {
      const rect = grid.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        grid.classList.add('is-visible');
      } else {
        observer.observe(grid);
      }
    });
  }

  document.addEventListener('astro:page-load', initAddonsGrids);
</script>

<style>
  .category-heading {
    max-width: var(--content-max);
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent-secondary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-xs);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .title {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.5rem, 3.4vw, 2.25rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }
  .intro {
    margin-top: var(--space-xs);
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 60ch;
  }

  .items-grid {
    margin-top: var(--space-lg);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .item-card {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--card-accent) 35%, transparent);
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s var(--ease-out), transform 0.4s var(--ease-out), border-color 0.3s var(--ease-out);
  }
  .items-grid.is-visible .item-card {
    opacity: 1;
    transform: translateY(0);
  }
  .item-card:hover {
    border-color: color-mix(in srgb, var(--card-accent) 70%, transparent);
  }
  .item-card[open] {
    border-color: color-mix(in srgb, var(--card-accent) 70%, transparent);
  }

  summary {
    list-style: none;
    cursor: pointer;
    padding: var(--space-md);
    display: block;
    position: relative;
  }
  summary::-webkit-details-marker {
    display: none;
  }

  summary h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--dot-micelio);
    margin-bottom: 0.35rem;
    padding-right: 2.5rem;
  }
  summary .short {
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.55;
    color: var(--text-secondary);
    padding-right: 2.5rem;
  }

  .toggle {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    width: 1.75rem;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--card-accent);
    border: 1px solid color-mix(in srgb, var(--card-accent) 45%, transparent);
    transition: transform 0.3s var(--ease-out), background 0.3s var(--ease-out);
  }
  .item-card[open] .toggle {
    transform: rotate(45deg);
    background: color-mix(in srgb, var(--card-accent) 15%, transparent);
  }

  .item-body {
    padding: 0 var(--space-md) var(--space-md);
  }
  .full {
    font-size: var(--text-sm);
    font-weight: 300;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .features {
    margin-top: var(--space-sm);
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .features li {
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--text-primary);
    padding-left: 1rem;
    border-left: 2px solid color-mix(in srgb, var(--card-accent) 50%, transparent);
  }

  .compatible {
    margin-top: var(--space-sm);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tag {
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 0.3rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--dot-light) 20%, transparent);
    border-radius: var(--radius-full);
    color: var(--text-secondary);
  }

  .item-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: var(--space-sm);
    color: var(--dot-micelio);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }

  @media (min-width: 700px) {
    .items-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
