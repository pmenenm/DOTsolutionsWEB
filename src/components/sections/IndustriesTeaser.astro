---
// src/components/sections/IndustriesTeaser.astro
// Dos industrias destacadas, lado a lado como cards de vidrio oscuro (esta
// sección vive dentro de <HeroReveal>, sobre la foto continua del home —
// necesitan fondo propio real para leerse bien, a diferencia de las cards
// "solo borde" que usamos sobre fondo plano en las páginas de producto).
// Cada card lleva su propio color de acento, ícono grande y número
// editorial — el resto de las industrias quedan como tags pulsantes abajo.
interface Industry {
  slug: string;
  name: string;
  headline: string;
  desc: string;
}

interface Props {
  featured: Industry[];
  othersLabel: string;
  others: string[];
}

const { featured, othersLabel, others } = Astro.props;

const ACCENTS: Record<string, string> = {
  gastronomia: 'var(--dot-moss)',
  retail: 'var(--dot-micelio)',
};

const ICONS: Record<string, string> = {
  gastronomia:
    '<path d="M6 2v6a2 2 0 0 0 4 0V2M8 2v18M14 2c-1.2 1.2-1.6 3-1.6 5s.4 3.8 1.6 5c1.2-1.2 1.6-3 1.6-5s-.4-3.8-1.6-5Zm0 10v8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>',
  retail:
    '<path d="M6 8V6a4 4 0 1 1 8 0v2M4 8h12l-1 11a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1L4 8Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>',
};
---

<div class="eco" data-eco>
  <div class="eco-grid" id="eco-grid">
    {featured.map((industry, i) => (
      <article
        class="eco-card"
        style={`--accent: ${ACCENTS[industry.slug] ?? 'var(--dot-micelio)'}; transition-delay: ${(i * 0.15).toFixed(2)}s`}
      >
        <span class="eco-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>

        <div class="eco-orb" aria-hidden="true">
          <svg viewBox="0 0 20 20" set:html={ICONS[industry.slug] ?? ''} />
        </div>

        <p class="eco-name">{industry.name}</p>
        <h3 class="eco-headline">{industry.headline}</h3>
        <p class="eco-desc">{industry.desc}</p>
      </article>
    ))}
  </div>

  <div class="eco-others">
    <span class="eco-others-label">{othersLabel}</span>
    <ul class="eco-others-list">
      {others.map((o) => (
        <li>
          <span class="eco-dot" aria-hidden="true"></span>
          {o}
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  // Entrada vía toggle de clase (no GSAP inline) a propósito: GSAP setea
  // transform como estilo inline al animar, y un estilo inline SIEMPRE le
  // gana a la regla :hover de la hoja de estilos — el lift al hover nunca
  // se veía en la 1ra card porque quedaba pisado por ese inline leftover.
  function initEcoGrid() {
    const grids = document.querySelectorAll<HTMLElement>('#eco-grid');
    if (!grids.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.15 }
    );

    grids.forEach((grid) => {
      const rect = grid.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        grid.classList.add('is-visible');
      } else {
        observer.observe(grid);
      }
    });
  }

  document.addEventListener('astro:page-load', initEcoGrid);
</script>

<style>
  .eco-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  .eco-card {
    position: relative;
    overflow: hidden;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    background: color-mix(in srgb, var(--dot-dark) 50%, transparent);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s var(--ease-out), transform 0.3s var(--ease-out), border-color 0.4s var(--ease-out);
  }
  .eco-grid.is-visible .eco-card {
    opacity: 1;
    transform: translateY(0);
  }
  .eco-card:hover {
    border-color: color-mix(in srgb, var(--accent) 70%, transparent);
    transform: translateY(-6px);
  }
  .eco-card::after {
    content: '';
    position: absolute;
    top: -20%;
    left: -60%;
    width: 35%;
    height: 140%;
    background: linear-gradient(115deg, transparent, color-mix(in srgb, var(--accent) 22%, transparent), transparent);
    transform: skewX(-15deg);
    transition: left 0.7s var(--ease-out);
    pointer-events: none;
  }
  .eco-card:hover::after {
    left: 130%;
  }

  .eco-number {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1;
    color: color-mix(in srgb, var(--accent) 40%, transparent);
    transition: color 0.4s var(--ease-out);
  }
  .eco-card:hover .eco-number {
    color: color-mix(in srgb, var(--accent) 70%, transparent);
  }

  .eco-orb {
    position: relative;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-md);
    background: radial-gradient(
      circle at 35% 30%,
      color-mix(in srgb, var(--accent) 32%, transparent),
      color-mix(in srgb, var(--accent) 8%, transparent) 62%,
      transparent 78%
    );
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent);
    transition: transform 0.4s var(--ease-out), border-color 0.4s var(--ease-out);
  }
  .eco-orb svg {
    width: 1.75rem;
    height: 1.75rem;
  }
  .eco-card:hover .eco-orb {
    transform: scale(1.12) rotate(-6deg);
    border-color: var(--accent);
  }

  .eco-name {
    position: relative;
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .eco-headline {
    position: relative;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    max-width: 26ch;
  }
  .eco-desc {
    position: relative;
    color: var(--text-secondary);
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.6;
    max-width: 40ch;
  }

  .eco-others {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid color-mix(in srgb, var(--dot-light) 12%, transparent);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
  }
  .eco-others-label {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .eco-others-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .eco-others-list li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-primary);
    transform-origin: left center;
    transition: transform var(--transition-fast), color var(--transition-fast);
  }
  .eco-others-list li:hover {
    transform: scale(1.15);
    color: var(--dot-micelio);
  }
  .eco-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--dot-micelio);
    box-shadow: 0 0 6px color-mix(in srgb, var(--dot-micelio) 60%, transparent);
    animation: eco-pulse 2.4s ease-in-out infinite;
  }
  @keyframes eco-pulse {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(0.85);
    }
    50% {
      opacity: 1;
      transform: scale(1.15);
    }
  }

  @media (min-width: 700px) {
    .eco-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
