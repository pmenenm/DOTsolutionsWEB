---
// src/components/sections/PiecesCoverflow.astro
// Carrusel "Cover Flow" para las piezas del ecosistema — mismo mecanismo que
// Testimonials.astro (tarjeta central en foco, laterales detrás escaladas/atenuadas/
// blureadas, auto-play cada 3s pausado en hover, flechas manuales) más una mejora:
// las tarjetas laterales también son clickeables para saltar directo a ellas, no solo
// las flechas. Le da a cada pieza su momento individual en pantalla en vez de las 8
// compitiendo por atención en una grilla.
interface Module {
  title: string;
  desc: string;
}

interface Props {
  eyebrow: string;
  title: string;
  /** Frase exacta dentro de `title` a resaltar en verde micelio. */
  titleHighlight?: string;
  modules: Module[];
}

const { eyebrow, title, titleHighlight, modules } = Astro.props;

let titleBefore = title;
let titleAfter = '';
const hasTitleHighlight = Boolean(titleHighlight && title.includes(titleHighlight));
if (hasTitleHighlight && titleHighlight) {
  const idx = title.indexOf(titleHighlight);
  titleBefore = title.slice(0, idx);
  titleAfter = title.slice(idx + titleHighlight.length);
}

const ICONS = [
  '<path d="M4 20V11M10 20V4M16 20v-6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 20h20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>',
  '<circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M2 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M15 14.5c2.4.4 4.5 2.3 4.5 5.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="16" cy="7" r="2.4" fill="none" stroke="currentColor" stroke-width="1.4"/>',
  '<path d="M3 8l9-4.5L21 8v8l-9 4.5L3 16V8Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 8l9 4.5L21 8M12 12.5V21" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>',
  '<circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M12 3.5V12l6 6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>',
  '<rect x="7" y="2.5" width="10" height="19" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M10.5 18.5h3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>',
  '<path d="M9 18h6M10 21h4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M12 2.5a6.5 6.5 0 0 0-3.5 12c.5.35.8.9.8 1.5v.5h5.4V16c0-.6.3-1.15.8-1.5a6.5 6.5 0 0 0-3.5-12Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>',
  '<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M3 12h18M12 3c2.4 2.4 3.6 5.7 3.6 9s-1.2 6.6-3.6 9c-2.4-2.4-3.6-5.7-3.6-9s1.2-6.6 3.6-9Z" fill="none" stroke="currentColor" stroke-width="1.4"/>',
];

---

<div class="pc-wrap">
  <div class="modules-heading" data-reveal>
    <p class="eyebrow">
      <span class="dot"></span>
      {eyebrow}
    </p>
    <h2 class="heading-title">
      {titleBefore}
      {hasTitleHighlight && <span class="title-highlight">{titleHighlight}</span>}
      {titleAfter}
    </h2>
  </div>

  <div class="pc" data-pc>
    <div class="pc-stage" data-pc-stage>
      {modules.map((mod, i) => (
        <article
          class="pc-card"
          data-pc-card
          data-pc-index={i}
          tabindex="0"
        >
          <div class="pc-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" set:html={ICONS[i % ICONS.length]} />
          </div>
          <h3 class="pc-title">{mod.title}</h3>
          <p class="pc-desc">{mod.desc}</p>
        </article>
      ))}
    </div>

    <div class="pc-dots" data-pc-dots>
      {modules.map((_, i) => (
        <button type="button" class="pc-dot" data-pc-dot data-pc-index={i} aria-label={`Ir a la pieza ${i + 1}`}></button>
      ))}
    </div>

    <button type="button" class="pc-arrow pc-arrow--prev" data-pc-prev aria-label="Anterior">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <button type="button" class="pc-arrow pc-arrow--next" data-pc-next aria-label="Siguiente">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
</div>

<script>
  function initPiecesCoverflows() {
    document.querySelectorAll<HTMLElement>('[data-pc]').forEach((root) => {
      const stage = root.querySelector<HTMLElement>('[data-pc-stage]');
      const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-pc-card]'));
      const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-pc-dot]'));
      const n = cards.length;
      if (!stage || n === 0) return;
      const stageEl = stage;

      const prevBtn = root.querySelector<HTMLButtonElement>('[data-pc-prev]');
      const nextBtn = root.querySelector<HTMLButtonElement>('[data-pc-next]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      let active = 0;
      let timer: ReturnType<typeof setInterval> | undefined;

      function render() {
        cards.forEach((card, i) => {
          let d = i - active;
          if (d > n / 2) d -= n;
          if (d < -n / 2) d += n;

          const abs = Math.abs(d);
          const offset = d * 62;
          let scale = 1;
          let opacity = 1;
          let blur = 0;
          let z = n;

          if (abs === 1) {
            scale = 0.85;
            opacity = 0.45;
            blur = 10;
            z = n - 1;
          } else if (abs > 1) {
            scale = 0.7;
            opacity = 0;
            blur = 14;
            z = 0;
          }

          card.style.transform = `translateX(calc(-50% + ${offset}%)) scale(${scale})`;
          card.style.opacity = String(opacity);
          card.style.filter = blur ? `blur(${blur}px)` : 'none';
          card.style.zIndex = String(z);
          // A diferencia del carrusel de testimonios, las laterales SÍ reciben clicks —
          // es el mecanismo pedido para "ir cambiándolas haciendo click", no solo flechas.
          card.style.pointerEvents = abs > 1 ? 'none' : 'auto';
          card.style.cursor = abs === 0 ? 'default' : 'pointer';
          card.setAttribute('aria-hidden', abs === 0 ? 'false' : 'true');
        });

        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === active));

        stageEl.style.height = `${cards[active].scrollHeight}px`;
      }

      function goTo(index: number) {
        active = ((index % n) + n) % n;
        render();
      }

      function next() {
        goTo(active + 1);
      }
      function prev() {
        goTo(active - 1);
      }

      function startTimer() {
        stopTimer();
        if (reduced || n <= 1) return;
        timer = setInterval(next, 3000);
      }
      function stopTimer() {
        if (timer) clearInterval(timer);
        timer = undefined;
      }

      nextBtn?.addEventListener('click', () => {
        next();
        startTimer();
      });
      prevBtn?.addEventListener('click', () => {
        prev();
        startTimer();
      });

      cards.forEach((card, i) => {
        card.addEventListener('click', () => {
          if (i === active) return;
          goTo(i);
          startTimer();
        });
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            goTo(i);
            startTimer();
          }
        });
      });

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          goTo(i);
          startTimer();
        });
      });

      root.addEventListener('mouseenter', stopTimer);
      root.addEventListener('mouseleave', startTimer);

      window.addEventListener('resize', render);

      render();
      startTimer();
    });
  }

  document.addEventListener('astro:page-load', initPiecesCoverflows);
</script>

<style>
  .pc-wrap {
    text-align: center;
  }

  .modules-heading {
    max-width: var(--content-max);
    margin-inline: auto;
    text-align: center;
    margin-bottom: var(--space-lg);
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent-secondary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-xs);
    justify-content: center;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .heading-title {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }
  .title-highlight {
    color: var(--dot-micelio);
  }

  .pc {
    position: relative;
    max-width: 42rem;
    margin-inline: auto;
    padding-inline: var(--space-xl);
  }

  .pc-stage {
    position: relative;
    transition: height var(--transition-smooth);
  }

  .pc-card {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(90vw, 30rem);
    box-sizing: border-box;
    text-align: left;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--dot-micelio) 45%, transparent);
    box-shadow: 0 0 24px color-mix(in srgb, var(--dot-micelio) 20%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    transform-origin: center top;
    transition: transform var(--transition-smooth), opacity var(--transition-smooth), filter var(--transition-smooth), border-color 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
    will-change: transform, opacity, filter;
  }
  .pc-card:focus-visible {
    outline: 2px solid var(--dot-micelio);
    outline-offset: 3px;
  }

  .pc-icon {
    display: flex;
    color: var(--dot-micelio);
  }
  .pc-icon svg {
    width: 2rem;
    height: 2rem;
  }

  .pc-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-xl);
    line-height: 1.3;
    color: var(--dot-light);
  }
  .pc-desc {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .pc-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: var(--space-md);
  }
  .pc-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: color-mix(in srgb, var(--dot-light) 20%, transparent);
    cursor: pointer;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }
  .pc-dot:hover {
    background: color-mix(in srgb, var(--dot-micelio) 60%, transparent);
  }
  .pc-dot.is-active {
    background: var(--dot-micelio);
    transform: scale(1.3);
  }

  .pc-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--dot-moss);
    background: transparent;
    color: var(--dot-micelio);
    cursor: pointer;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }
  .pc-arrow:hover {
    background-color: color-mix(in srgb, var(--dot-micelio) 12%, transparent);
    border-color: var(--dot-micelio);
  }
  .pc-arrow svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .pc-arrow--prev {
    left: 0;
  }
  .pc-arrow--next {
    right: 0;
  }
</style>
