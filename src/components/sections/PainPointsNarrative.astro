    font-weight: 600;
    font-size: clamp(1.96rem, 5.04vw, 3.36rem);
    line-height: 1.35;
  }

  /* El texto "normal" del manifiesto vive en este span — color y opacidad los controla GSAP
     por fase (verde para phrase1/phrase3, negro para phrase2), arranca invisible como el resto
     de las piezas de la secuencia (recién se revela al llegar su turno en el timeline). */
  .pain-narrative__typewriter [data-pain-type-main] {
    color: var(--dot-moss);
    opacity: 0;
  }

  /* Frase resaltada dentro de `phrase2` ("Y tú al medio:") — mismo verde que `phrase1` (el
     texto anterior), tipeada inline junto al resto y luego escalada hasta desaparecer (ver
     Fase 1 en el script). */
  .pain-narrative__typewriter-highlight {
    display: inline-block;
    color: var(--dot-moss);
    transform-origin: center center;
  }

  .pain-narrative__typewriter::after {
    content: '|';
    color: var(--dot-dark);
    animation: pain-cursor-blink 0.9s step-end infinite;
  }

  @keyframes pain-cursor-blink {
    50% {
      opacity: 0;
    }
  }

  .pain-narrative__svg {
    width: min(42vw, 500px);
    height: auto;
    /* Fallback aproximado antes de que corra el JS — el valor real (medido con getBBox sobre
       el path de la "O") se aplica en el propio tween de zoom del cierre, más preciso que
       este estimado a mano. */
    transform-origin: 60.8% 63.4%;
  }

  .pain-narrative__svg circle,
  .pain-narrative__svg path {
    fill: var(--dot-dark);
    fill-rule: evenodd;
