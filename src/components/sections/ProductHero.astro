---
import { withBase } from '../../utils/paths';
import StatBar from './StatBar.astro';

interface Stat {
  value: number;
  prefix?: string;
  suffix?: string;
  label: string;
}

interface Props {
  line1: string;
  line2: string;
  /** Opcional — sin line3, el título queda en 2 líneas (line1 + line2, con
      el glow de cierre en line2 en vez de line3). */
  line3?: string;
  /** Línea opcional adicional — cuando se pasa, el título se reparte en 4
      líneas en vez de 3 y el glow de cierre se mueve a esta última. */
  line4?: string;
  /** Reemplaza el texto de la última línea (line4 o line3) por un logo,
      dentro del mismo mask-reveal de línea — line4/line3 se sigue pasando
      como texto para el alt de la imagen. */
  titleLogo?: string;
  subtitle: string;
  paragraph: string;
  cta: string;
  ctaHref: string;
  /** Logo mostrado centrado sobre el título — activa el layout de una sola
      columna, todo centrado (logo, título, copy y CTAs). */
  logo?: string;
  /** Factor de escala del logo centrado (1 = tamaño por defecto) — para
      emparejar el peso visual entre logos con proporciones muy distintas. */
  logoScale?: number;
  /** Logo pequeño sobre el título, dentro de la columna de copy — distinto
      de `logo`, pensado para el modo con backgroundImage. */
  topLogo?: string;
  /** Stats mostrados en el panel de la derecha, en vez del logo — activa el
      layout de 2 columnas (mutuamente excluyente con `logo`). */
  stats?: Stat[];
  /** Foto de fondo a cobertura completa en vez del grid-texture genérico —
      colapsa la grilla a una sola columna (sin panel visual aparte). */
  backgroundImage?: string;
  ctaSecondary?: string;
  ctaSecondaryHref?: string;
}

const {
  line1,
  line2,
  line3,
  line4,
  titleLogo,
  subtitle,
  paragraph,
  cta,
  ctaHref,
  logo,
  logoScale = 1,
  topLogo,
  stats,
  backgroundImage,
  ctaSecondary,
  ctaSecondaryHref,
} = Astro.props;
const isExternalSecondary = ctaSecondaryHref?.startsWith('http');
---

<section class:list={['product-hero', { 'has-background': !!backgroundImage }]}>
  {backgroundImage ? (
    <>
      <img class="hero-bg" src={withBase(backgroundImage)} alt="" />
      <div class="hero-bg-overlay" aria-hidden="true"></div>
    </>
  ) : (
    <div class="grid-texture" aria-hidden="true"></div>
  )}

  <div
    class:list={[
      'container product-hero-grid',
      { 'no-visual': !logo && !stats, 'has-stats': !logo && !!stats, 'has-logo': !!logo },
    ]}
  >
    <div class="product-hero-copy">
      {topLogo && <img class="top-logo" src={withBase(topLogo)} alt="" />}
      {logo && <img class="hero-logo" style={`--hero-logo-scale: ${logoScale}`} src={withBase(logo)} alt="" />}
      <h1>
        <span class="line-mask"><span class="line-inner">{line1}</span></span>
        {line3 ? (
          <>
            <span class="line-mask"><span class="line-inner">{line2}</span></span>
            {line4 ? (
              <>
                <span class="line-mask"><span class="line-inner">{line3}</span></span>
                <span class="line-mask">
                  <span class="line-inner">
                    {titleLogo ? (
                      <img class="title-logo" src={withBase(titleLogo)} alt={line4} />
                    ) : (
                      <span class="sap-glow">{line4}</span>
                    )}
                  </span>
                </span>
              </>
            ) : (
              <span class="line-mask"><span class="line-inner"><span class="sap-glow">{line3}</span></span></span>
            )}
          </>
        ) : (
          <span class="line-mask"><span class="line-inner"><span class="sap-glow">{line2}</span></span></span>
        )}
      </h1>
      <p class="subtitle">{subtitle}</p>
      <p class="paragraph">{paragraph}</p>
      <div class="product-hero-actions">
        <a href={ctaHref} class="cta">{cta}</a>
        {ctaSecondary && ctaSecondaryHref && (
          <a
            href={ctaSecondaryHref}
            class="cta-secondary"
            target={isExternalSecondary ? '_blank' : undefined}
            rel={isExternalSecondary ? 'noopener noreferrer' : undefined}
          >
            {ctaSecondary}
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </div>

    {!logo && stats && (
      <div class="product-hero-stats">
        <StatBar stats={stats} />
      </div>
    )}
  </div>
</section>

<style>
  .product-hero {
    position: relative;
    width: 100%;
    background: var(--dot-dark);
    padding-block: calc(var(--space-lg) + var(--space-sm)) var(--space-lg);
    overflow: hidden;
  }
  /* Con foto de fondo, el texto se ancla abajo en vez de arriba — deja
     que la imagen respire arriba y el copy se lee sobre la zona ya
     oscurecida del overlay (ver .hero-bg-overlay). */
  .product-hero.has-background {
    display: flex;
    align-items: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    padding-bottom: var(--space-xl);
  }

  .grid-texture {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 15%, #000 70%, transparent);
    mask-image: linear-gradient(180deg, transparent, #000 15%, #000 70%, transparent);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--dot-dark) 45%, transparent) 0%,
      color-mix(in srgb, var(--dot-dark) 70%, transparent) 65%,
      var(--dot-dark) 100%
    );
  }

  .product-hero-grid {
    position: relative;
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
    align-items: center;
  }

  .top-logo {
    display: block;
    height: 2.25rem;
    width: auto;
    margin-bottom: var(--space-sm);
  }

  /* Variante centrada (todos los sub-productos, excepto SAP): logo, título,
     copy y CTAs apilados en una sola columna, todo alineado al centro. */
  .product-hero-grid.has-logo {
    grid-template-columns: 1fr;
    justify-items: center;
    text-align: center;
  }
  .product-hero-grid.has-logo .product-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 48rem;
  }
  @media (min-width: 1025px) {
    .product-hero-grid.has-logo .product-hero-copy {
      max-width: 62rem;
    }
  }
  .hero-logo {
    display: block;
    height: calc(clamp(2.75rem, 6vw, 4rem) * var(--hero-logo-scale, 1));
    width: auto;
    margin-bottom: var(--space-md);
  }

  /* Logo que reemplaza el texto de la última línea del título — mismo alto
     de línea que el texto de las otras, para no romper el ritmo vertical. */
  .title-logo {
    display: inline-block;
    height: clamp(2.25rem, 5.8vw, 3.5rem);
    width: auto;
    vertical-align: middle;
  }

  .product-hero-copy h1 {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    max-width: 18ch;
  }
  /* Sin panel visual (ej. SAP con backgroundImage): el logo ya vive en el
     fondo, así que la columna de copy usa todo el ancho disponible — sin
     esto, títulos largos (2+ palabras por línea) se cortan en más líneas
     de las 3 que definen line1/line2/line3. */
  .product-hero-grid.no-visual .product-hero-copy h1 {
    max-width: 34ch;
  }
  .product-hero-grid.has-stats .product-hero-copy h1 {
    max-width: 40ch;
  }
  .product-hero-grid.has-logo .product-hero-copy h1 {
    max-width: 26ch;
  }
  @media (min-width: 1025px) {
    .product-hero-grid.has-logo .product-hero-copy h1 {
      max-width: 34ch;
    }
  }

  /* Hard-Edge Mask Reveal — mismo mecanismo que el Hero de Home: corte
     sólido y limpio (sin opacity), easing de encaje largo y controlado. */
  .line-mask {
    display: block;
    overflow: hidden;
  }
  .line-inner {
    display: inline-block;
    transform: translateY(100%);
    animation: product-line-reveal 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes product-line-reveal {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0%);
    }
  }
  .line-mask:nth-child(1) .line-inner {
    --line-delay: 0.1s;
    animation-delay: var(--line-delay);
  }
  .line-mask:nth-child(2) .line-inner {
    --line-delay: 0.28s;
    animation-delay: var(--line-delay);
  }
  .line-mask:nth-child(3) .line-inner {
    --line-delay: 0.46s;
    animation-delay: var(--line-delay);
  }
  .line-mask:nth-child(4) .line-inner {
    --line-delay: 0.64s;
    animation-delay: var(--line-delay);
  }

  /* La última línea (3ra o 4ta, según line4) se enciende a Luz Micelio justo
     cuando termina de asentarse — hereda --line-delay de su .line-inner
     padre, así el timing se ajusta solo sin importar en qué línea caiga. */
  .sap-glow {
    display: inline-block;
    color: var(--text-primary);
    text-shadow: none;
    animation: product-sap-power-on 0.8s ease-in-out calc(var(--line-delay) + 0.9s) forwards;
  }
  @keyframes product-sap-power-on {
    from {
      color: var(--text-primary);
      text-shadow: none;
    }
    to {
      color: var(--dot-micelio);
      text-shadow: 0 0 16px rgba(93, 219, 136, 0.15);
    }
  }

  .subtitle {
    margin-top: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.5;
    color: var(--dot-sage);
    max-width: 42ch;
  }
  .product-hero-grid.has-logo .subtitle {
    max-width: none;
    width: 100%;
    margin-inline: auto;
  }

  .paragraph {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 48ch;
  }
  .product-hero-grid.has-logo .paragraph {
    max-width: none;
    width: 100%;
    margin-inline: auto;
  }

  .product-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }
  .product-hero-grid.has-logo .product-hero-actions {
    justify-content: center;
  }

  .cta {
    display: inline-flex;
    background: var(--accent);
    color: var(--on-accent);
    text-decoration: none;
    font-weight: 500;
    padding: 1rem 2.25rem;
    border-radius: var(--radius-full);
    transition: background var(--transition-fast), transform var(--transition-fast);
  }
  .cta:hover {
    background: var(--accent-hover);
    transform: scale(1.03);
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 500;
    padding: 1rem 2.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }
  .cta-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .cta-secondary .arrow {
    transition: transform var(--transition-fast);
  }
  .cta-secondary:hover .arrow {
    transform: translateX(3px);
  }

  .product-hero-stats {
    display: flex;
    align-items: center;
    padding: var(--space-md) 0;
  }
  .product-hero-stats :global(.stat-bar) {
    grid-template-columns: 1fr !important;
    gap: var(--space-md) !important;
  }
  .product-hero-stats :global(.stat) {
    text-align: left !important;
  }
  .product-hero-stats :global(.value) {
    font-size: clamp(1.5rem, 2.6vw, 2rem) !important;
  }

  @media (min-width: 900px) {
    .product-hero-grid:not(.no-visual):not(.has-logo) {
      grid-template-columns: 3fr 2fr;
    }
    .product-hero-grid.has-stats {
      grid-template-columns: 7fr 3fr;
    }
  }
</style>
