---
// src/components/sections/PresenceNetwork.astro
// "Presencia en toda Latinoamérica" — diagrama hub & spoke: Santiago/Chile como núcleo,
// conectado por raíces SVG curvas (mismo lenguaje orgánico que EcosystemRadialMap/mycelium)
// a cada uno de los otros países, con puntos viajando en loop (SMIL, sin JS). Las posiciones
// se calculan UNA vez en el frontmatter (ángulos parejos alrededor del círculo) — a
// diferencia de EcosystemRadialMap, acá no hace falta medir el contenedor en el cliente
// porque todo se expresa en porcentajes de un cuadrado que siempre mantiene su
// aspect-ratio:1, así que el % es válido para cualquier tamaño de pantalla.
// Solo desktop (900px+): en mobile se muestra un listado simple en su lugar (ver Nosotros.astro).
interface Country {
  name: string;
  flag: string;
}

interface Props {
  core: Country;
  coreLabel: string;
  nodes: Country[];
}

const { core, coreLabel, nodes } = Astro.props;

const CENTER = 200;
const NODE_R = 150;
const SAT_ANGLE_START = -90; // arriba, en sentido horario

const points = nodes.map((node, i) => {
  const angle = ((SAT_ANGLE_START + i * (360 / nodes.length)) * Math.PI) / 180;
  const x = CENTER + NODE_R * Math.cos(angle);
  const y = CENTER + NODE_R * Math.sin(angle);
  // Punto de control desplazado perpendicular al segmento núcleo->nodo — la curva "raíz"
  // orgánica en vez de una línea recta, alternando de lado para que no sean simétricas.
  const midX = (CENTER + x) / 2;
  const midY = (CENTER + y) / 2;
  const perp = angle + Math.PI / 2;
  const jitter = (i % 2 === 0 ? 1 : -1) * 22;
  const ctrlX = midX + jitter * Math.cos(perp);
  const ctrlY = midY + jitter * Math.sin(perp);
  return {
    ...node,
    index: i,
    leftPct: (x / 400) * 100,
    topPct: (y / 400) * 100,
    path: `M ${CENTER} ${CENTER} Q ${ctrlX.toFixed(1)} ${ctrlY.toFixed(1)} ${x.toFixed(1)} ${y.toFixed(1)}`,
    duration: (3.6 + (i % 4) * 0.8).toFixed(1),
    delay: (i * 0.5).toFixed(2),
  };
});
---

<div class="presence-network" data-reveal>
  <svg class="presence-network-svg" viewBox="0 0 400 400" preserveAspectRatio="none" aria-hidden="true">
    {points.map((p) => (
      <path id={`presence-path-${p.index}`} class="presence-line" d={p.path} fill="none" />
    ))}
    {points.map((p) => (
      <circle class="presence-orb" r="4" fill="var(--dot-micelio)">
        <animateMotion dur={`${p.duration}s`} begin={`${p.delay}s`} repeatCount="indefinite" rotate="auto">
          <mpath href={`#presence-path-${p.index}`} />
        </animateMotion>
      </circle>
    ))}
  </svg>

  <div class="presence-core" style={`left:${CENTER / 4}%; top:${CENTER / 4}%;`} aria-hidden="true">
    <span class="presence-core-flag">{core.flag}</span>
    <p class="presence-core-name">{core.name}</p>
    <p class="presence-core-label">{coreLabel}</p>
  </div>

  {points.map((p) => (
    <div class="presence-node" style={`left:${p.leftPct}%; top:${p.topPct}%;`}>
      <span class="presence-node-flag" aria-hidden="true">{p.flag}</span>
      <p class="presence-node-name">{p.name}</p>
    </div>
  ))}
</div>

<style>
  .presence-network {
    position: relative;
    width: 100%;
    max-width: 34rem;
    aspect-ratio: 1;
    margin-inline: auto;
  }

  .presence-network-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }
  .presence-line {
    stroke: var(--dot-micelio);
    stroke-width: 1.4;
    stroke-opacity: 0.4;
  }
  .presence-orb {
    filter: drop-shadow(0 0 4px var(--dot-micelio));
  }

  .presence-core {
    position: absolute;
    z-index: 2;
    transform: translate(-50%, -50%);
    width: 8.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: color-mix(in srgb, #6fa8f0 20%, var(--dot-dark) 80%);
    backdrop-filter: blur(16px);
    border: 2px solid #6fa8f0;
    box-shadow: 0 0 36px color-mix(in srgb, #6fa8f0 35%, transparent);
    padding: 0.5rem;
  }
  .presence-core-flag {
    font-size: 1.75rem;
    line-height: 1;
  }
  .presence-core-name {
    margin-top: 0.35rem;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--text-primary);
  }
  .presence-core-label {
    margin-top: 0.15rem;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6fa8f0;
  }

  .presence-node {
    position: absolute;
    z-index: 1;
    transform: translate(-50%, -50%);
    width: 5.25rem;
    aspect-ratio: 1;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: color-mix(in srgb, var(--dot-light) 6%, transparent);
    backdrop-filter: blur(16px);
    border: 1px solid color-mix(in srgb, var(--dot-light) 14%, transparent);
    transition: border-color 0.3s var(--ease-out), transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }
  .presence-node:hover {
    border-color: var(--dot-micelio);
    box-shadow: 0 0 24px color-mix(in srgb, var(--dot-micelio) 30%, transparent);
    transform: translate(-50%, -50%) scale(1.08);
  }
  .presence-node-flag {
    font-size: 1.25rem;
    line-height: 1;
  }
  .presence-node-name {
    margin-top: 0.2rem;
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--text-primary);
  }
</style>
