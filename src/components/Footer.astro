---
// src/components/Footer.astro
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/utils';
import { withBase } from '../utils/paths';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = 2026;

const companyLinks = [
  { href: getRelativeLocaleUrl(lang, ''), label: t.nav.home },
  { href: getRelativeLocaleUrl(lang, 'nosotros'), label: t.nav.about },
  { href: getRelativeLocaleUrl(lang, 'servicios'), label: t.nav.services },
  { href: getRelativeLocaleUrl(lang, 'contacto'), label: t.nav.contact },
];

const servicesLinks = t.nav.solutionsMenu.items.map((item) => ({
  href: getRelativeLocaleUrl(lang, item.href),
  label: item.title,
}));
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={getRelativeLocaleUrl(lang, '')} class="logo">
        <img src={withBase('/logoweb.png')} alt="DOT Solutions" class="logo-image" />
      </a>
      <p class="blurb">{t.footer.about}</p>
      <p class="motto">{t.footer.motto}</p>

      <div class="social-links">
        <a href="https://www.linkedin.com/company/dot-solutions-io/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="3" fill="none" stroke="currentColor" stroke-width="1.4" />
            <path d="M7 10.5v6.5M7 7.2v.01M11.2 17v-4.3a2.3 2.3 0 0 1 4.6 0V17M11.2 10.5V17" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href="https://www.instagram.com/dotsolutions.io/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5" fill="none" stroke="currentColor" stroke-width="1.4" />
            <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.4" />
            <circle cx="17.3" cy="6.7" r="1" fill="currentColor" />
          </svg>
        </a>
      </div>

      <a
        href="https://partnerfinder.sap.com/profile/0001726178"
        target="_blank"
        rel="noopener noreferrer"
        class="partner-badge"
      >
        <img src={withBase('/logos/logos dot/sapgold.png')} alt="SAP Gold Partner" class="partner-badge-logo" />
        <span class="partner-badge-text">
          <span class="partner-badge-title">
            {t.footer.partnerBadgeTitle}
          </span>
          <span class="partner-badge-verify">
            {t.footer.partnerBadgeVerify}
            <span class="external" aria-hidden="true">↗</span>
          </span>
        </span>
      </a>

      <a
        href={getRelativeLocaleUrl(lang, 'terminal-pos-axis-j64')}
        class="partner-badge hardware-badge"
      >
        <img src={withBase('/logos/isotipos/axisj64iso.svg')} alt="Terminal POS AXIS-J64" class="partner-badge-logo hardware-badge-logo" />
        <span class="partner-badge-text">
          <span class="partner-badge-title">
            {t.footer.hardwareBadgeTitle}
          </span>
          <span class="partner-badge-verify">
            {t.footer.hardwareBadgeSubtitle}
            <span class="arrow" aria-hidden="true">→</span>
          </span>
        </span>
      </a>
    </div>

    <div class="footer-col">
      <h3>{t.footer.company}</h3>
      <ul>
        {companyLinks.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-col">
      <h3>{t.nav.services}</h3>
      <ul>
        {servicesLinks.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-col">
      <h3>{t.footer.contact}</h3>
      <ul>
        <li><a href={`mailto:${t.footer.email}`}>{t.footer.email}</a></li>
        <li class="address">{t.footer.address}</li>
      </ul>
      <ul class="countries" aria-label="Presencia LATAM">
        {t.nav.countries.map((c) => <li title={c.name}>{c.flag}</li>)}
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} DOT Solutions. {t.footer.rights}</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--dot-dark);
    color: var(--text-primary);
    padding-block: var(--space-lg) var(--space-md);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  /* Mismo negro abisal que el resto del sitio, diferenciado del fondo por
     un hairline superior y un glow radial sutil (mezcla con --dot-gray a
     baja opacidad) en vez de un color distinto — look premium sin salir
     de la paleta ni usar sombras (el sistema DOT no usa shadows). */
  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 70% 55% at 50% 0%,
      color-mix(in srgb, var(--dot-gray) 40%, transparent) 0%,
      transparent 70%
    );
    pointer-events: none;
  }
  .footer-grid,
  .footer-bottom {
    position: relative;
  }

  .footer-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: 1fr;
  }

  .footer-brand .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    margin-bottom: var(--space-sm);
  }
  .logo-image {
    height: 1.75rem;
    width: auto;
  }

  .blurb {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
    max-width: 32rem;
    margin-bottom: var(--space-xs);
  }
  .motto {
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
    margin-top: var(--space-sm);
  }
  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--dot-light) 15%, transparent);
    color: var(--text-secondary);
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }
  .social-links a:hover {
    border-color: var(--dot-micelio);
    color: var(--dot-micelio);
  }
  .social-links svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* Badge de verificación SAP Gold Partner — glow micelio permanente, mismo
     lenguaje de "card resplandeciente" que el resto del sitio. */
  .partner-badge {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: var(--space-md);
    padding: 0.75rem 1rem;
    max-width: fit-content;
    background: color-mix(in srgb, var(--dot-light) 4%, transparent);
    border: 1px solid color-mix(in srgb, var(--dot-micelio) 40%, transparent);
    border-radius: var(--radius-md);
    box-shadow: 0 0 20px color-mix(in srgb, var(--dot-micelio) 15%, transparent);
    text-decoration: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .partner-badge:hover {
    border-color: var(--dot-micelio);
    box-shadow: 0 0 28px color-mix(in srgb, var(--dot-micelio) 30%, transparent);
  }
  .partner-badge-logo {
    height: 2rem;
    width: auto;
    flex-shrink: 0;
  }
  .partner-badge-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .partner-badge-title {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
  }
  .partner-badge-verify {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-xs);
    color: var(--dot-micelio);
  }

  .footer-col h3 {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: var(--space-xs);
  }
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer-col a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }
  .footer-col a:hover {
    color: var(--accent);
  }
  .address {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .countries {
    flex-direction: row !important;
    flex-wrap: wrap;
    gap: 0.4rem !important;
    margin-top: var(--space-xs);
    font-size: var(--text-lg);
  }
  .countries li {
    opacity: 0.85;
  }

  .footer-bottom {
    margin-top: var(--space-lg);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: var(--text-xs);
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
    }
  }
</style>
