---
// src/components/Header.astro
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/utils';
import { withBase } from '../utils/paths';

interface Props {
  lang: Lang;
  /** Path relative to the locale root, e.g. "/" or "/nosotros" */
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
const rel = path.replace(/^\//, '');

const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const homeHref = getRelativeLocaleUrl(lang, '');
const sapHref = getRelativeLocaleUrl(lang, 'sap-business-one');
const servicesHref = getRelativeLocaleUrl(lang, 'servicios');
const blogHref = getRelativeLocaleUrl(lang, 'blog');
const aboutHref = getRelativeLocaleUrl(lang, 'nosotros');
const contactHref = getRelativeLocaleUrl(lang, 'contacto');
const switchHref = getRelativeLocaleUrl(otherLang, rel);

const PRESENCE_FLAGS = ['🇨🇱', '🇵🇪', '🇨🇴', '🇲🇽', '🇵🇦'];

// Los items del mega-menú de soluciones normalmente son rutas internas, pero
// algunos (ej. Smart Order) redirigen a un sitio externo del producto — ahí
// item.href ya viene como URL absoluta y no debe pasar por getRelativeLocaleUrl.
const isExternal = (href: string) => /^https?:\/\//.test(href);
const resolveHref = (href: string) => (isExternal(href) ? href : getRelativeLocaleUrl(lang, href));

// SAP Business One se destaca aparte, junto al título del ecosistema — no
// va en la cuadrícula de productos (los otros 8 sí, incluyendo Mobile One).
const sapItem = t.nav.solutionsMenu.items.find((item) => item.title === 'SAP Business One');
const gridItems = t.nav.solutionsMenu.items.filter((item) => item.title !== 'SAP Business One');
---

<header class="navbar" id="navbar">
  <div class="container navbar-inner">
    <nav class="nav-left" aria-label="Principal">
      <a href={sapHref} class="sap-link" aria-label={t.nav.sap}>
        <img src={withBase('/logos/sap.png')} alt={t.nav.sap} class="sap-logo" />
      </a>

      <div class="mega" id="mega-services">
        <button
          type="button"
          class="mega-trigger"
          id="mega-trigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="mega-panel"
        >
          {t.nav.services}
          <svg class="mega-chevron" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>

      <a href={aboutHref}>{t.nav.about}</a>
      <a href={blogHref}>{t.nav.blog}</a>
    </nav>

    <a href={homeHref} class="logo" aria-label="DOT Solutions">
      <img src={withBase('/logoweb.png')} alt="DOT Solutions" class="logo-image" />
    </a>

    <div class="nav-right">
      <div class="presence" id="presence">
        <button
          type="button"
          class="pill presence-trigger"
          id="presence-trigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="presence-popover"
        >
          <span class="globe" aria-hidden="true">🌐</span>
          <span class="presence-label">{t.nav.presenceShort}</span>
          <span class="flags" aria-hidden="true">{PRESENCE_FLAGS.join(' ')}</span>
        </button>

        <div class="presence-popover" id="presence-popover" role="menu">
          <p class="popover-title">{t.nav.presenceTitle}</p>
          <ul>
            {t.nav.countries.map((c) => (
              <li role="menuitem">
                <span aria-hidden="true">{c.flag}</span> {c.name}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <a href={switchHref} class="pill lang-pill">{otherLang.toUpperCase()}</a>
      <a href={contactHref} class="pill cta-pill">{t.nav.cta}</a>

      <button class="menu-toggle" aria-label="Menú" aria-expanded="false" id="menu-toggle">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Mega menú full-width, estilo enterprise (tipo HubSpot): hermano de
       .navbar-inner y no hijo de .mega, para que ocupe el 100% del ancho de
       la pantalla justo debajo de la barra — no un dropdown flotante
       centrado en el trigger. -->
  <div class="mega-panel" id="mega-panel" role="menu">
    <div class="container mega-panel-inner">
      <div class="mega-top">
        <div class="mega-top-copy">
          <h3 class="mega-top-title">{t.nav.solutionsMenu.ecosystemTitle}</h3>
          <p class="mega-top-tagline">{t.nav.solutionsMenu.ecosystemTagline}</p>
        </div>

        {sapItem && (
          <a href={resolveHref(sapItem.href)} class="mega-top-sap" role="menuitem">
            <span class="mega-logo">
              <img src={withBase(sapItem.logo)} alt={sapItem.title} loading="lazy" />
            </span>
            <span class="mega-top-sap-copy">
              <span class="mega-title">{sapItem.title}</span>
              <span class="mega-desc">{sapItem.desc}</span>
            </span>
            <span class="mega-more">{t.nav.solutionsMenu.moreLabel} →</span>
          </a>
        )}
      </div>

      <hr class="mega-divider" />

      <div class="mega-grid">
        {gridItems.map((item) => (
          <a
            href={resolveHref(item.href)}
            class="mega-card"
            role="menuitem"
            target={isExternal(item.href) ? '_blank' : undefined}
            rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
          >
            <span class="mega-logo">
              <img src={withBase(item.logo)} alt={item.title} loading="lazy" />
            </span>
            <span class="mega-title">{item.title}</span>
            <span class="mega-desc">{item.desc}</span>
            <span class="mega-more">{t.nav.solutionsMenu.moreLabel} →</span>
          </a>
        ))}
      </div>

      <hr class="mega-divider" />

      <div class="mega-bottom">
        <a href={contactHref} class="mega-bottom-link">{t.nav.cta}</a>
        <a href={servicesHref} class="mega-bottom-link">{t.nav.solutionsMenu.viewAll}</a>
      </div>
    </div>
  </div>

  <nav class="nav-mobile" id="nav-mobile" aria-label="Móvil">
    <a href={sapHref} class="sap-link-mobile">
      <img src={withBase('/logos/sap.png')} alt={t.nav.sap} class="sap-logo-mobile" />
    </a>
    <a href={servicesHref}>{t.nav.services}</a>
    <a href={aboutHref}>{t.nav.about}</a>

    <ul class="mobile-solutions">
      {t.nav.solutionsMenu.items.map((item) => (
        <li>
          <a
            href={resolveHref(item.href)}
            target={isExternal(item.href) ? '_blank' : undefined}
            rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
          >
            <img src={withBase(item.logo)} alt="" loading="lazy" />
            {item.title}
          </a>
        </li>
      ))}
    </ul>

    <a href={blogHref}>{t.nav.blog}</a>
    <a href={contactHref}>{t.nav.contact}</a>

    <p class="mobile-presence-title">{t.nav.presenceTitle}</p>
    <ul class="mobile-countries">
      {t.nav.countries.map((c) => (
        <li>{c.flag} {c.name}</li>
      ))}
    </ul>

    <a href={switchHref} class="lang-switch-mobile">{otherLang === 'es' ? 'Español' : 'English'}</a>
  </nav>
</header>

<script>
  // Estado de scroll del header: cruzar 20px activa el glass effect.
  // Se limpia en cada astro:before-swap para no acumular listeners con
  // View Transitions (mismo patrón que el motor Lenis en Layout.astro).
  let scrollHandler: (() => void) | undefined;

  function initScrollState() {
    const header = document.getElementById('navbar');
    if (!header) return;

    function update() {
      header!.classList.toggle('is-scrolled', window.scrollY > 20);
    }
    update();
    scrollHandler = update;
    window.addEventListener('scroll', scrollHandler, { passive: true });
  }

  let outsideClickHandler: ((e: MouseEvent) => void) | undefined;
  let keydownHandler: ((e: KeyboardEvent) => void) | undefined;

  function initPresence() {
    const wrapper = document.getElementById('presence');
    const trigger = document.getElementById('presence-trigger');
    if (!wrapper || !trigger) return;

    function close() {
      wrapper!.classList.remove('is-open');
      trigger!.setAttribute('aria-expanded', 'false');
    }
    function toggle() {
      const open = wrapper!.classList.toggle('is-open');
      trigger!.setAttribute('aria-expanded', String(open));
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      toggle();
    });

    outsideClickHandler = (e) => {
      if (!wrapper!.contains(e.target as Node)) close();
    };
    keydownHandler = (e) => {
      if (e.key === 'Escape') close();
    };
    document.addEventListener('click', outsideClickHandler);
    document.addEventListener('keydown', keydownHandler);
  }

  let megaOutsideClick: ((e: MouseEvent) => void) | undefined;
  let megaKeydown: ((e: KeyboardEvent) => void) | undefined;

  function initMegaMenu() {
    const wrapper = document.getElementById('mega-services');
    const trigger = document.getElementById('mega-trigger');
    // El panel es full-width y ya no vive dentro de .mega (así puede ocupar
    // el 100% del ancho de la pantalla en vez de flotar bajo el trigger) —
    // por eso el hover/outside-click se maneja sobre wrapper Y panel.
    const panel = document.getElementById('mega-panel');
    if (!wrapper || !trigger || !panel) return;

    let hoverTimeout: ReturnType<typeof setTimeout> | undefined;

    function close() {
      wrapper!.classList.remove('is-open');
      panel!.classList.remove('is-open');
      trigger!.setAttribute('aria-expanded', 'false');
    }
    function open() {
      wrapper!.classList.add('is-open');
      panel!.classList.add('is-open');
      trigger!.setAttribute('aria-expanded', 'true');
    }
    function toggle() {
      wrapper!.classList.contains('is-open') ? close() : open();
    }

    // Hover solo en dispositivos con puntero fino: en touch, click/tap
    // es la única forma de abrir el menú.
    const canHover = window.matchMedia('(hover: hover)').matches;
    if (canHover) {
      const cancelClose = () => clearTimeout(hoverTimeout);
      const scheduleClose = () => {
        hoverTimeout = setTimeout(close, 150);
      };

      wrapper.addEventListener('mouseenter', () => {
        cancelClose();
        open();
      });
      wrapper.addEventListener('mouseleave', scheduleClose);
      panel.addEventListener('mouseenter', cancelClose);
      panel.addEventListener('mouseleave', scheduleClose);
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      toggle();
    });

    megaOutsideClick = (e) => {
      const target = e.target as Node;
      if (!wrapper!.contains(target) && !panel!.contains(target)) close();
    };
    megaKeydown = (e) => {
      if (e.key === 'Escape') close();
    };
    document.addEventListener('click', megaOutsideClick);
    document.addEventListener('keydown', megaKeydown);
  }

  function initMenuToggle() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('nav-mobile');
    toggle?.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      menu?.classList.toggle('is-open');
    });
  }

  document.addEventListener('astro:before-swap', () => {
    if (scrollHandler) window.removeEventListener('scroll', scrollHandler);
    if (outsideClickHandler) document.removeEventListener('click', outsideClickHandler);
    if (keydownHandler) document.removeEventListener('keydown', keydownHandler);
    if (megaOutsideClick) document.removeEventListener('click', megaOutsideClick);
    if (megaKeydown) document.removeEventListener('keydown', megaKeydown);
  });

  document.addEventListener('astro:page-load', () => {
    initScrollState();
    initPresence();
    initMegaMenu();
    initMenuToggle();
  });
</script>

<style>
  .navbar {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: var(--z-modal);
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background 0.35s var(--ease-out), backdrop-filter 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out), padding 0.3s var(--ease-out);
    padding-block: 1.5rem;
  }
  .navbar.is-scrolled {
    background: color-mix(in srgb, var(--dot-dark) 55%, transparent);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    padding-block: 0.85rem;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  @media (min-width: 900px) {
    .navbar-inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }
    .logo {
      justify-self: center;
    }
    .nav-right {
      justify-self: end;
    }
  }

  .nav-left {
    display: none;
    gap: var(--space-md);
  }
  .nav-left a {
    color: var(--dot-light);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 400;
    transition: color var(--transition-fast);
  }
  .nav-left a:hover {
    color: var(--accent);
  }

  .sap-link {
    display: flex;
    align-items: center;
  }
  .sap-logo {
    height: 1.4rem;
    width: auto;
    border-radius: 2px;
    transition: opacity var(--transition-fast);
  }
  .sap-link:hover .sap-logo {
    opacity: 0.85;
  }

  /* Mega menu de Servicios */
  .mega {
    position: relative;
  }
  .mega-trigger {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: none;
    padding: 0;
    color: var(--dot-light);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    cursor: pointer;
    transition: color var(--transition-fast);
  }
  .mega-trigger:hover {
    color: var(--accent);
  }
  .mega-chevron {
    transition: transform 0.25s var(--ease-out);
  }
  .mega.is-open .mega-chevron {
    transform: rotate(180deg);
  }

  /* Mega menú full-width estilo enterprise (HubSpot): un panel que ocupa el
     100% del ancho de pantalla, hermano de .navbar-inner (no un dropdown
     flotante centrado en el trigger) — así se despliega justo debajo de
     toda la barra, no solo bajo el botón "Servicios". Lujo Silencioso:
     Bruma Digital sólida, textos oscuros, sombra de caída suave (no la
     sombra rígida "brutalista" de la iteración anterior). */
  .mega-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    background-color: var(--dot-light);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.1);
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: opacity 0.28s var(--ease-out), transform 0.28s var(--ease-out);
  }
  .mega-panel.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mega-panel-inner {
    padding-block: var(--space-lg);
  }

  /* Sección superior: el copy del ecosistema a la izquierda y SAP Business
     One destacado a la derecha, ocupando todo el margen disponible del
     título/tagline — no va en la cuadrícula junto a los demás productos. */
  .mega-top {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }
  .mega-top-copy {
    flex-shrink: 0;
  }
  .mega-top-sap {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex: 1;
    margin-left: auto;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(0, 0, 0, 0.08);
    text-decoration: none;
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }
  .mega-top-sap:hover {
    border-color: var(--dot-micelio);
    background: color-mix(in srgb, var(--dot-micelio) 6%, transparent);
  }
  .mega-top-sap-copy {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .mega-top-sap .mega-desc {
    -webkit-line-clamp: 1;
  }
  .mega-top-sap .mega-more {
    margin-top: 0;
    flex-shrink: 0;
  }
  .mega-top-title {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-xl);
    color: var(--dot-dark);
    margin-bottom: 0.35rem;
  }
  .mega-top-tagline {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--text-base);
    color: var(--dot-gray);
    max-width: 42ch;
  }

  .mega-divider {
    border: none;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    margin-block: var(--space-md);
  }

  /* Cuadrícula de 4 columnas para los 7 productos restantes — sin bordes
     internos esta vez (eso era la iteración "Eco-Brutalismo" anterior);
     separación por espacio generoso, más cercana a un mega menú enterprise
     clásico. */
  .mega-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg) var(--space-md);
  }

  .mega-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-decoration: none;
  }

  /* Logos de partners en escala de grises por defecto — recuperan color y
     opacidad completa solo al hacer hover sobre su propia tarjeta. */
  /* Contenedor a tamaño fijo (el más grande de todos los logos) para las 8
     tarjetas por igual — así el título/descripción siempre arrancan a la
     misma altura, sin importar que cada <img> tenga su propio tamaño
     ajustado abajo. Los tamaños por producto viven en el <img>, no acá. */
  .mega-logo {
    width: 4.2rem;
    height: 4.2rem;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: var(--space-sm);
  }
  .mega-logo img {
    height: 3rem;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
  }
  /* Smart Order y BiPyxis se ven visiblemente más chicos que el resto a la
     misma altura fija — 30% más grandes para emparejar el peso visual. */
  .mega-logo img[src*='smart-order'],
  .mega-logo img[src*='bipyxis'] {
    height: 3.9rem;
  }
  .mega-logo img[src*='sap'] {
    height: 3.6rem;
  }
  .mega-logo img[src*='loyalty'],
  .mega-logo img[src*='tcpos'],
  .mega-logo img[src*='retailpro'] {
    height: 4.2rem;
  }

  .mega-title {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--dot-dark);
    margin-bottom: 0.3rem;
  }
  .mega-desc {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 300;
    line-height: 1.4;
    color: var(--dot-gray);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .mega-more {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--dot-dark);
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color var(--transition-fast), color var(--transition-fast);
  }
  .mega-card:hover .mega-more {
    text-decoration-color: var(--dot-micelio);
    color: var(--dot-moss);
  }

  .mega-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }
  .mega-bottom-link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--dot-dark);
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color var(--transition-fast), color var(--transition-fast);
  }
  .mega-bottom-link:hover {
    text-decoration-color: var(--dot-micelio);
    color: var(--dot-moss);
  }

  @media (max-width: 1150px) {
    .mega-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    white-space: nowrap;
  }
  .logo-image {
    height: 1.6rem;
    width: auto;
    transition: height 0.3s var(--ease-out);
  }
  .navbar.is-scrolled .logo-image {
    height: 1.35rem;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 0.5rem 0.9rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--transition-fast), border-color var(--transition-fast),
      color var(--transition-fast), transform var(--transition-fast);
  }

  /* Presencia LATAM */
  .presence {
    position: relative;
    display: none;
  }
  .presence-trigger {
    background: color-mix(in srgb, var(--dot-dark) 60%, transparent);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--dot-light);
    cursor: pointer;
  }
  .presence-trigger:hover {
    border-color: var(--accent);
  }
  .flags {
    font-size: 0.7rem;
    letter-spacing: -0.05em;
  }

  .presence-popover {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    min-width: 220px;
    background: color-mix(in srgb, var(--dot-dark) 92%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    padding: 1rem;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: opacity 0.22s var(--ease-out), transform 0.22s var(--ease-out);
  }
  .presence.is-open .presence-popover {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .popover-title {
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-secondary);
    margin-bottom: 0.5rem;
  }
  .presence-popover ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .presence-popover li {
    font-size: var(--text-sm);
    color: var(--dot-light);
    padding: 0.4rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .presence-popover li:first-child {
